// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "Guida",
    "npc.guide.greeting": "Benvenuto, nuovo arrivato. Il cerchio ti ha portato qui, come gli altri.",
    "npc.guide.where": "Questa è la porta sud di Aurelia. I campi si stendono oltre, e più in là il bosco, le colline e la palude.",
    "npc.guide.system": "Il Sistema parla a chi è stato evocato. Ascolta quando ti mostra qualcosa.",
    "npc.guide.option.where": "Dove sono?",
    "npc.guide.option.system": "Che cos'è il Sistema?",
    "npc.guide.option.back": "Ho un'altra domanda.",
    "npc.guide.option.bye": "Addio.",
    "npc.guide.option.work": "C'è qualcosa che posso fare?",
    "npc.guide.offer": "Visita l'erborista nel quartiere del mercato, a ovest della piazza, e portami tre erbe luminose. Una prova che sai trovare la strada.",
    "npc.guide.option.accept": "Lo farò.",
    "npc.guide.accepted": "Bene. L'erborista saprà perché sei venuto.",
    "npc.guide.option.done": "Ho portato le erbe.",
    "npc.guide.thanks": "Ben fatto. Prendi questo pane e qualche moneta per il viaggio.",
    "npc.herbalist.name": "Erborista",
    "npc.herbalist.greeting": "Attento alle piantine. Cosa ti porta nel mio giardino?",
    "npc.herbalist.option.sent": "La guida mi ha mandato per le erbe luminose.",
    "npc.herbalist.gift": "Un altro nuovo arrivato. Eccole, appena colte. Dillo alla guida che la saluto.",
    "npc.herbalist.option.bye": "Grazie. Arrivederci.",
    "npc.merchant.name": "Mercante",
    "npc.smith.name": "Fabbro",
    "npc.smith.greeting": "Metallo, riparazioni o un mestiere da imparare. Cosa ti serve?",
    "npc.smith.option.smelting": "Insegnami a fondere il minerale. (100 di rame)",
    "npc.smith.option.sword": "Insegnami a forgiare una spada. (1100 di rame)",
    "npc.smith.option.bye": "Un'altra volta.",
    "npc.smith.taught": "Guarda il colore del metallo, non l'orologio. Ora è tuo.",
    "npc.smith.option.metals": "Sui metalli e i lingotti.",
    "npc.smith.option.learn_copper_ingot": "Insegnami il lingotto di rame. (50 di rame)",
    "npc.smith.option.learn_silver_ingot": "Insegnami il lingotto d'argento. (1000 di rame)",
    "npc.smith.option.melee": "Sulle armi da mischia.",
    "npc.smith.option.learn_iron_axe": "Insegnami l'ascia di ferro. (1400 di rame)",
    "npc.smith.option.learn_iron_spear": "Insegnami la lancia di ferro. (1300 di rame)",
    "npc.smith.option.learn_stone_hammer": "Insegnami il martello di pietra. (850 di rame)",
    "npc.smith.option.learn_iron_hammer": "Insegnami il martello di ferro. (1550 di rame)",
    "npc.smith.option.ranged": "Su archi e bastoni.",
    "npc.smith.option.learn_wooden_bow": "Insegnami l'arco di legno. (700 di rame)",
    "npc.smith.option.learn_iron_bow": "Insegnami l'arco di ferro. (1350 di rame)",
    "npc.smith.option.learn_oak_staff": "Insegnami il bastone di quercia. (800 di rame)",
    "npc.smith.option.learn_iron_staff": "Insegnami il bastone di ferro. (1450 di rame)",
    "npc.smith.option.armor": "Sulle armature.",
    "npc.smith.option.learn_cloth_tunic": "Insegnami la tunica di stoffa. (550 di rame)",
    "npc.smith.option.learn_studded_leather": "Insegnami il cuoio borchiato. (1000 di rame)",
    "npc.smith.option.learn_iron_chainmail": "Insegnami la cotta di maglia di ferro. (1200 di rame)",
    "npc.smith.option.learn_iron_plate_armor": "Insegnami l'armatura a piastre di ferro. (2300 di rame)",
    "npc.smith.lessons": "Quale mestiere vuoi imparare?",
    "npc.smith.option.back": "Altro.",
    "npc.herbalist.option.lessons": "Mi insegni le pozioni?",
    "npc.herbalist.lessons": "Radici e fiori possono curare o rinvigorire un corpo. Quale preparato?",
    "npc.herbalist.taught": "Fai attenzione al fuoco e alle dosi. Ora è tuo.",
    "npc.herbalist.option.back": "Altro.",
    "npc.herbalist.option.learn_minor_health_potion": "Insegnami la pozione di vita minore. (200 di rame)",
    "npc.herbalist.option.learn_vigor_elixir": "Insegnami l'elisir di vigore. (300 di rame)",
    "npc.herbalist.option.learn_mana_tonic": "Insegnami il tonico di mana. (300 di rame)",
    "npc.herbalist.option.learn_minor_heal": "Insegnami a curare con la luce. (300 di rame)",
    "npc.herbalist.option.learn_revival_draught": "Insegnami la pozione di risveglio. (500 di rame)",
    "npc.herbalist.option.learn_health_potion": "Insegnami la pozione di vita. (500 di rame)",
    "npc.herbalist.option.learn_greater_vigor_elixir": "Insegnami l'elisir di vigore maggiore. (800 di rame)",
    "npc.herbalist.option.learn_greater_health_potion": "Insegnami la pozione di vita maggiore. (1000 di rame)",
    "npc.summoner.name": "Evocatore",
    "npc.summoner.greeting": "Sei sveglio. Respira. Il cerchio ti ha portato dal tuo mondo al nostro, come ha portato gli altri.",
    "npc.summoner.what": "Aurelia ha chiesto aiuto e il cerchio ha risposto con te. Nessuno può rimandarti indietro. Ma qui puoi diventare forte.",
    "npc.summoner.system": "Il Sistema è la voce che sentono gli evocati. Conta le tue imprese e ti dà titoli. Uno è già tuo.",
    "npc.summoner.offer": "Impara prima a stare in piedi. Vai dall'istruttore nel cortile, a est, poi dalla guida nel campo a sud della porta. Quando sarai pronto, la Gilda ti registrerà.",
    "npc.summoner.accepted": "Vai. I segnalini sopra le persone che devi vedere ti guideranno.",
    "npc.summoner.next": "L'istruttore nel cortile, a est; la guida nel campo a sud della porta; tre code di ratto; poi la sede della Gilda, a nord-ovest.",
    "npc.summoner.option.what": "Che cosa mi è successo?",
    "npc.summoner.option.system": "Che voce è questa nella mia testa?",
    "npc.summoner.option.begin": "Cosa devo fare ora?",
    "npc.summoner.option.next": "Dove vado dopo?",
    "npc.summoner.option.accept": "Sono pronto.",
    "npc.summoner.option.back": "Ho un'altra domanda.",
    "npc.summoner.option.bye": "Più tardi.",
    "npc.instructor.name": "Istruttore",
    "npc.instructor.greeting": "Un altro del cerchio. Pugni alzati. Nessuno esce dal mio cortile senza saper dare un calcio.",
    "npc.instructor.taught": "Questo è un Calcio. Trascinalo dalla finestra delle tecniche alla barra in basso e premi il suo numero durante un combattimento.",
    "npc.instructor.fight": "Clicca una creatura per attaccarla; continui a colpire da solo. Se qualcosa ti colpisce, rispondi. Guarda la tua vita e ritirati quando scende.",
    "npc.instructor.option.teach": "Insegnami a combattere.",
    "npc.instructor.option.fight": "Come funziona un combattimento?",
    "npc.instructor.option.back": "Altro.",
    "npc.instructor.option.bye": "Grazie.",
    "npc.guild_clerk.name": "Impiegato della Gilda",
    "npc.guild_clerk.greeting": "Gilda degli Avventurieri di Aurelia. Registrazione, lavoro e pagamento, in quest'ordine.",
    "npc.guild_clerk.registered": "Nome scritto, tessera timbrata. Benvenuto nella Gilda, avventuriero. Chiedimi lavoro ogni volta che ti servono monete.",
    "npc.guild_clerk.not_yet": "L'evocatore non ha ancora finito con te. Torna quando avrai fatto quanto richiesto.",
    "npc.guild_clerk.work": "I goblin sono scesi sulle colline di rovi a est del campo, e i tessitori pagano la seta di ragno delle stesse colline.",
    "npc.guild_clerk.taken": "Annotato. Porta la prova e sarai pagato.",
    "npc.guild_clerk.paid": "Contato e pagato. Buon lavoro.",
    "npc.guild_clerk.option.register": "Voglio registrarmi.",
    "npc.guild_clerk.option.not_yet": "Sono venuto a registrarmi.",
    "npc.guild_clerk.option.work": "C'è lavoro?",
    "npc.guild_clerk.option.take_goblins": "Me ne occupo io dei goblin.",
    "npc.guild_clerk.option.take_silk": "Porto la seta di ragno.",
    "npc.guild_clerk.option.ears": "Ho portato le orecchie di goblin.",
    "npc.guild_clerk.option.silk": "Ho portato la seta di ragno.",
    "npc.guild_clerk.option.back": "Altro.",
    "npc.guild_clerk.option.bye": "Arrivederci.",
    "npc.guide.option.sent": "Mi ha mandato l'evocatore.",
    "npc.guide.rats": "I ratti rosicchiano i campi fuori da questa porta. Porta tre code per dimostrare che sai combattere. Il mercante del mercato, a ovest della piazza, compra ciò che saccheggi.",
    // Alpha world NPCs.
    "npc.captain.name": "Capitano",
    "npc.captain.greeting": "Tieni la lama pronta oltre questa porta. I campi non sono così tranquilli come sembrano.",
    "npc.captain.work": "Lupi nei campi, e banditi a Whisperwood, a ovest. Il guardaboschi del rifugio conosce il bosco.",
    "npc.captain.taken": "Bene. Torna a riferire quando hai finito.",
    "npc.captain.paid": "La città ti deve qualcosa. Ecco la tua paga.",
    "npc.captain.option.work": "Hai lavoro per me?",
    "npc.captain.option.pelts": "Ho portato le pelli di lupo.",
    "npc.captain.option.badges": "Ho portato i distintivi dei banditi.",
    "npc.captain.option.take_wolves": "Caccerò i lupi.",
    "npc.captain.option.take_patrol": "Troverò il guardaboschi.",
    "npc.captain.option.take_bandits": "Me ne occupo io dei banditi.",
    "npc.captain.option.back": "Altro.",
    "npc.captain.option.bye": "Addio.",
    "npc.ranger.name": "Guardaboschi",
    "npc.ranger.greeting": "Passi silenziosi, straniero. Il bosco ascolta.",
    "npc.ranger.forest": "I lupi spaventosi hanno la tana a sud di qui, e i banditi si accampano oltre di loro. Fenmoor sta oltre i campi, a sud-est.",
    "npc.ranger.taken": "Portami le loro zanne e ti pagherò.",
    "npc.ranger.paid": "Meno lupi, strade più sicure. Prendi questo.",
    "npc.ranger.option.patrol": "Mi manda il capitano.",
    "npc.ranger.option.forest": "Cosa c'è in questi boschi?",
    "npc.ranger.option.take_fangs": "Caccerò i lupi spaventosi.",
    "npc.ranger.option.fangs": "Ho portato zanne spaventose.",
    "npc.ranger.option.back": "Altro.",
    "npc.ranger.option.bye": "Addio.",
    "npc.foreman.name": "Capo minatori",
    "npc.foreman.greeting": "Stonebrook scava, Stonebrook paga. Cerchi lavoro?",
    "npc.foreman.work": "Le miniere a nord della città brulicano di pipistrelli e kobold, e qualcosa di grosso si è svegliato in fondo.",
    "npc.foreman.taken": "L'imbocco della miniera è sulla strada a nord. Attento alla testa.",
    "npc.foreman.paid": "Lavoro onesto, paga onesta.",
    "npc.foreman.option.sent": "Mi manda la gilda.",
    "npc.foreman.option.work": "Ci sono lavori nelle miniere?",
    "npc.foreman.option.wings": "Ho portato ali di pipistrello.",
    "npc.foreman.option.candles": "Ho portato candele di kobold.",
    "npc.foreman.option.core": "Ho portato il nucleo del golem.",
    "npc.foreman.option.take_wings": "Ripulirò i pipistrelli.",
    "npc.foreman.option.take_candles": "Caccerò i kobold.",
    "npc.foreman.option.take_core": "Affronterò il golem.",
    "npc.foreman.option.back": "Altro.",
    "npc.foreman.option.bye": "Addio.",
    "npc.quartermaster.name": "Quartiermastro",
    "npc.fen_elder.name": "Anziano",
    "npc.fen_elder.greeting": "Attento alle passerelle. La palude trattiene ciò che vi cade.",
    "npc.fen_elder.work": "Il nostro rimedio ha bisogno di zampe di rana e gel di melma, le nostre lanterne di luce di fuoco fatuo, e la strega dell'isola a ovest maledice tutti noi.",
    "npc.fen_elder.taken": "Che le assi reggano sotto di te.",
    "npc.fen_elder.paid": "Fenwick ti ringrazia.",
    "npc.fen_elder.option.letter": "L'erborista di Aurelia manda i suoi saluti.",
    "npc.fen_elder.option.work": "Posso aiutare il villaggio?",
    "npc.fen_elder.option.remedy": "Ho portato ciò che serve al rimedio.",
    "npc.fen_elder.option.charm": "Ho portato l'amuleto della strega.",
    "npc.fen_elder.option.essence": "Ho portato essenza di fuoco fatuo.",
    "npc.fen_elder.option.take_remedy": "Raccoglierò per il rimedio.",
    "npc.fen_elder.option.take_hag": "Affronterò la strega.",
    "npc.fen_elder.option.take_wisps": "Catturerò la luce dei fuochi fatui.",
    "npc.fen_elder.option.back": "Altro.",
    "npc.fen_elder.option.bye": "Addio.",
    "npc.fen_trader.name": "Commerciante",
    "npc.guild_clerk.option.take_stonebrook": "Andrò a Stonebrook.",
    "npc.herbalist.option.letter": "Serve portare qualcosa?",
    "npc.herbalist.letter": "Sì! Porta i miei saluti all'anziano di Fenwick, nella palude a sud dei campi.",
}
