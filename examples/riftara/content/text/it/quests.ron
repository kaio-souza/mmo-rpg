// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "Primi passi",
    "quest.first_steps.desc": "Parla con l'erborista e porta tre erbe luminose alla guida.",
    "quest.arrival.name": "Arrivo",
    "quest.arrival.desc": "Impara dall'istruttore, trova la guida nel campo, porta tre code di ratto e registrati presso la Gilda degli Avventurieri.",
    "quest.goblin_trouble.name": "Guai con i goblin",
    "quest.goblin_trouble.desc": "I goblin sono scesi sulle colline di rovi. Porta cinque orecchie di goblin all'impiegato della gilda.",
    "quest.spider_silk.name": "Seta di ragno",
    "quest.spider_silk.desc": "I tessitori di Aurelia pagano la seta. Porta quattro fili di seta di ragno dalle colline di rovi all'impiegato della gilda.",
    // Alpha world quests.
    "quest.wolf_cull.name": "Lupi alla porta",
    "quest.wolf_cull.desc": "I lupi scorrazzano nei campi a sud di Aurelia. Porta cinque pelli di lupo al capitano della porta sud.",
    "quest.forest_patrol.name": "Pattuglia a Whisperwood",
    "quest.forest_patrol.desc": "Segui la strada a ovest di Aurelia fino a Whisperwood e presentati al guardaboschi del rifugio.",
    "quest.bandit_badges.name": "Distintivi dei banditi",
    "quest.bandit_badges.desc": "I banditi si accampano nel profondo di Whisperwood. Porta sei distintivi di bandito al capitano.",
    "quest.dire_fangs.name": "Zanne spaventose",
    "quest.dire_fangs.desc": "I lupi spaventosi hanno la tana a sud del rifugio. Porta quattro zanne al guardaboschi.",
    "quest.road_to_stonebrook.name": "La strada per Stonebrook",
    "quest.road_to_stonebrook.desc": "Prendi la strada a est attraverso le colline di rovi fino a Stonebrook e parla con il capo minatori.",
    "quest.bat_wings.name": "Ali di pipistrello",
    "quest.bat_wings.desc": "I pipistrelli infestano la prima caverna delle miniere di Ironridge. Porta sei ali di pipistrello al capo minatori.",
    "quest.kobold_candles.name": "Candele dei kobold",
    "quest.kobold_candles.desc": "I kobold scavano nella caverna orientale delle miniere. Porta otto delle loro candele al capo minatori.",
    "quest.heart_of_stone.name": "Cuore di pietra",
    "quest.heart_of_stone.desc": "Un golem di roccia sorveglia il fondo delle miniere. Porta il suo nucleo al capo minatori.",
    "quest.letter_to_fenwick.name": "Messaggio per Fenwick",
    "quest.letter_to_fenwick.desc": "Porta i saluti dell'erborista a sud, attraverso i campi, fino all'anziano di Fenwick nella Palude.",
    "quest.marsh_remedy.name": "Rimedio della palude",
    "quest.marsh_remedy.desc": "L'anziano di Fenwick ha bisogno di cinque zampe di rana e tre gel di melma per il rimedio del villaggio.",
    "quest.hags_curse.name": "La maledizione della strega",
    "quest.hags_curse.desc": "Una strega della palude maledice Fenwick dalla sua isola a ovest. Porta il suo amuleto all'anziano.",
    "quest.wisp_lights.name": "Luci fatue",
    "quest.wisp_lights.desc": "L'anziano di Fenwick compra essenza di fuoco fatuo per le lanterne del villaggio. Portane tre.",
}
