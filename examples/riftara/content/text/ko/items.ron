// Texts of items (content/items/).
{
    "item.glow_herb.name": "빛나는 약초",
    "item.glow_herb.desc": "해질녘에 희미하게 빛나는 약초. 안내인이 이것을 찾고 있습니다.",
    "item.travel_bread.name": "여행용 빵",
    "item.travel_bread.desc": "몇 주 동안 보관할 수 있는 든든한 빵.",
    "item.rusty_sword.name": "녹슨 검",
    "item.rusty_sword.desc": "오래되었지만 아직 벨 수 있습니다. 자세히 살펴볼 가치가 있는 무언가가 있습니다.",
    "item.hunting_knife.name": "사냥용 칼",
    "item.hunting_knife.desc": "안정된 손에서 가볍고 빠릅니다.",
    "item.leather_armor.name": "가죽 갑옷",
    "item.leather_armor.desc": "단단한 가죽으로, 물린 상처를 한두 번 막아 줍니다.",
    "item.wolf_pelt.name": "늑대 가죽",
    "item.wolf_pelt.desc": "두툼한 회색 털가죽. 무두장이들이 돈을 주고 삽니다.",
    "item.boar_tusk.name": "멧돼지 엄니",
    "item.boar_tusk.desc": "굽고 날카롭습니다. 장인들에게 쓸모가 있습니다.",
    "item.iron_ore.name": "철광석",
    "item.iron_ore.desc": "원석. 두 개를 녹이면 주괴 하나가 됩니다.",
    "item.iron_ingot.name": "철 주괴",
    "item.iron_ingot.desc": "깨끗한 금속, 모루에 올릴 준비가 되었습니다.",
    "item.iron_sword.name": "철검",
    "item.iron_sword.desc": "단조되었고 균형이 좋으며 수리할 가치가 있습니다.",
    "item.rat_tail.name": "쥐 꼬리",
    "item.rat_tail.desc": "길고 털이 없으며 거의 가치가 없습니다.",
    "item.spider_silk.name": "거미줄",
    "item.spider_silk.desc": "질기고 끈적한 회색 실뭉치.",
    "item.goblin_ear.name": "고블린 귀",
    "item.goblin_ear.desc": "뾰족하고 초록색입니다. 길드가 증거로 돈을 줍니다.",
    "item.guild_card.name": "길드 카드",
    "item.guild_card.desc": "아우렐리아 모험가 길드가 도장을 찍은 당신의 이름.",
    // Alpha world drops.
    "item.bandit_badge.name": "산적 휘장",
    "item.bandit_badge.desc": "위스퍼우드 산적들의 투박한 구리 휘장. 대장이 증거로 돈을 줍니다.",
    "item.dire_fang.name": "공포 늑대의 송곳니",
    "item.dire_fang.desc": "길고 누런 송곳니. 레인저가 모으고 있습니다.",
    "item.bat_wing.name": "박쥐 날개",
    "item.bat_wing.desc": "광산 동굴에서 얻은 가죽 같은 날개.",
    "item.kobold_candle.name": "코볼드의 양초",
    "item.kobold_candle.desc": "코볼드들이 투구에 달고 다니는 기름진 양초 토막.",
    "item.golem_core.name": "골렘의 핵",
    "item.golem_core.desc": "아직 빛나는, 따뜻한 돌 심장.",
    "item.frog_leg.name": "개구리 다리",
    "item.frog_leg.desc": "늪 개구리의 통통한 다리. 펜윅의 요리사들이 극찬합니다.",
    "item.slime_gel.name": "점액 젤",
    "item.slime_gel.desc": "초록빛에 차갑고 끈적합니다. 늪의 치유사들이 씁니다.",
    "item.hag_charm.name": "마녀의 부적",
    "item.hag_charm.desc": "머리카락으로 감싼 뼈 부적. 나쁜 의지로 웅웅 울립니다.",
    "item.wisp_essence.name": "도깨비불 정수",
    "item.wisp_essence.desc": "늪의 도깨비불에서 뽑아낸 창백한 빛이 든 병.",
    "item.torch.name": "횃불",
    "item.torch.desc": "송진을 먹인 천을 막대에 감은 것. 들고 있는 동안 어둠을 밝히고, 그동안 타들어 간다.",
}
