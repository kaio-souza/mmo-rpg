// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "첫걸음",
    "quest.first_steps.desc": "약초사와 이야기한 뒤, 빛나는 약초 세 개를 안내인에게 가져가세요.",
    "quest.arrival.name": "도착",
    "quest.arrival.desc": "교관에게 배우고, 들판에서 안내인을 찾고, 쥐 꼬리 세 개를 가져가 모험가 길드에 등록하세요.",
    "quest.goblin_trouble.name": "고블린 소동",
    "quest.goblin_trouble.desc": "고블린들이 가시덤불 언덕으로 내려왔습니다. 고블린 귀 다섯 개를 길드 서기에게 가져가세요.",
    "quest.spider_silk.name": "거미줄",
    "quest.spider_silk.desc": "아우렐리아의 직공들은 실을 삽니다. 가시덤불 언덕의 거미줄 네 가닥을 길드 서기에게 가져가세요.",
    // Alpha world quests.
    "quest.wolf_cull.name": "문 앞의 늑대",
    "quest.wolf_cull.desc": "아우렐리아 남쪽 들판을 늑대들이 돌아다닙니다. 늑대 가죽 다섯 장을 남문의 대장에게 가져가세요.",
    "quest.forest_patrol.name": "위스퍼우드 순찰",
    "quest.forest_patrol.desc": "아우렐리아에서 서쪽 길을 따라 위스퍼우드로 가서, 오두막의 레인저에게 보고하세요.",
    "quest.bandit_badges.name": "산적 휘장",
    "quest.bandit_badges.desc": "산적들이 위스퍼우드 깊은 곳에 진을 쳤습니다. 산적 휘장 여섯 개를 대장에게 가져가세요.",
    "quest.dire_fangs.name": "공포 늑대의 송곳니",
    "quest.dire_fangs.desc": "공포 늑대들이 오두막 남쪽에 굴을 팠습니다. 공포 늑대의 송곳니 네 개를 레인저에게 가져가세요.",
    "quest.road_to_stonebrook.name": "스톤브룩으로 가는 길",
    "quest.road_to_stonebrook.desc": "동쪽 가시덤불 언덕을 지나 스톤브룩으로 가서 광산 감독과 이야기하세요.",
    "quest.bat_wings.name": "박쥐 날개",
    "quest.bat_wings.desc": "박쥐들이 아이언리지 광산의 첫 동굴을 더럽히고 있습니다. 박쥐 날개 여섯 장을 감독에게 가져가세요.",
    "quest.kobold_candles.name": "코볼드의 양초",
    "quest.kobold_candles.desc": "코볼드들이 광산 동쪽 동굴을 파고 있습니다. 그들의 양초 여덟 개를 감독에게 가져가세요.",
    "quest.heart_of_stone.name": "돌의 심장",
    "quest.heart_of_stone.desc": "바위 골렘이 광산 깊은 곳을 지키고 있습니다. 그 핵을 감독에게 가져가세요.",
    "quest.letter_to_fenwick.name": "펜윅에 전할 말",
    "quest.letter_to_fenwick.desc": "약초사의 인사를 들판을 지나 남쪽 늪지 펜무어의 펜윅 장로에게 전하세요.",
    "quest.marsh_remedy.name": "늪지 약재",
    "quest.marsh_remedy.desc": "펜윅 장로는 마을의 약을 위해 개구리 다리 다섯 개와 점액 젤 세 개가 필요합니다.",
    "quest.hags_curse.name": "마녀의 저주",
    "quest.hags_curse.desc": "늪의 마녀가 서쪽 섬에서 펜윅에 저주를 걸었습니다. 그녀의 부적을 장로에게 가져가세요.",
    "quest.wisp_lights.name": "도깨비불",
    "quest.wisp_lights.desc": "펜윅 장로는 마을 등불에 쓸 도깨비불 정수를 삽니다. 세 개를 가져가세요.",
}
