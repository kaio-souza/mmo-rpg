// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "안내인",
    "npc.guide.greeting": "환영합니다, 새내기. 다른 이들과 마찬가지로 원이 당신을 여기로 데려왔습니다.",
    "npc.guide.where": "여기는 아우렐리아의 남문입니다. 그 너머에 들판이 펼쳐지고, 더 멀리에는 숲과 언덕과 늪이 있습니다.",
    "npc.guide.system": "시스템은 소환된 자에게 말을 겁니다. 무언가를 보여 줄 때는 귀를 기울이세요.",
    "npc.guide.option.where": "여기가 어디죠?",
    "npc.guide.option.system": "시스템이 뭐죠?",
    "npc.guide.option.back": "다른 질문이 있어요.",
    "npc.guide.option.bye": "안녕히 계세요.",
    "npc.guide.option.work": "제가 할 수 있는 일이 있나요?",
    "npc.guide.offer": "광장 서쪽 시장 구역의 약초사를 찾아가서, 빛나는 약초 세 개를 가져오세요. 길을 찾을 수 있다는 증명이 될 겁니다.",
    "npc.guide.option.accept": "해 보겠습니다.",
    "npc.guide.accepted": "좋아요. 약초사가 당신이 왜 왔는지 알 겁니다.",
    "npc.guide.option.done": "약초를 가져왔어요.",
    "npc.guide.thanks": "잘했어요. 이 빵과 여행 경비를 가져가세요.",
    "npc.herbalist.name": "약초사",
    "npc.herbalist.greeting": "묘목을 밟지 않게 조심하세요. 제 정원에는 무슨 일이죠?",
    "npc.herbalist.option.sent": "안내인이 빛나는 약초를 구해 오라고 했어요.",
    "npc.herbalist.gift": "또 한 명의 새내기군요. 여기, 방금 딴 것입니다. 안내인에게 안부 전해 주세요.",
    "npc.herbalist.option.bye": "감사합니다. 안녕히 계세요.",
    "npc.merchant.name": "상인",
    "npc.smith.name": "대장장이",
    "npc.smith.greeting": "금속, 수리, 아니면 배우고 싶은 기술. 어느 쪽인가요?",
    "npc.smith.option.smelting": "광석 제련을 가르쳐 주세요. (구리 100)",
    "npc.smith.option.sword": "검 단조를 가르쳐 주세요. (구리 1100)",
    "npc.smith.option.bye": "다음에 하죠.",
    "npc.smith.taught": "시계가 아니라 금속의 빛깔을 보게. 이제 이것은 자네 것이네.",
    "npc.smith.option.metals": "금속과 주괴에 대해.",
    "npc.smith.option.learn_copper_ingot": "구리 주괴를 가르쳐 주세요. (구리 50)",
    "npc.smith.option.learn_silver_ingot": "은 주괴를 가르쳐 주세요. (구리 1000)",
    "npc.smith.option.melee": "근접 무기에 대해.",
    "npc.smith.option.learn_iron_axe": "철 도끼를 가르쳐 주세요. (구리 1400)",
    "npc.smith.option.learn_iron_spear": "철 창을 가르쳐 주세요. (구리 1300)",
    "npc.smith.option.learn_stone_hammer": "돌 망치를 가르쳐 주세요. (구리 850)",
    "npc.smith.option.learn_iron_hammer": "철 망치를 가르쳐 주세요. (구리 1550)",
    "npc.smith.option.ranged": "활과 지팡이에 대해.",
    "npc.smith.option.learn_wooden_bow": "나무 활을 가르쳐 주세요. (구리 700)",
    "npc.smith.option.learn_iron_bow": "철 활을 가르쳐 주세요. (구리 1350)",
    "npc.smith.option.learn_oak_staff": "참나무 지팡이를 가르쳐 주세요. (구리 800)",
    "npc.smith.option.learn_iron_staff": "철 지팡이를 가르쳐 주세요. (구리 1450)",
    "npc.smith.option.armor": "갑옷에 대해.",
    "npc.smith.option.learn_cloth_tunic": "천 튜닉을 가르쳐 주세요. (구리 550)",
    "npc.smith.option.learn_studded_leather": "징 박은 가죽을 가르쳐 주세요. (구리 1000)",
    "npc.smith.option.learn_iron_chainmail": "철 사슬 갑옷을 가르쳐 주세요. (구리 1200)",
    "npc.smith.option.learn_iron_plate_armor": "철판 갑옷을 가르쳐 주세요. (구리 2300)",
    "npc.smith.lessons": "어떤 기술을 배우고 싶나요?",
    "npc.smith.option.back": "다른 것이요.",
    "npc.herbalist.option.lessons": "물약을 가르쳐 주실 수 있나요?",
    "npc.herbalist.lessons": "뿌리와 꽃은 몸을 치유하거나 강하게 할 수 있습니다. 어떤 물약인가요?",
    "npc.herbalist.taught": "불의 세기와 분량을 주의하게. 이제 이것은 자네 것이네.",
    "npc.herbalist.option.back": "다른 것이요.",
    "npc.herbalist.option.learn_minor_health_potion": "작은 체력 물약을 가르쳐 주세요. (구리 200)",
    "npc.herbalist.option.learn_vigor_elixir": "활력 영약을 가르쳐 주세요. (구리 300)",
    "npc.herbalist.option.learn_mana_tonic": "마나 강장제를 가르쳐 주세요. (구리 300)",
    "npc.herbalist.option.learn_minor_heal": "빛으로 치유하는 법을 가르쳐 주세요. (구리 300)",
    "npc.herbalist.option.learn_revival_draught": "회생의 물약을 가르쳐 주세요. (구리 500)",
    "npc.herbalist.option.learn_health_potion": "체력 물약을 가르쳐 주세요. (구리 500)",
    "npc.herbalist.option.learn_greater_vigor_elixir": "상급 활력 영약을 가르쳐 주세요. (구리 800)",
    "npc.herbalist.option.learn_greater_health_potion": "상급 체력 물약을 가르쳐 주세요. (구리 1000)",
    "npc.summoner.name": "소환사",
    "npc.summoner.greeting": "깨어났군요. 숨을 고르세요. 원이 다른 이들처럼 당신을 당신의 세계에서 우리 세계로 데려왔습니다.",
    "npc.summoner.what": "아우렐리아가 도움을 청했고, 원은 당신으로 응답했습니다. 누구도 당신을 돌려보낼 수 없습니다. 하지만 여기서는 강해질 수 있습니다.",
    "npc.summoner.system": "시스템은 소환된 자들이 듣는 목소리입니다. 당신의 행적을 세고 칭호를 줍니다. 이미 하나가 당신의 것입니다.",
    "npc.summoner.offer": "먼저 두 발로 서는 법을 배우세요. 동쪽 마당의 교관을 만나고, 그다음 문 남쪽 들판의 안내인을 만나세요. 준비가 되면 길드가 당신을 등록해 줄 겁니다.",
    "npc.summoner.accepted": "가세요. 만나야 할 사람 위에 떠 있는 표식이 길을 안내할 겁니다.",
    "npc.summoner.next": "동쪽 마당의 교관, 문 남쪽 들판의 안내인, 쥐 꼬리 세 개, 그다음 북서쪽의 길드 회관입니다.",
    "npc.summoner.option.what": "저한테 무슨 일이 일어난 거죠?",
    "npc.summoner.option.system": "머릿속의 이 목소리는 뭐죠?",
    "npc.summoner.option.begin": "이제 무엇을 해야 하죠?",
    "npc.summoner.option.next": "다음엔 어디로 가죠?",
    "npc.summoner.option.accept": "준비됐어요.",
    "npc.summoner.option.back": "다른 질문이 있어요.",
    "npc.summoner.option.bye": "나중에요.",
    "npc.instructor.name": "교관",
    "npc.instructor.greeting": "원에서 또 한 명 왔군. 주먹을 들어. 발차기를 할 줄 모르면 내 마당에서 못 나간다.",
    "npc.instructor.taught": "그게 발차기다. 기술 창에서 아래 막대로 끌어다 놓고, 싸움 중에 그 번호를 눌러라.",
    "npc.instructor.fight": "생명체를 클릭하면 공격한다. 그 뒤에도 너는 스스로 계속 때린다. 무언가 너를 때리면 되받아쳐라. 체력을 살피고, 떨어지면 물러서라.",
    "npc.instructor.option.teach": "싸우는 법을 가르쳐 주세요.",
    "npc.instructor.option.fight": "전투는 어떻게 돌아가죠?",
    "npc.instructor.option.back": "다른 것이요.",
    "npc.instructor.option.bye": "감사합니다.",
    "npc.guild_clerk.name": "길드 서기",
    "npc.guild_clerk.greeting": "아우렐리아 모험가 길드입니다. 등록, 일, 지급 순서로 진행합니다.",
    "npc.guild_clerk.registered": "이름을 적고 카드에 도장을 찍었습니다. 환영합니다, 모험가. 돈이 필요할 때마다 일을 물어보세요.",
    "npc.guild_clerk.not_yet": "소환사가 아직 당신과 볼일을 마치지 않았습니다. 요청받은 일을 마친 뒤에 다시 오세요.",
    "npc.guild_clerk.work": "고블린들이 들판 동쪽 가시덤불 언덕으로 내려왔고, 직공들은 같은 언덕의 거미줄에 돈을 냅니다.",
    "npc.guild_clerk.taken": "기록했습니다. 증거를 가져오면 지급하겠습니다.",
    "npc.guild_clerk.paid": "셈을 마쳤고 지급했습니다. 수고했어요.",
    "npc.guild_clerk.option.register": "등록하고 싶어요.",
    "npc.guild_clerk.option.not_yet": "등록하러 왔어요.",
    "npc.guild_clerk.option.work": "일이 있나요?",
    "npc.guild_clerk.option.take_goblins": "고블린은 제가 처리하겠습니다.",
    "npc.guild_clerk.option.take_silk": "거미줄을 가져오겠습니다.",
    "npc.guild_clerk.option.ears": "고블린 귀를 가져왔어요.",
    "npc.guild_clerk.option.silk": "거미줄을 가져왔어요.",
    "npc.guild_clerk.option.back": "다른 것이요.",
    "npc.guild_clerk.option.bye": "안녕히 계세요.",
    "npc.guide.option.sent": "소환사가 보냈어요.",
    "npc.guide.rats": "이 문 밖 들판에서 쥐들이 농작물을 갉아먹고 있습니다. 싸울 줄 안다는 증거로 쥐 꼬리 세 개를 가져오세요. 광장 서쪽 시장의 상인이 당신이 얻은 전리품을 사 줄 겁니다.",
    // Alpha world NPCs.
    "npc.captain.name": "대장",
    "npc.captain.greeting": "이 문 너머에서는 칼을 늘 준비해 두게. 들판은 보이는 것만큼 조용하지 않아.",
    "npc.captain.work": "들판에는 늑대가, 서쪽 위스퍼우드에는 산적이 있다. 오두막의 레인저가 숲을 잘 알아.",
    "npc.captain.taken": "좋아. 끝나면 다시 와서 보고하게.",
    "npc.captain.paid": "도시가 자네에게 빚을 졌네. 여기 보수가 있다.",
    "npc.captain.option.work": "나한테 맡길 일이 있나요?",
    "npc.captain.option.pelts": "늑대 가죽을 가져왔어요.",
    "npc.captain.option.badges": "산적 휘장을 가져왔어요.",
    "npc.captain.option.take_wolves": "늑대를 사냥하겠습니다.",
    "npc.captain.option.take_patrol": "레인저를 찾겠습니다.",
    "npc.captain.option.take_bandits": "산적은 제가 처리하겠습니다.",
    "npc.captain.option.back": "다른 것이요.",
    "npc.captain.option.bye": "안녕히 계세요.",
    "npc.ranger.name": "레인저",
    "npc.ranger.greeting": "조용히 걷게, 이방인. 숲이 듣고 있다.",
    "npc.ranger.forest": "여기서 남쪽에 공포 늑대의 굴이 있고, 그 너머에는 산적이 진을 쳤다. 펜무어는 들판 너머 남동쪽에 있다.",
    "npc.ranger.taken": "그 송곳니를 가져오면 보수를 주겠다.",
    "npc.ranger.paid": "늑대가 줄면 길이 안전해진다. 받게.",
    "npc.ranger.option.patrol": "대장이 보냈어요.",
    "npc.ranger.option.forest": "이 숲에는 무엇이 있나요?",
    "npc.ranger.option.take_fangs": "공포 늑대를 사냥하겠습니다.",
    "npc.ranger.option.fangs": "공포 늑대의 송곳니를 가져왔어요.",
    "npc.ranger.option.back": "다른 것이요.",
    "npc.ranger.option.bye": "안녕히 계세요.",
    "npc.foreman.name": "광산 감독",
    "npc.foreman.greeting": "스톤브룩은 파고, 스톤브룩은 지불한다. 일을 찾나?",
    "npc.foreman.work": "마을 북쪽 광산은 박쥐와 코볼드로 가득하고, 깊은 곳에서 무언가 큰 것이 깨어났다.",
    "npc.foreman.taken": "갱구는 북쪽 길 끝에 있다. 머리 조심하게.",
    "npc.foreman.paid": "정직한 일에는 정직한 보수지.",
    "npc.foreman.option.sent": "길드가 보냈어요.",
    "npc.foreman.option.work": "광산에 일이 있나요?",
    "npc.foreman.option.wings": "박쥐 날개를 가져왔어요.",
    "npc.foreman.option.candles": "코볼드의 양초를 가져왔어요.",
    "npc.foreman.option.core": "골렘의 핵을 가져왔어요.",
    "npc.foreman.option.take_wings": "박쥐를 치우겠습니다.",
    "npc.foreman.option.take_candles": "코볼드를 몰아내겠습니다.",
    "npc.foreman.option.take_core": "골렘과 맞서겠습니다.",
    "npc.foreman.option.back": "다른 것이요.",
    "npc.foreman.option.bye": "안녕히 계세요.",
    "npc.quartermaster.name": "군수 담당",
    "npc.fen_elder.name": "장로",
    "npc.fen_elder.greeting": "널빤지 길을 조심하게. 늪은 떨어진 것을 모두 삼킨다네.",
    "npc.fen_elder.work": "우리 약에는 개구리 다리와 점액 젤이 필요하고, 우리 등불에는 도깨비불 빛이 필요하네. 그리고 서쪽 섬의 마녀가 우리 모두를 저주하고 있지.",
    "npc.fen_elder.taken": "널빤지가 자네를 받쳐 주기를.",
    "npc.fen_elder.paid": "펜윅이 자네에게 감사하네.",
    "npc.fen_elder.option.letter": "아우렐리아의 약초사가 안부를 전합니다.",
    "npc.fen_elder.option.work": "마을을 도울 수 있을까요?",
    "npc.fen_elder.option.remedy": "약에 필요한 것을 가져왔어요.",
    "npc.fen_elder.option.charm": "마녀의 부적을 가져왔어요.",
    "npc.fen_elder.option.essence": "도깨비불 정수를 가져왔어요.",
    "npc.fen_elder.option.take_remedy": "약에 쓸 재료를 모으겠습니다.",
    "npc.fen_elder.option.take_hag": "마녀와 맞서겠습니다.",
    "npc.fen_elder.option.take_wisps": "도깨비불의 빛을 잡겠습니다.",
    "npc.fen_elder.option.back": "다른 것이요.",
    "npc.fen_elder.option.bye": "안녕히 계세요.",
    "npc.fen_trader.name": "행상인",
    "npc.guild_clerk.option.take_stonebrook": "스톤브룩으로 가겠습니다.",
    "npc.herbalist.option.letter": "전해 줄 것이 있나요?",
    "npc.herbalist.letter": "네! 들판 남쪽 늪지에 있는 펜윅 장로에게 제 안부를 전해 주세요.",
}
