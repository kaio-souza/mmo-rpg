// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "Проводник",
    "npc.guide.greeting": "Добро пожаловать, новичок. Круг привёл тебя сюда, как и других.",
    "npc.guide.where": "Это южные ворота Ауреллии. За ними лежат поля, а дальше лес, холмы и болото.",
    "npc.guide.system": "Система говорит с призванными. Слушай, когда она что-то показывает.",
    "npc.guide.option.where": "Где я?",
    "npc.guide.option.system": "Что такое Система?",
    "npc.guide.option.back": "У меня другой вопрос.",
    "npc.guide.option.bye": "Прощай.",
    "npc.guide.option.work": "Могу ли я что-нибудь сделать?",
    "npc.guide.offer": "Навести травницу в торговом квартале, к западу от площади, и принеси мне три светящиеся травы. Это докажет, что ты найдёшь дорогу.",
    "npc.guide.option.accept": "Я сделаю.",
    "npc.guide.accepted": "Хорошо. Травница узнает, зачем ты пришёл.",
    "npc.guide.option.done": "Я принёс травы.",
    "npc.guide.thanks": "Молодец. Возьми этот хлеб и немного монет в дорогу.",
    "npc.herbalist.name": "Травница",
    "npc.herbalist.greeting": "Осторожно с рассадой. Что привело тебя в мой сад?",
    "npc.herbalist.option.sent": "Проводник послал меня за светящимися травами.",
    "npc.herbalist.gift": "Ещё один новичок. Вот, только что срезано. Передай проводнику от меня привет.",
    "npc.herbalist.option.bye": "Спасибо. До свидания.",
    "npc.merchant.name": "Торговец",
    "npc.smith.name": "Кузнец",
    "npc.smith.greeting": "Металл, ремонт или ремесло, которому стоит научиться. Что именно?",
    "npc.smith.option.smelting": "Научи меня плавить руду. (100 медных)",
    "npc.smith.option.sword": "Научи меня ковать меч. (1100 медных)",
    "npc.smith.option.bye": "В другой раз.",
    "npc.smith.taught": "Смотри на цвет металла, а не на часы. Теперь это твоё.",
    "npc.smith.option.metals": "О металлах и слитках.",
    "npc.smith.option.learn_copper_ingot": "Научи меня медному слитку. (50 медных)",
    "npc.smith.option.learn_silver_ingot": "Научи меня серебряному слитку. (1000 медных)",
    "npc.smith.option.melee": "О оружии ближнего боя.",
    "npc.smith.option.learn_iron_axe": "Научи меня железному топору. (1400 медных)",
    "npc.smith.option.learn_iron_spear": "Научи меня железному копью. (1300 медных)",
    "npc.smith.option.learn_stone_hammer": "Научи меня каменному молоту. (850 медных)",
    "npc.smith.option.learn_iron_hammer": "Научи меня железному молоту. (1550 медных)",
    "npc.smith.option.ranged": "О луках и посохах.",
    "npc.smith.option.learn_wooden_bow": "Научи меня деревянному луку. (700 медных)",
    "npc.smith.option.learn_iron_bow": "Научи меня железному луку. (1350 медных)",
    "npc.smith.option.learn_oak_staff": "Научи меня дубовому посоху. (800 медных)",
    "npc.smith.option.learn_iron_staff": "Научи меня железному посоху. (1450 медных)",
    "npc.smith.option.armor": "О доспехах.",
    "npc.smith.option.learn_cloth_tunic": "Научи меня тканевой тунике. (550 медных)",
    "npc.smith.option.learn_studded_leather": "Научи меня клёпаной коже. (1000 медных)",
    "npc.smith.option.learn_iron_chainmail": "Научи меня железной кольчуге. (1200 медных)",
    "npc.smith.option.learn_iron_plate_armor": "Научи меня латам из железа. (2300 медных)",
    "npc.smith.lessons": "Какое ремесло ты хочешь освоить?",
    "npc.smith.option.back": "Что-нибудь другое.",
    "npc.herbalist.option.lessons": "Не научишь ли меня зельям?",
    "npc.herbalist.lessons": "Корни и цветы могут исцелить или укрепить тело. Какое зелье?",
    "npc.herbalist.taught": "Следи за жаром и мерой. Теперь это твоё.",
    "npc.herbalist.option.back": "Что-нибудь другое.",
    "npc.herbalist.option.learn_minor_health_potion": "Научи меня малому зелью здоровья. (200 медных)",
    "npc.herbalist.option.learn_vigor_elixir": "Научи меня эликсиру бодрости. (300 медных)",
    "npc.herbalist.option.learn_mana_tonic": "Научи меня тонику маны. (300 медных)",
    "npc.herbalist.option.learn_minor_heal": "Научи меня лечить светом. (300 медных)",
    "npc.herbalist.option.learn_revival_draught": "Научи меня зелью возрождения. (500 медных)",
    "npc.herbalist.option.learn_health_potion": "Научи меня зелью здоровья. (500 медных)",
    "npc.herbalist.option.learn_greater_vigor_elixir": "Научи меня большому эликсиру бодрости. (800 медных)",
    "npc.herbalist.option.learn_greater_health_potion": "Научи меня большому зелью здоровья. (1000 медных)",
    "npc.summoner.name": "Призыватель",
    "npc.summoner.greeting": "Ты очнулся. Дыши. Круг перенёс тебя из твоего мира в наш, как и других.",
    "npc.summoner.what": "Ауреллия попросила помощи, и круг ответил тобой. Никто не сможет вернуть тебя назад. Но здесь ты можешь окрепнуть.",
    "npc.summoner.system": "Система — это голос, который слышат призванные. Она считает твои деяния и дарует звания. Одно уже твоё.",
    "npc.summoner.offer": "Сначала научись стоять на ногах. Поговори с инструктором во дворе на востоке, потом с проводником в поле к югу от ворот. Когда будешь готов, Гильдия тебя зарегистрирует.",
    "npc.summoner.accepted": "Иди. Метки над людьми, которых ты должен увидеть, покажут дорогу.",
    "npc.summoner.next": "Инструктор во дворе на востоке, проводник в поле к югу от ворот, три хвоста крыс, потом зал Гильдии на северо-западе.",
    "npc.summoner.option.what": "Что со мной случилось?",
    "npc.summoner.option.system": "Что за голос у меня в голове?",
    "npc.summoner.option.begin": "Что мне делать теперь?",
    "npc.summoner.option.next": "Куда идти дальше?",
    "npc.summoner.option.accept": "Я готов.",
    "npc.summoner.option.back": "У меня другой вопрос.",
    "npc.summoner.option.bye": "Потом.",
    "npc.instructor.name": "Инструктор",
    "npc.instructor.greeting": "Ещё один из круга. Кулаки вверх. Никто не выйдет с моего двора, не умея пинаться.",
    "npc.instructor.taught": "Это Удар ногой. Перетащи его из окна техник на панель внизу и нажимай его номер в бою.",
    "npc.instructor.fight": "Кликни по существу, чтобы атаковать его; дальше ты будешь бить сам. Если что-то ударит тебя, бей в ответ. Следи за здоровьем и отступай, когда оно падает.",
    "npc.instructor.option.teach": "Научи меня драться.",
    "npc.instructor.option.fight": "Как проходит бой?",
    "npc.instructor.option.back": "Что-нибудь другое.",
    "npc.instructor.option.bye": "Спасибо.",
    "npc.guild_clerk.name": "Писарь гильдии",
    "npc.guild_clerk.greeting": "Гильдия искателей приключений Ауреллии. Регистрация, работа и оплата, именно в таком порядке.",
    "npc.guild_clerk.registered": "Имя записано, карта заверена. Добро пожаловать в Гильдию, искатель. Проси работу, когда понадобятся монеты.",
    "npc.guild_clerk.not_yet": "Призыватель ещё не закончил с тобой. Вернись, когда выполнишь, что было велено.",
    "npc.guild_clerk.work": "Гоблины спустились на колючие холмы к востоку от поля, а ткачи платят за паутинный шёлк с тех же холмов.",
    "npc.guild_clerk.taken": "Записано. Принеси доказательство, и тебе заплатят.",
    "npc.guild_clerk.paid": "Посчитано и оплачено. Хорошая работа.",
    "npc.guild_clerk.option.register": "Я хочу зарегистрироваться.",
    "npc.guild_clerk.option.not_yet": "Я пришёл зарегистрироваться.",
    "npc.guild_clerk.option.work": "Есть работа?",
    "npc.guild_clerk.option.take_goblins": "Я займусь гоблинами.",
    "npc.guild_clerk.option.take_silk": "Я принесу паутинный шёлк.",
    "npc.guild_clerk.option.ears": "Я принёс гоблиньи уши.",
    "npc.guild_clerk.option.silk": "Я принёс паутинный шёлк.",
    "npc.guild_clerk.option.back": "Что-нибудь другое.",
    "npc.guild_clerk.option.bye": "Прощай.",
    "npc.guide.option.sent": "Меня послал призыватель.",
    "npc.guide.rats": "Крысы грызут поля за этими воротами. Принеси три хвоста, чтобы показать, что умеешь драться. Торговец на рынке, к западу от площади, покупает то, что ты добудешь.",
    // Alpha world NPCs.
    "npc.captain.name": "Капитан",
    "npc.captain.greeting": "Держи клинок наготове за этими воротами. Поля не так спокойны, как кажутся.",
    "npc.captain.work": "Волки на полях и бандиты в Уиспервуде, на западе. Следопыт из хижины знает лес.",
    "npc.captain.taken": "Хорошо. Вернись и доложи, когда закончишь.",
    "npc.captain.paid": "Город у тебя в долгу. Вот твоя плата.",
    "npc.captain.option.work": "Есть работа для меня?",
    "npc.captain.option.pelts": "Я принёс волчьи шкуры.",
    "npc.captain.option.badges": "Я принёс бандитские знаки.",
    "npc.captain.option.take_wolves": "Я пойду на волков.",
    "npc.captain.option.take_patrol": "Я найду следопыта.",
    "npc.captain.option.take_bandits": "Я займусь бандитами.",
    "npc.captain.option.back": "Что-нибудь другое.",
    "npc.captain.option.bye": "Прощай.",
    "npc.ranger.name": "Следопыт",
    "npc.ranger.greeting": "Тихие шаги, незнакомец. Лес слушает.",
    "npc.ranger.forest": "К югу отсюда логово ужасных волков, а за ним стоят лагерем бандиты. Фенмор лежит за полями, на юго-востоке.",
    "npc.ranger.taken": "Принеси их клыки, и я заплачу.",
    "npc.ranger.paid": "Меньше волков, безопаснее дороги. Держи.",
    "npc.ranger.option.patrol": "Меня послал капитан.",
    "npc.ranger.option.forest": "Что водится в этих лесах?",
    "npc.ranger.option.take_fangs": "Я пойду на ужасных волков.",
    "npc.ranger.option.fangs": "Я принёс клыки ужасных волков.",
    "npc.ranger.option.back": "Что-нибудь другое.",
    "npc.ranger.option.bye": "Прощай.",
    "npc.foreman.name": "Десятник",
    "npc.foreman.greeting": "Стоунброк копает, Стоунброк платит. Ищешь работу?",
    "npc.foreman.work": "Шахты к северу от города кишат летучими мышами и кобольдами, а в самой глубине проснулось что-то большое.",
    "npc.foreman.taken": "Вход в шахту на северной дороге. Береги голову.",
    "npc.foreman.paid": "Честная работа, честная плата.",
    "npc.foreman.option.sent": "Меня прислала гильдия.",
    "npc.foreman.option.work": "Есть работа в шахтах?",
    "npc.foreman.option.wings": "Я принёс крылья летучих мышей.",
    "npc.foreman.option.candles": "Я принёс свечи кобольдов.",
    "npc.foreman.option.core": "Я принёс ядро голема.",
    "npc.foreman.option.take_wings": "Я разгоню летучих мышей.",
    "npc.foreman.option.take_candles": "Я прогоню кобольдов.",
    "npc.foreman.option.take_core": "Я встречусь с големом.",
    "npc.foreman.option.back": "Что-нибудь другое.",
    "npc.foreman.option.bye": "Прощай.",
    "npc.quartermaster.name": "Интендант",
    "npc.fen_elder.name": "Старейшина",
    "npc.fen_elder.greeting": "Смотри под ноги на мостках. Болото удерживает всё, что в него упало.",
    "npc.fen_elder.work": "Нашему лекарству нужны лягушачьи лапки и слизистый гель, нашим фонарям — свет огоньков, а ведьма с западного острова проклинает всех нас.",
    "npc.fen_elder.taken": "Пусть доски выдержат тебя.",
    "npc.fen_elder.paid": "Фенвик благодарит тебя.",
    "npc.fen_elder.option.letter": "Травница из Ауреллии шлёт привет.",
    "npc.fen_elder.option.work": "Могу ли я помочь деревне?",
    "npc.fen_elder.option.remedy": "Я принёс то, что нужно для лекарства.",
    "npc.fen_elder.option.charm": "Я принёс амулет ведьмы.",
    "npc.fen_elder.option.essence": "Я принёс эссенцию огоньков.",
    "npc.fen_elder.option.take_remedy": "Я соберу для лекарства.",
    "npc.fen_elder.option.take_hag": "Я встречусь с ведьмой.",
    "npc.fen_elder.option.take_wisps": "Я поймаю свет огоньков.",
    "npc.fen_elder.option.back": "Что-нибудь другое.",
    "npc.fen_elder.option.bye": "Прощай.",
    "npc.fen_trader.name": "Торговка",
    "npc.guild_clerk.option.take_stonebrook": "Я отправлюсь в Стоунброк.",
    "npc.herbalist.option.letter": "Нужно что-нибудь передать?",
    "npc.herbalist.letter": "Да! Передай мой привет старейшине Фенвика, на болоте к югу от полей.",
}
