// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "Первые шаги",
    "quest.first_steps.desc": "Поговори с травницей и принеси проводнику три светящиеся травы.",
    "quest.arrival.name": "Прибытие",
    "quest.arrival.desc": "Учись у инструктора, найди проводника на поле, принеси три хвоста крыс и зарегистрируйся в Гильдии искателей приключений.",
    "quest.goblin_trouble.name": "Беда с гоблинами",
    "quest.goblin_trouble.desc": "Гоблины спустились на колючие холмы. Принеси пять гоблиньих ушей писарю гильдии.",
    "quest.spider_silk.name": "Паутинный шёлк",
    "quest.spider_silk.desc": "Ткачи Ауреллии платят за шёлк. Принеси четыре паутинки с колючих холмов писарю гильдии.",
    // Alpha world quests.
    "quest.wolf_cull.name": "Волки у ворот",
    "quest.wolf_cull.desc": "Волки бродят по полям к югу от Ауреллии. Принеси пять волчьих шкур капитану южных ворот.",
    "quest.forest_patrol.name": "Дозор в Уиспервуде",
    "quest.forest_patrol.desc": "Иди по дороге на запад из Ауреллии в Уиспервуд и доложи следопыту в охотничьей хижине.",
    "quest.bandit_badges.name": "Бандитские знаки",
    "quest.bandit_badges.desc": "Бандиты засели глубоко в Уиспервуде. Принеси шесть бандитских знаков капитану.",
    "quest.dire_fangs.name": "Клыки ужасных волков",
    "quest.dire_fangs.desc": "Ужасные волки обитают к югу от хижины. Принеси четыре клыка следопыту.",
    "quest.road_to_stonebrook.name": "Дорога в Стоунброк",
    "quest.road_to_stonebrook.desc": "Иди на восток через колючие холмы в Стоунброк и поговори с десятником шахты.",
    "quest.bat_wings.name": "Крылья летучих мышей",
    "quest.bat_wings.desc": "Летучие мыши заполонили первую пещеру шахт Айронридж. Принеси шесть крыльев десятнику.",
    "quest.kobold_candles.name": "Свечи кобольдов",
    "quest.kobold_candles.desc": "Кобольды роют в восточной пещере шахты. Принеси восемь их свечей десятнику.",
    "quest.heart_of_stone.name": "Каменное сердце",
    "quest.heart_of_stone.desc": "Каменный голем стережёт глубину шахты. Принеси его ядро десятнику.",
    "quest.letter_to_fenwick.name": "Весточка для Фенвика",
    "quest.letter_to_fenwick.desc": "Передай привет травницы на юг, через поля, старейшине Фенвика в Фенморе.",
    "quest.marsh_remedy.name": "Болотное лекарство",
    "quest.marsh_remedy.desc": "Старейшине Фенвика нужны пять лягушачьих лапок и три слизистых геля для деревенского лекарства.",
    "quest.hags_curse.name": "Проклятие ведьмы",
    "quest.hags_curse.desc": "Болотная ведьма проклинает Фенвик со своего острова на западе. Принеси её амулет старейшине.",
    "quest.wisp_lights.name": "Огоньки болот",
    "quest.wisp_lights.desc": "Старейшина Фенвика покупает эссенцию болотных огоньков для деревенских фонарей. Принеси три.",
}
