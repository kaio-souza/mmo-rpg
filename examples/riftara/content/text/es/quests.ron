// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "Primeros pasos",
    "quest.first_steps.desc": "Habla con la herborista y lleva tres hierbas brillantes al guía.",
    "quest.arrival.name": "Llegada",
    "quest.arrival.desc": "Aprende del instructor, encuentra al guía en el campo, trae tres colas de rata y regístrate en el Gremio de Aventureros.",
    "quest.goblin_trouble.name": "Problemas con goblins",
    "quest.goblin_trouble.desc": "Los goblins bajaron a las colinas de zarzas. Trae cinco orejas de goblin al escribano del gremio.",
    "quest.spider_silk.name": "Seda de araña",
    "quest.spider_silk.desc": "Los tejedores de Aurelia pagan por seda. Trae cuatro sedas de araña de las colinas de zarzas al escribano del gremio.",
    // Alpha world quests.
    "quest.wolf_cull.name": "Lobos en la puerta",
    "quest.wolf_cull.desc": "Los lobos merodean por los campos al sur de Aurelia. Trae cinco pieles de lobo al capitán de la puerta sur.",
    "quest.forest_patrol.name": "Patrulla a Whisperwood",
    "quest.forest_patrol.desc": "Sigue el camino al oeste de Aurelia hasta Whisperwood y preséntate al guardabosques del refugio.",
    "quest.bandit_badges.name": "Insignias de bandido",
    "quest.bandit_badges.desc": "Los bandidos acampan en lo profundo de Whisperwood. Trae seis insignias de bandido al capitán.",
    "quest.dire_fangs.name": "Colmillos terribles",
    "quest.dire_fangs.desc": "Los lobos terribles tienen su guarida al sur del refugio. Trae cuatro colmillos terribles al guardabosques.",
    "quest.road_to_stonebrook.name": "El camino a Stonebrook",
    "quest.road_to_stonebrook.desc": "Toma el camino al este por las colinas de zarzas hasta Stonebrook y habla con el capataz de la mina.",
    "quest.bat_wings.name": "Alas de murciélago",
    "quest.bat_wings.desc": "Los murciélagos infestan la primera caverna de las minas de Ironridge. Trae seis alas de murciélago al capataz.",
    "quest.kobold_candles.name": "Velas de kobold",
    "quest.kobold_candles.desc": "Los kobolds cavan en la caverna este de la mina. Trae ocho de sus velas al capataz.",
    "quest.heart_of_stone.name": "Corazón de piedra",
    "quest.heart_of_stone.desc": "Un gólem de roca custodia el fondo de la mina. Lleva su núcleo al capataz.",
    "quest.letter_to_fenwick.name": "Mensaje para Fenwick",
    "quest.letter_to_fenwick.desc": "Lleva los saludos de la herborista hacia el sur, por los campos, hasta el anciano de Fenwick en Fenmoor.",
    "quest.marsh_remedy.name": "Remedio del pantano",
    "quest.marsh_remedy.desc": "El anciano de Fenwick necesita cinco patas de rana y tres gelatinas de limo para el remedio del pueblo.",
    "quest.hags_curse.name": "La maldición de la bruja",
    "quest.hags_curse.desc": "Una bruja del pantano maldice Fenwick desde su isla al oeste. Lleva su amuleto al anciano.",
    "quest.wisp_lights.name": "Luces fatuas",
    "quest.wisp_lights.desc": "El anciano de Fenwick compra esencia de fuego fatuo para los faroles del pueblo. Trae tres.",
}
