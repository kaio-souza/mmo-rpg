// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "Guía",
    "npc.guide.greeting": "Bienvenido, recién llegado. El círculo te trajo aquí, como a los demás.",
    "npc.guide.where": "Esta es la puerta sur de Aurelia. Los campos quedan más allá, y después el bosque, las colinas y el pantano.",
    "npc.guide.system": "El Sistema habla con quienes fueron invocados. Escucha cuando te muestre algo.",
    "npc.guide.option.where": "¿Dónde estoy?",
    "npc.guide.option.system": "¿Qué es el Sistema?",
    "npc.guide.option.back": "Tengo otra pregunta.",
    "npc.guide.option.bye": "Adiós.",
    "npc.guide.option.work": "¿Hay algo que pueda hacer?",
    "npc.guide.offer": "Visita a la herborista del barrio del mercado, al oeste de la plaza, y tráeme tres hierbas brillantes. Una prueba de que sabes encontrar el camino.",
    "npc.guide.option.accept": "Lo haré.",
    "npc.guide.accepted": "Bien. La herborista sabrá por qué viniste.",
    "npc.guide.option.done": "Traje las hierbas.",
    "npc.guide.thanks": "Bien hecho. Toma este pan y algo de moneda para el camino.",
    "npc.herbalist.name": "Herborista",
    "npc.herbalist.greeting": "Cuidado con los brotes. ¿Qué te trae a mi jardín?",
    "npc.herbalist.option.sent": "El guía me mandó por hierbas brillantes.",
    "npc.herbalist.gift": "Otro recién llegado. Aquí, recién cortadas. Dile al guía que lo saludo.",
    "npc.herbalist.option.bye": "Gracias. Adiós.",
    "npc.merchant.name": "Mercader",
    "npc.smith.name": "Herrero",
    "npc.smith.greeting": "Metal, reparaciones o un oficio que aprender. ¿Qué necesitas?",
    "npc.smith.option.smelting": "Enséñame a fundir mineral. (100 de cobre)",
    "npc.smith.option.sword": "Enséñame a forjar una espada. (1100 de cobre)",
    "npc.smith.option.bye": "Otra vez será.",
    "npc.smith.taught": "Fíjate en el color del metal, no en el reloj. Ya es tuyo.",
    "npc.smith.option.metals": "Sobre metales y lingotes.",
    "npc.smith.option.learn_copper_ingot": "Enséñame el lingote de cobre. (50 de cobre)",
    "npc.smith.option.learn_silver_ingot": "Enséñame el lingote de plata. (1000 de cobre)",
    "npc.smith.option.melee": "Sobre armas cuerpo a cuerpo.",
    "npc.smith.option.learn_iron_axe": "Enséñame el hacha de hierro. (1400 de cobre)",
    "npc.smith.option.learn_iron_spear": "Enséñame la lanza de hierro. (1300 de cobre)",
    "npc.smith.option.learn_stone_hammer": "Enséñame el martillo de piedra. (850 de cobre)",
    "npc.smith.option.learn_iron_hammer": "Enséñame el martillo de hierro. (1550 de cobre)",
    "npc.smith.option.ranged": "Sobre arcos y bastones.",
    "npc.smith.option.learn_wooden_bow": "Enséñame el arco de madera. (700 de cobre)",
    "npc.smith.option.learn_iron_bow": "Enséñame el arco de hierro. (1350 de cobre)",
    "npc.smith.option.learn_oak_staff": "Enséñame el bastón de roble. (800 de cobre)",
    "npc.smith.option.learn_iron_staff": "Enséñame el bastón de hierro. (1450 de cobre)",
    "npc.smith.option.armor": "Sobre armaduras.",
    "npc.smith.option.learn_cloth_tunic": "Enséñame la túnica de tela. (550 de cobre)",
    "npc.smith.option.learn_studded_leather": "Enséñame el cuero tachonado. (1000 de cobre)",
    "npc.smith.option.learn_iron_chainmail": "Enséñame la cota de malla de hierro. (1200 de cobre)",
    "npc.smith.option.learn_iron_plate_armor": "Enséñame la armadura de placas de hierro. (2300 de cobre)",
    "npc.smith.lessons": "¿Qué oficio quieres aprender?",
    "npc.smith.option.back": "Otra cosa.",
    "npc.herbalist.option.lessons": "¿Me enseñas pociones?",
    "npc.herbalist.lessons": "Raíces y flores pueden curar o afilar un cuerpo. ¿Qué preparado?",
    "npc.herbalist.taught": "Cuida el fuego y la medida. Ya es tuyo.",
    "npc.herbalist.option.back": "Otra cosa.",
    "npc.herbalist.option.learn_minor_health_potion": "Enséñame la poción de vida menor. (200 de cobre)",
    "npc.herbalist.option.learn_vigor_elixir": "Enséñame el elixir de vigor. (300 de cobre)",
    "npc.herbalist.option.learn_mana_tonic": "Enséñame el tónico de maná. (300 de cobre)",
    "npc.herbalist.option.learn_minor_heal": "Enséñame a curar con luz. (300 de cobre)",
    "npc.herbalist.option.learn_revival_draught": "Enséñame la poción de revivir. (500 de cobre)",
    "npc.herbalist.option.learn_health_potion": "Enséñame la poción de vida. (500 de cobre)",
    "npc.herbalist.option.learn_greater_vigor_elixir": "Enséñame el elixir de vigor mayor. (800 de cobre)",
    "npc.herbalist.option.learn_greater_health_potion": "Enséñame la poción de vida mayor. (1000 de cobre)",
    "npc.summoner.name": "Invocador",
    "npc.summoner.greeting": "Estás despierto. Respira. El círculo te trajo de tu mundo al nuestro, como trajo a los demás.",
    "npc.summoner.what": "Aurelia pidió ayuda y el círculo respondió contigo. Nadie puede devolverte. Pero aquí puedes hacerte fuerte.",
    "npc.summoner.system": "El Sistema es la voz que oyen los invocados. Cuenta tus hazañas y te da títulos. Ya tienes uno.",
    "npc.summoner.offer": "Primero aprende a ponerte en pie. Ve al instructor en el patio, al este, y luego al guía en el campo al sur de la puerta. Cuando estés listo, el Gremio te registrará.",
    "npc.summoner.accepted": "Ve. Las marcas sobre las personas que debes ver te guiarán.",
    "npc.summoner.next": "El instructor en el patio, al este; el guía en el campo al sur de la puerta; tres colas de rata; luego la sede del Gremio, al noroeste.",
    "npc.summoner.option.what": "¿Qué me pasó?",
    "npc.summoner.option.system": "¿Qué es esta voz en mi cabeza?",
    "npc.summoner.option.begin": "¿Qué debo hacer ahora?",
    "npc.summoner.option.next": "¿Adónde voy después?",
    "npc.summoner.option.accept": "Estoy listo.",
    "npc.summoner.option.back": "Tengo otra pregunta.",
    "npc.summoner.option.bye": "Luego.",
    "npc.instructor.name": "Instructor",
    "npc.instructor.greeting": "Otro del círculo. Puños arriba. Nadie sale de mi patio sin saber dar una patada.",
    "npc.instructor.taught": "Esto es una Patada. Arrástrala desde la ventana de técnicas a la barra de abajo y pulsa su número en un combate.",
    "npc.instructor.fight": "Haz clic en una criatura para atacarla; seguirás golpeando solo. Si algo te golpea, devuelves el golpe. Vigila tu vida y retírate cuando baje.",
    "npc.instructor.option.teach": "Enséñame a luchar.",
    "npc.instructor.option.fight": "¿Cómo funciona un combate?",
    "npc.instructor.option.back": "Otra cosa.",
    "npc.instructor.option.bye": "Gracias.",
    "npc.guild_clerk.name": "Escribano del Gremio",
    "npc.guild_clerk.greeting": "Gremio de Aventureros de Aurelia. Registro, trabajo y pago, en ese orden.",
    "npc.guild_clerk.registered": "Nombre anotado, carné sellado. Bienvenido al Gremio, aventurero. Pídeme trabajo siempre que necesites monedas.",
    "npc.guild_clerk.not_yet": "El invocador todavía no ha terminado contigo. Vuelve cuando hayas hecho lo que se pidió.",
    "npc.guild_clerk.work": "Los goblins bajaron a las colinas de zarzas al este del campo, y los tejedores pagan seda de araña de esas mismas colinas.",
    "npc.guild_clerk.taken": "Anotado. Trae la prueba y te pagarán.",
    "npc.guild_clerk.paid": "Contado y pagado. Buen trabajo.",
    "npc.guild_clerk.option.register": "Quiero registrarme.",
    "npc.guild_clerk.option.not_yet": "Vine a registrarme.",
    "npc.guild_clerk.option.work": "¿Hay trabajo?",
    "npc.guild_clerk.option.take_goblins": "Me ocuparé de los goblins.",
    "npc.guild_clerk.option.take_silk": "Traeré seda de araña.",
    "npc.guild_clerk.option.ears": "Traje orejas de goblin.",
    "npc.guild_clerk.option.silk": "Traje seda de araña.",
    "npc.guild_clerk.option.back": "Otra cosa.",
    "npc.guild_clerk.option.bye": "Adiós.",
    "npc.guide.option.sent": "Me envió el invocador.",
    "npc.guide.rats": "Las ratas roen los campos fuera de esta puerta. Trae tres colas para demostrar que sabes luchar. El mercader del mercado, al oeste de la plaza, compra lo que saquees.",
    // Alpha world NPCs.
    "npc.captain.name": "Capitán",
    "npc.captain.greeting": "Mantén la hoja lista más allá de esta puerta. Los campos no son tan tranquilos como parecen.",
    "npc.captain.work": "Lobos en los campos, y bandidos en Whisperwood, al oeste. El guardabosques del refugio conoce el bosque.",
    "npc.captain.taken": "Bien. Vuelve a informar cuando termines.",
    "npc.captain.paid": "La ciudad te debe. Aquí está tu paga.",
    "npc.captain.option.work": "¿Algún trabajo para mí?",
    "npc.captain.option.pelts": "Traje las pieles de lobo.",
    "npc.captain.option.badges": "Traje las insignias de bandido.",
    "npc.captain.option.take_wolves": "Cazaré a los lobos.",
    "npc.captain.option.take_patrol": "Encontraré al guardabosques.",
    "npc.captain.option.take_bandits": "Me ocuparé de los bandidos.",
    "npc.captain.option.back": "Otra cosa.",
    "npc.captain.option.bye": "Adiós.",
    "npc.ranger.name": "Guardabosques",
    "npc.ranger.greeting": "Pasos silenciosos, forastero. El bosque escucha.",
    "npc.ranger.forest": "Los lobos terribles tienen su guarida al sur de aquí, y los bandidos acampan más allá. Fenmoor queda al sureste, más allá de los campos.",
    "npc.ranger.taken": "Tráeme sus colmillos y te pagaré.",
    "npc.ranger.paid": "Menos lobos, caminos más seguros. Toma esto.",
    "npc.ranger.option.patrol": "Me envió el capitán.",
    "npc.ranger.option.forest": "¿Qué hay en estos bosques?",
    "npc.ranger.option.take_fangs": "Cazaré a los lobos terribles.",
    "npc.ranger.option.fangs": "Traje colmillos terribles.",
    "npc.ranger.option.back": "Otra cosa.",
    "npc.ranger.option.bye": "Adiós.",
    "npc.foreman.name": "Capataz",
    "npc.foreman.greeting": "Stonebrook excava, Stonebrook paga. ¿Buscas trabajo?",
    "npc.foreman.work": "Las minas al norte del pueblo están llenas de murciélagos y kobolds, y algo grande despertó en el fondo.",
    "npc.foreman.taken": "La boca de la mina está por el camino del norte. Cuidado con la cabeza.",
    "npc.foreman.paid": "Trabajo justo, paga justa.",
    "npc.foreman.option.sent": "Me envió el gremio.",
    "npc.foreman.option.work": "¿Hay trabajo en las minas?",
    "npc.foreman.option.wings": "Traje alas de murciélago.",
    "npc.foreman.option.candles": "Traje velas de kobold.",
    "npc.foreman.option.core": "Traje el núcleo del gólem.",
    "npc.foreman.option.take_wings": "Despejaré a los murciélagos.",
    "npc.foreman.option.take_candles": "Ahuyentaré a los kobolds.",
    "npc.foreman.option.take_core": "Me enfrentaré al gólem.",
    "npc.foreman.option.back": "Otra cosa.",
    "npc.foreman.option.bye": "Adiós.",
    "npc.quartermaster.name": "Intendente",
    "npc.fen_elder.name": "Anciano",
    "npc.fen_elder.greeting": "Cuidado con las pasarelas. El pantano guarda lo que cae en él.",
    "npc.fen_elder.work": "Nuestro remedio necesita patas de rana y gelatina de limo, nuestros faroles necesitan luz de fuego fatuo, y la bruja de la isla del oeste nos maldice a todos.",
    "npc.fen_elder.taken": "Que las tablas te aguanten.",
    "npc.fen_elder.paid": "Fenwick te lo agradece.",
    "npc.fen_elder.option.letter": "La herborista de Aurelia manda saludos.",
    "npc.fen_elder.option.work": "¿Puedo ayudar al pueblo?",
    "npc.fen_elder.option.remedy": "Traje lo que necesita el remedio.",
    "npc.fen_elder.option.charm": "Traje el amuleto de la bruja.",
    "npc.fen_elder.option.essence": "Traje esencia de fuego fatuo.",
    "npc.fen_elder.option.take_remedy": "Recolectaré para el remedio.",
    "npc.fen_elder.option.take_hag": "Me enfrentaré a la bruja.",
    "npc.fen_elder.option.take_wisps": "Atraparé la luz de los fuegos fatuos.",
    "npc.fen_elder.option.back": "Otra cosa.",
    "npc.fen_elder.option.bye": "Adiós.",
    "npc.fen_trader.name": "Comerciante",
    "npc.guild_clerk.option.take_stonebrook": "Iré a Stonebrook.",
    "npc.herbalist.option.letter": "¿Necesitas que lleve algo?",
    "npc.herbalist.letter": "¡Sí! Lleva mis saludos al anciano de Fenwick, en el pantano al sur de los campos.",
}
