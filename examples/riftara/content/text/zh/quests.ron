// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "初次尝试",
    "quest.first_steps.desc": "与草药师交谈，把三株发光的草药带给向导。",
    "quest.arrival.name": "抵达",
    "quest.arrival.desc": "向教官学习，在野外找到向导，带三条鼠尾回来，并在冒险者公会登记。",
    "quest.goblin_trouble.name": "地精之乱",
    "quest.goblin_trouble.desc": "地精下到了荆棘丘陵。把五只地精耳朵交给公会文员。",
    "quest.spider_silk.name": "蜘蛛丝",
    "quest.spider_silk.desc": "奥雷利亚的织工收购蛛丝。把四根荆棘丘陵上的蛛丝交给公会文员。",
    // Alpha world quests.
    "quest.wolf_cull.name": "城门前的狼",
    "quest.wolf_cull.desc": "狼群在奥雷利亚南边的田野里游荡。把五张狼皮交给南门的队长。",
    "quest.forest_patrol.name": "前往低语林的巡逻",
    "quest.forest_patrol.desc": "沿奥雷利亚西面的道路前往低语林，向小屋里的护林人报到。",
    "quest.bandit_badges.name": "强盗徽记",
    "quest.bandit_badges.desc": "强盗扎营在低语林深处。把六枚强盗徽记交给队长。",
    "quest.dire_fangs.name": "恐狼之牙",
    "quest.dire_fangs.desc": "恐狼在小屋南面筑巢。把四颗恐狼之牙交给护林人。",
    "quest.road_to_stonebrook.name": "通往石溪的路",
    "quest.road_to_stonebrook.desc": "向东穿过荆棘丘陵前往石溪，与矿场工头交谈。",
    "quest.bat_wings.name": "蝠翼",
    "quest.bat_wings.desc": "蝙蝠占据了铁脊矿场的第一个洞穴。把六片蝠翼交给工头。",
    "quest.kobold_candles.name": "狗头人的蜡烛",
    "quest.kobold_candles.desc": "狗头人在矿场东洞里挖掘。把八根它们的蜡烛交给工头。",
    "quest.heart_of_stone.name": "石之心",
    "quest.heart_of_stone.desc": "一头岩石魔像守着矿场深处。把它的核心交给工头。",
    "quest.letter_to_fenwick.name": "给芬威克的口信",
    "quest.letter_to_fenwick.desc": "把草药师的问候向南穿过田野，带到芬莫的芬威克长老那里。",
    "quest.marsh_remedy.name": "沼泽药剂",
    "quest.marsh_remedy.desc": "芬威克长老需要五条蛙腿和三团黏液凝胶，用来为村子配药。",
    "quest.hags_curse.name": "女巫的诅咒",
    "quest.hags_curse.desc": "一位沼泽女巫从西边的岛上诅咒芬威克。把她的护符带给长老。",
    "quest.wisp_lights.name": "鬼火之光",
    "quest.wisp_lights.desc": "芬威克长老收购鬼火精华，用于村里的灯笼。带三份来。",
}
