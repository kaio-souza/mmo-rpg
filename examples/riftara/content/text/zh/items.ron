// Texts of items (content/items/).
{
    "item.glow_herb.name": "发光草药",
    "item.glow_herb.desc": "一种在黄昏时微微发光的草药。向导需要它。",
    "item.travel_bread.name": "旅行面包",
    "item.travel_bread.desc": "结实的面包，能保存数周。",
    "item.rusty_sword.name": "生锈的剑",
    "item.rusty_sword.desc": "很旧了，但仍然锋利。它身上有些东西值得仔细看看。",
    "item.hunting_knife.name": "猎刀",
    "item.hunting_knife.desc": "在稳定的手中轻巧又迅捷。",
    "item.leather_armor.name": "皮甲",
    "item.leather_armor.desc": "硬硬的皮革，能挡住一两次撕咬。",
    "item.wolf_pelt.name": "狼皮",
    "item.wolf_pelt.desc": "厚实的灰色毛皮。制革匠愿意出价收购。",
    "item.boar_tusk.name": "野猪獠牙",
    "item.boar_tusk.desc": "弯曲而锋利。对工匠有用。",
    "item.iron_ore.name": "铁矿石",
    "item.iron_ore.desc": "原矿。两块可以熔炼成一根锭。",
    "item.iron_ingot.name": "铁锭",
    "item.iron_ingot.desc": "纯净的金属，随时可以上砧。",
    "item.iron_sword.name": "铁剑",
    "item.iron_sword.desc": "锻造扎实，平衡良好，值得修理。",
    "item.rat_tail.name": "鼠尾",
    "item.rat_tail.desc": "又长又光秃，几乎没什么价值。",
    "item.spider_silk.name": "蜘蛛丝",
    "item.spider_silk.desc": "一束黏稠而坚韧的灰色丝线。",
    "item.goblin_ear.name": "地精耳朵",
    "item.goblin_ear.desc": "尖尖的，绿色的。公会会用它作为凭证付钱。",
    "item.guild_card.name": "公会卡",
    "item.guild_card.desc": "你的名字，由奥雷利亚冒险者公会盖章。",
    // Alpha world drops.
    "item.bandit_badge.name": "强盗徽记",
    "item.bandit_badge.desc": "低语林强盗粗糙的铜质徽记。队长会用它作为凭证付钱。",
    "item.dire_fang.name": "恐狼之牙",
    "item.dire_fang.desc": "又长又黄的獠牙。护林人会收集它们。",
    "item.bat_wing.name": "蝠翼",
    "item.bat_wing.desc": "来自矿洞的革质翅膀。",
    "item.kobold_candle.name": "狗头人蜡烛",
    "item.kobold_candle.desc": "狗头人戴在头盔上的油腻蜡头。",
    "item.golem_core.name": "魔像核心",
    "item.golem_core.desc": "一颗仍在发光的温热石心。",
    "item.frog_leg.name": "蛙腿",
    "item.frog_leg.desc": "沼泽蛙肥厚的腿。芬威克的厨师对它赞不绝口。",
    "item.slime_gel.name": "黏液凝胶",
    "item.slime_gel.desc": "绿色、冰凉、黏糊糊。沼泽的治疗师都会用。",
    "item.hag_charm.name": "女巫护符",
    "item.hag_charm.desc": "用头发缠绕的骨制护符。它带着恶意嗡嗡作响。",
    "item.wisp_essence.name": "鬼火精华",
    "item.wisp_essence.desc": "一小瓶从沼泽鬼火身上提取的苍白光芒。",
    "item.torch.name": "火把",
    "item.torch.desc": "缠着浸油破布的木棍。握在手中可照亮黑暗，同时会慢慢燃尽。",
}
