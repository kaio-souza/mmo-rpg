// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "向导",
    "npc.guide.greeting": "欢迎，新来的。和其他人一样，是魔法阵把你带到这里的。",
    "npc.guide.where": "这里是奥雷利亚的南门。门外是田野，再远处是森林、丘陵和沼泽。",
    "npc.guide.system": "系统会对被召唤的人说话。它展示什么的时候请留意听。",
    "npc.guide.option.where": "我在哪里？",
    "npc.guide.option.system": "什么是系统？",
    "npc.guide.option.back": "我还有别的问题。",
    "npc.guide.option.bye": "再见。",
    "npc.guide.option.work": "我能做些什么吗？",
    "npc.guide.offer": "去广场西边的集市区找草药师，给我带三株发光的草药。这能证明你找得到路。",
    "npc.guide.option.accept": "我去做。",
    "npc.guide.accepted": "好。草药师会知道你为什么来的。",
    "npc.guide.option.done": "我带来草药了。",
    "npc.guide.thanks": "做得好。拿着这块干粮，再带些钱路上用。",
    "npc.herbalist.name": "草药师",
    "npc.herbalist.greeting": "小心脚下的幼苗。你来我的花园有何贵干？",
    "npc.herbalist.option.sent": "向导让我来找发光的草药。",
    "npc.herbalist.gift": "又一个新来的。给，刚摘的。替我向向导问好。",
    "npc.herbalist.option.bye": "谢谢，再见。",
    "npc.merchant.name": "商人",
    "npc.smith.name": "铁匠",
    "npc.smith.greeting": "金属、修理，或者想学的手艺。你要哪一样？",
    "npc.smith.option.smelting": "教我熔炼矿石。（100 铜）",
    "npc.smith.option.sword": "教我锻造剑。（1100 铜）",
    "npc.smith.option.bye": "下次再说。",
    "npc.smith.taught": "看金属的颜色，别看时钟。现在它是你的了。",
    "npc.smith.option.metals": "关于金属和锭。",
    "npc.smith.option.learn_copper_ingot": "教我铜锭。（50 铜）",
    "npc.smith.option.learn_silver_ingot": "教我银锭。（1000 铜）",
    "npc.smith.option.melee": "关于近战武器。",
    "npc.smith.option.learn_iron_axe": "教我铁斧。（1400 铜）",
    "npc.smith.option.learn_iron_spear": "教我铁枪。（1300 铜）",
    "npc.smith.option.learn_stone_hammer": "教我石锤。（850 铜）",
    "npc.smith.option.learn_iron_hammer": "教我铁锤。（1550 铜）",
    "npc.smith.option.ranged": "关于弓和法杖。",
    "npc.smith.option.learn_wooden_bow": "教我木弓。（700 铜）",
    "npc.smith.option.learn_iron_bow": "教我铁弓。（1350 铜）",
    "npc.smith.option.learn_oak_staff": "教我橡木法杖。（800 铜）",
    "npc.smith.option.learn_iron_staff": "教我铁法杖。（1450 铜）",
    "npc.smith.option.armor": "关于护甲。",
    "npc.smith.option.learn_cloth_tunic": "教我布制短衣。（550 铜）",
    "npc.smith.option.learn_studded_leather": "教我镶钉皮甲。（1000 铜）",
    "npc.smith.option.learn_iron_chainmail": "教我铁链甲。（1200 铜）",
    "npc.smith.option.learn_iron_plate_armor": "教我铁板甲。（2300 铜）",
    "npc.smith.lessons": "你想学哪门手艺？",
    "npc.smith.option.back": "别的事。",
    "npc.herbalist.option.lessons": "你能教我药剂吗？",
    "npc.herbalist.lessons": "根和花可以治愈或强化身体。你要哪种药剂？",
    "npc.herbalist.taught": "注意火候和分量。现在它是你的了。",
    "npc.herbalist.option.back": "别的事。",
    "npc.herbalist.option.learn_minor_health_potion": "教我小型生命药水。（200 铜）",
    "npc.herbalist.option.learn_vigor_elixir": "教我活力灵药。（300 铜）",
    "npc.herbalist.option.learn_mana_tonic": "教我法力补剂。（300 铜）",
    "npc.herbalist.option.learn_minor_heal": "教我用光治疗。（300 铜）",
    "npc.herbalist.option.learn_revival_draught": "教我复苏药剂。（500 铜）",
    "npc.herbalist.option.learn_health_potion": "教我生命药水。（500 铜）",
    "npc.herbalist.option.learn_greater_vigor_elixir": "教我高级活力灵药。（800 铜）",
    "npc.herbalist.option.learn_greater_health_potion": "教我高级生命药水。（1000 铜）",
    "npc.summoner.name": "召唤师",
    "npc.summoner.greeting": "你醒了。深呼吸。和其他人一样，魔法阵把你从你的世界带到了我们的世界。",
    "npc.summoner.what": "奥雷利亚求助，魔法阵以你作为回应。没有人能送你回去。但在这里，你可以变得强大。",
    "npc.summoner.system": "系统是被召唤者听到的声音。它记录你的功绩并授予称号。其中一个已经属于你了。",
    "npc.summoner.offer": "先学会自己站稳。去东边训练场找教官，然后去城门南面田野里找向导。准备好了，公会会为你登记。",
    "npc.summoner.accepted": "去吧。你必须见的人头顶上的标记会为你指路。",
    "npc.summoner.next": "东边训练场的教官，城门南面田野的向导，三条鼠尾，然后是西北面的公会大厅。",
    "npc.summoner.option.what": "我发生了什么事？",
    "npc.summoner.option.system": "我脑子里这个声音是什么？",
    "npc.summoner.option.begin": "现在我该做什么？",
    "npc.summoner.option.next": "接下来去哪里？",
    "npc.summoner.option.accept": "我准备好了。",
    "npc.summoner.option.back": "我还有别的问题。",
    "npc.summoner.option.bye": "回头再说。",
    "npc.instructor.name": "教官",
    "npc.instructor.greeting": "又一个魔法阵来的。拳头举起来。不会踢人的，别想走出我的训练场。",
    "npc.instructor.taught": "这就是踢击。把它从技能窗口拖到下面的快捷栏，战斗时按它的编号。",
    "npc.instructor.fight": "点击生物即可攻击，之后你会自动持续出手。如果有东西打你，你就还手。留意你的生命值，低了就后退。",
    "npc.instructor.option.teach": "教我战斗。",
    "npc.instructor.option.fight": "战斗是怎么进行的？",
    "npc.instructor.option.back": "别的事。",
    "npc.instructor.option.bye": "谢谢。",
    "npc.guild_clerk.name": "公会文员",
    "npc.guild_clerk.greeting": "奥雷利亚冒险者公会。登记、工作和结算，按这个顺序来。",
    "npc.guild_clerk.registered": "姓名已登记，公会卡已盖章。欢迎加入公会，冒险者。需要钱的时候随时来找我领工作。",
    "npc.guild_clerk.not_yet": "召唤师还没有结束对你的安排。等你完成所要求的事情再回来。",
    "npc.guild_clerk.work": "地精下到了田野东边的荆棘丘陵，织工也在同一片丘陵收购蜘蛛丝。",
    "npc.guild_clerk.taken": "已记录。拿来凭证就会付钱给你。",
    "npc.guild_clerk.paid": "已点清并付款。干得不错。",
    "npc.guild_clerk.option.register": "我要登记。",
    "npc.guild_clerk.option.not_yet": "我是来登记的。",
    "npc.guild_clerk.option.work": "有工作吗？",
    "npc.guild_clerk.option.take_goblins": "地精交给我。",
    "npc.guild_clerk.option.take_silk": "我去带蜘蛛丝。",
    "npc.guild_clerk.option.ears": "我带来了地精耳朵。",
    "npc.guild_clerk.option.silk": "我带来了蜘蛛丝。",
    "npc.guild_clerk.option.back": "别的事。",
    "npc.guild_clerk.option.bye": "再见。",
    "npc.guide.option.sent": "是召唤师派我来的。",
    "npc.guide.rats": "老鼠在这扇门外的田里啃庄稼。带三条鼠尾来证明你能战斗。广场西边集市上的商人会收购你的战利品。",
    // Alpha world NPCs.
    "npc.captain.name": "队长",
    "npc.captain.greeting": "过了这道门，把刀准备好。田野没有看上去那么安静。",
    "npc.captain.work": "田野里有狼，西边的低语林里有强盗。小屋里的护林人很熟悉那片森林。",
    "npc.captain.taken": "好。办完了就回来报告。",
    "npc.captain.paid": "城里欠你的。这是你的报酬。",
    "npc.captain.option.work": "有什么工作给我吗？",
    "npc.captain.option.pelts": "我带来了狼皮。",
    "npc.captain.option.badges": "我带来了强盗徽记。",
    "npc.captain.option.take_wolves": "我去猎狼。",
    "npc.captain.option.take_patrol": "我去找护林人。",
    "npc.captain.option.take_bandits": "强盗交给我。",
    "npc.captain.option.back": "别的事。",
    "npc.captain.option.bye": "再见。",
    "npc.ranger.name": "护林人",
    "npc.ranger.greeting": "脚步轻点，陌生人。森林在听。",
    "npc.ranger.forest": "往南不远有恐狼的巢穴，强盗就扎营在它们后面。芬莫在田野之外的东南方。",
    "npc.ranger.taken": "把它们的牙带来，我就付钱。",
    "npc.ranger.paid": "狼少了，路就安全了。拿着。",
    "npc.ranger.option.patrol": "是队长派我来的。",
    "npc.ranger.option.forest": "这些森林里有什么？",
    "npc.ranger.option.take_fangs": "我去猎恐狼。",
    "npc.ranger.option.fangs": "我带来了恐狼之牙。",
    "npc.ranger.option.back": "别的事。",
    "npc.ranger.option.bye": "再见。",
    "npc.foreman.name": "工头",
    "npc.foreman.greeting": "石溪挖矿，石溪付钱。你是来找活干的？",
    "npc.foreman.work": "镇子北边的矿井里满是蝙蝠和狗头人，深处还有什么大家伙醒了。",
    "npc.foreman.taken": "矿井入口在北边的路上。小心脑袋。",
    "npc.foreman.paid": "公道的活，公道的钱。",
    "npc.foreman.option.sent": "是公会派我来的。",
    "npc.foreman.option.work": "矿场里有活吗？",
    "npc.foreman.option.wings": "我带来了蝠翼。",
    "npc.foreman.option.candles": "我带来了狗头人蜡烛。",
    "npc.foreman.option.core": "我带来了魔像核心。",
    "npc.foreman.option.take_wings": "蝙蝠交给我清理。",
    "npc.foreman.option.take_candles": "狗头人交给我赶走。",
    "npc.foreman.option.take_core": "我去对付魔像。",
    "npc.foreman.option.back": "别的事。",
    "npc.foreman.option.bye": "再见。",
    "npc.quartermaster.name": "军需官",
    "npc.fen_elder.name": "长老",
    "npc.fen_elder.greeting": "小心木板路。沼泽会吞下掉进去的东西。",
    "npc.fen_elder.work": "我们的药需要蛙腿和黏液凝胶，我们的灯需要鬼火之光，而西边岛上的女巫在诅咒我们所有人。",
    "npc.fen_elder.taken": "愿木板能承住你。",
    "npc.fen_elder.paid": "芬威克感谢你。",
    "npc.fen_elder.option.letter": "奥雷利亚的草药师向您问好。",
    "npc.fen_elder.option.work": "我能帮村子做些什么？",
    "npc.fen_elder.option.remedy": "我带来了药剂所需的东西。",
    "npc.fen_elder.option.charm": "我带来了女巫的护符。",
    "npc.fen_elder.option.essence": "我带来了鬼火精华。",
    "npc.fen_elder.option.take_remedy": "我去为药剂采集材料。",
    "npc.fen_elder.option.take_hag": "我去对付女巫。",
    "npc.fen_elder.option.take_wisps": "我去捕捉鬼火之光。",
    "npc.fen_elder.option.back": "别的事。",
    "npc.fen_elder.option.bye": "再见。",
    "npc.fen_trader.name": "商贩",
    "npc.guild_clerk.option.take_stonebrook": "我去石溪。",
    "npc.herbalist.option.letter": "需要我帮忙带什么吗？",
    "npc.herbalist.letter": "需要！替我向田野南面沼泽里的芬威克长老问好。",
}
