// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "Langkah pertama",
    "quest.first_steps.desc": "Bicaralah dengan herbalis dan bawa tiga herba bercahaya kepada pemandu.",
    "quest.arrival.name": "Kedatangan",
    "quest.arrival.desc": "Belajarlah dari instruktur, temukan pemandu di ladang, bawa tiga ekor tikus dan daftarkan diri di Serikat Petualang.",
    "quest.goblin_trouble.name": "Masalah goblin",
    "quest.goblin_trouble.desc": "Goblin turun ke bukit semak duri. Bawa lima telinga goblin kepada juru tulis serikat.",
    "quest.spider_silk.name": "Sutra laba-laba",
    "quest.spider_silk.desc": "Para penenun Aurelia membayar untuk sutra. Bawa empat helai sutra laba-laba dari bukit semak duri kepada juru tulis serikat.",
    // Alpha world quests.
    "quest.wolf_cull.name": "Serigala di gerbang",
    "quest.wolf_cull.desc": "Serigala berkeliaran di ladang selatan Aurelia. Bawa lima kulit serigala kepada kapten di gerbang selatan.",
    "quest.forest_patrol.name": "Patroli ke Whisperwood",
    "quest.forest_patrol.desc": "Ikuti jalan ke barat dari Aurelia menuju Whisperwood dan lapor kepada penjaga hutan di pondok.",
    "quest.bandit_badges.name": "Lencana bandit",
    "quest.bandit_badges.desc": "Bandit berkemah jauh di dalam Whisperwood. Bawa enam lencana bandit kepada kapten.",
    "quest.dire_fangs.name": "Taring mengerikan",
    "quest.dire_fangs.desc": "Serigala mengerikan bersarang di selatan pondok. Bawa empat taring mengerikan kepada penjaga hutan.",
    "quest.road_to_stonebrook.name": "Jalan ke Stonebrook",
    "quest.road_to_stonebrook.desc": "Ambil jalan ke timur melewati bukit semak duri menuju Stonebrook dan bicaralah dengan mandor tambang.",
    "quest.bat_wings.name": "Sayap kelelawar",
    "quest.bat_wings.desc": "Kelelawar mengotori gua pertama tambang Ironridge. Bawa enam sayap kelelawar kepada mandor.",
    "quest.kobold_candles.name": "Lilin kobold",
    "quest.kobold_candles.desc": "Kobold menggali di gua timur tambang. Bawa delapan lilin mereka kepada mandor.",
    "quest.heart_of_stone.name": "Jantung batu",
    "quest.heart_of_stone.desc": "Golem batu menjaga ujung dalam tambang. Bawa intinya kepada mandor.",
    "quest.letter_to_fenwick.name": "Pesan untuk Fenwick",
    "quest.letter_to_fenwick.desc": "Bawa salam dari herbalis ke selatan, melewati ladang, menuju tetua Fenwick di Fenmoor.",
    "quest.marsh_remedy.name": "Obat rawa",
    "quest.marsh_remedy.desc": "Tetua Fenwick butuh lima kaki katak dan tiga gel lendir untuk obat desa.",
    "quest.hags_curse.name": "Kutukan penyihir",
    "quest.hags_curse.desc": "Seorang penyihir rawa mengutuk Fenwick dari pulaunya di barat. Bawa jimatnya kepada tetua.",
    "quest.wisp_lights.name": "Cahaya wisp",
    "quest.wisp_lights.desc": "Tetua Fenwick membeli esensi wisp untuk lentera desa. Bawa tiga.",
}
