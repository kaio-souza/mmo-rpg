// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "Pemandu",
    "npc.guide.greeting": "Selamat datang, pendatang baru. Lingkaran membawamu ke sini, seperti yang lain.",
    "npc.guide.where": "Ini gerbang selatan Aurelia. Ladang terbentang di luarnya, dan di baliknya ada hutan, bukit, dan rawa.",
    "npc.guide.system": "Sistem berbicara kepada mereka yang dipanggil. Dengarkan saat ia menunjukkan sesuatu.",
    "npc.guide.option.where": "Di mana aku?",
    "npc.guide.option.system": "Apa itu Sistem?",
    "npc.guide.option.back": "Aku punya pertanyaan lain.",
    "npc.guide.option.bye": "Sampai jumpa.",
    "npc.guide.option.work": "Adakah yang bisa kulakukan?",
    "npc.guide.offer": "Kunjungi herbalis di kawasan pasar, di barat alun-alun, dan bawa tiga herba bercahaya untukku. Buktinya kau bisa menemukan jalanmu.",
    "npc.guide.option.accept": "Akan kulakukan.",
    "npc.guide.accepted": "Bagus. Herbalis akan tahu mengapa kau datang.",
    "npc.guide.option.done": "Aku sudah membawa herbanya.",
    "npc.guide.thanks": "Bagus sekali. Ambil roti ini dan sedikit koin untuk perjalananmu.",
    "npc.herbalist.name": "Herbalis",
    "npc.herbalist.greeting": "Hati-hati dengan bibitnya. Apa yang membawamu ke kebunku?",
    "npc.herbalist.option.sent": "Pemandu menyuruhku mencari herba bercahaya.",
    "npc.herbalist.gift": "Pendatang baru lagi. Ini, baru dipetik. Sampaikan salamku pada pemandu.",
    "npc.herbalist.option.bye": "Terima kasih. Sampai jumpa.",
    "npc.merchant.name": "Pedagang",
    "npc.smith.name": "Pandai besi",
    "npc.smith.greeting": "Logam, perbaikan, atau kerajinan untuk dipelajari. Yang mana?",
    "npc.smith.option.smelting": "Ajari aku melebur bijih. (100 tembaga)",
    "npc.smith.option.sword": "Ajari aku menempa pedang. (1100 tembaga)",
    "npc.smith.option.bye": "Lain kali.",
    "npc.smith.taught": "Perhatikan warna logamnya, bukan jam. Sekarang ini milikmu.",
    "npc.smith.option.metals": "Tentang logam dan batang.",
    "npc.smith.option.learn_copper_ingot": "Ajari aku batang tembaga. (50 tembaga)",
    "npc.smith.option.learn_silver_ingot": "Ajari aku batang perak. (1000 tembaga)",
    "npc.smith.option.melee": "Tentang senjata jarak dekat.",
    "npc.smith.option.learn_iron_axe": "Ajari aku kapak besi. (1400 tembaga)",
    "npc.smith.option.learn_iron_spear": "Ajari aku tombak besi. (1300 tembaga)",
    "npc.smith.option.learn_stone_hammer": "Ajari aku palu batu. (850 tembaga)",
    "npc.smith.option.learn_iron_hammer": "Ajari aku palu besi. (1550 tembaga)",
    "npc.smith.option.ranged": "Tentang busur dan tongkat.",
    "npc.smith.option.learn_wooden_bow": "Ajari aku busur kayu. (700 tembaga)",
    "npc.smith.option.learn_iron_bow": "Ajari aku busur besi. (1350 tembaga)",
    "npc.smith.option.learn_oak_staff": "Ajari aku tongkat ek. (800 tembaga)",
    "npc.smith.option.learn_iron_staff": "Ajari aku tongkat besi. (1450 tembaga)",
    "npc.smith.option.armor": "Tentang zirah.",
    "npc.smith.option.learn_cloth_tunic": "Ajari aku tunik kain. (550 tembaga)",
    "npc.smith.option.learn_studded_leather": "Ajari aku kulit berpaku. (1000 tembaga)",
    "npc.smith.option.learn_iron_chainmail": "Ajari aku rantai besi. (1200 tembaga)",
    "npc.smith.option.learn_iron_plate_armor": "Ajari aku zirah pelat besi. (2300 tembaga)",
    "npc.smith.lessons": "Kerajinan apa yang ingin kau pelajari?",
    "npc.smith.option.back": "Yang lain.",
    "npc.herbalist.option.lessons": "Bisakah kau mengajariku ramuan?",
    "npc.herbalist.lessons": "Akar dan bunga bisa menyembuhkan atau mempertajam tubuh. Ramuan yang mana?",
    "npc.herbalist.taught": "Perhatikan panas dan takarannya. Sekarang ini milikmu.",
    "npc.herbalist.option.back": "Yang lain.",
    "npc.herbalist.option.learn_minor_health_potion": "Ajari aku ramuan kesehatan kecil. (200 tembaga)",
    "npc.herbalist.option.learn_vigor_elixir": "Ajari aku eliksir vigor. (300 tembaga)",
    "npc.herbalist.option.learn_mana_tonic": "Ajari aku tonik mana. (300 tembaga)",
    "npc.herbalist.option.learn_minor_heal": "Ajari aku menyembuhkan dengan cahaya. (300 tembaga)",
    "npc.herbalist.option.learn_revival_draught": "Ajari aku ramuan kebangkitan. (500 tembaga)",
    "npc.herbalist.option.learn_health_potion": "Ajari aku ramuan kesehatan. (500 tembaga)",
    "npc.herbalist.option.learn_greater_vigor_elixir": "Ajari aku eliksir vigor besar. (800 tembaga)",
    "npc.herbalist.option.learn_greater_health_potion": "Ajari aku ramuan kesehatan besar. (1000 tembaga)",
    "npc.summoner.name": "Pemanggil",
    "npc.summoner.greeting": "Kau sudah sadar. Bernapaslah. Lingkaran membawamu dari duniamu ke dunia kami, seperti yang lain.",
    "npc.summoner.what": "Aurelia meminta pertolongan, dan lingkaran menjawabnya dengan dirimu. Tidak ada yang bisa mengembalikanmu. Tetapi di sini kau bisa menjadi kuat.",
    "npc.summoner.system": "Sistem adalah suara yang didengar mereka yang dipanggil. Ia mencatat perbuatanmu dan memberi gelar. Satu sudah menjadi milikmu.",
    "npc.summoner.offer": "Pelajari dulu cara berdiri. Temui instruktur di halaman sebelah timur, lalu pemandu di ladang selatan gerbang. Jika kau siap, Serikat akan mendaftarkanmu.",
    "npc.summoner.accepted": "Pergilah. Penanda di atas orang yang harus kau temui akan menuntunmu.",
    "npc.summoner.next": "Instruktur di halaman sebelah timur, pemandu di ladang selatan gerbang, tiga ekor tikus, lalu balai Serikat di barat laut.",
    "npc.summoner.option.what": "Apa yang terjadi padaku?",
    "npc.summoner.option.system": "Suara apa ini di kepalaku?",
    "npc.summoner.option.begin": "Apa yang harus kulakukan sekarang?",
    "npc.summoner.option.next": "Ke mana aku pergi berikutnya?",
    "npc.summoner.option.accept": "Aku siap.",
    "npc.summoner.option.back": "Aku punya pertanyaan lain.",
    "npc.summoner.option.bye": "Nanti saja.",
    "npc.instructor.name": "Instruktur",
    "npc.instructor.greeting": "Satu lagi dari lingkaran. Angkat tinjumu. Tidak ada yang keluar dari halamanku tanpa bisa menendang.",
    "npc.instructor.taught": "Itu Tendangan. Seret dari jendela teknik ke bilah di bawah dan tekan nomornya saat bertarung.",
    "npc.instructor.fight": "Klik makhluk untuk menyerangnya; kau akan terus memukul sendiri. Jika sesuatu memukulmu, balaslah. Perhatikan nyawamu dan mundur saat sudah menipis.",
    "npc.instructor.option.teach": "Ajari aku bertarung.",
    "npc.instructor.option.fight": "Bagaimana sebuah pertarungan berjalan?",
    "npc.instructor.option.back": "Yang lain.",
    "npc.instructor.option.bye": "Terima kasih.",
    "npc.guild_clerk.name": "Juru tulis serikat",
    "npc.guild_clerk.greeting": "Serikat Petualang Aurelia. Pendaftaran, pekerjaan, dan pembayaran, dalam urutan itu.",
    "npc.guild_clerk.registered": "Nama tertulis, kartu dicap. Selamat datang di Serikat, petualang. Mintalah pekerjaan kapan pun kau butuh koin.",
    "npc.guild_clerk.not_yet": "Pemanggil belum selesai denganmu. Kembalilah setelah kau melakukan yang diminta.",
    "npc.guild_clerk.work": "Goblin turun ke bukit semak duri di timur ladang, dan para penenun membayar sutra laba-laba dari bukit yang sama.",
    "npc.guild_clerk.taken": "Sudah dicatat. Bawa buktinya dan kau akan dibayar.",
    "npc.guild_clerk.paid": "Dihitung dan dibayar. Kerja bagus.",
    "npc.guild_clerk.option.register": "Aku ingin mendaftar.",
    "npc.guild_clerk.option.not_yet": "Aku datang untuk mendaftar.",
    "npc.guild_clerk.option.work": "Adakah pekerjaan?",
    "npc.guild_clerk.option.take_goblins": "Aku akan menangani goblin.",
    "npc.guild_clerk.option.take_silk": "Aku akan membawa sutra laba-laba.",
    "npc.guild_clerk.option.ears": "Aku sudah membawa telinga goblin.",
    "npc.guild_clerk.option.silk": "Aku sudah membawa sutra laba-laba.",
    "npc.guild_clerk.option.back": "Yang lain.",
    "npc.guild_clerk.option.bye": "Sampai jumpa.",
    "npc.guide.option.sent": "Pemanggil yang menyuruhku.",
    "npc.guide.rats": "Tikus menggerogoti ladang di luar gerbang ini. Bawa tiga ekor untuk membuktikan kau bisa bertarung. Pedagang di pasar, di barat alun-alun, membeli barang jarahanmu.",
    // Alpha world NPCs.
    "npc.captain.name": "Kapten",
    "npc.captain.greeting": "Jaga bilahmu tetap siap di luar gerbang ini. Ladang tidak setenang kelihatannya.",
    "npc.captain.work": "Serigala di ladang, dan bandit di Whisperwood, di barat. Penjaga hutan di pondok mengenal hutan itu.",
    "npc.captain.taken": "Bagus. Laporkan kembali jika sudah selesai.",
    "npc.captain.paid": "Kota berutang padamu. Ini bayaranmu.",
    "npc.captain.option.work": "Ada pekerjaan untukku?",
    "npc.captain.option.pelts": "Aku sudah membawa kulit serigala.",
    "npc.captain.option.badges": "Aku sudah membawa lencana bandit.",
    "npc.captain.option.take_wolves": "Aku akan memburu serigala.",
    "npc.captain.option.take_patrol": "Aku akan mencari penjaga hutan.",
    "npc.captain.option.take_bandits": "Aku akan menangani bandit.",
    "npc.captain.option.back": "Yang lain.",
    "npc.captain.option.bye": "Sampai jumpa.",
    "npc.ranger.name": "Penjaga hutan",
    "npc.ranger.greeting": "Langkah yang pelan, orang asing. Hutan sedang mendengarkan.",
    "npc.ranger.forest": "Serigala mengerikan bersarang di selatan sini, dan bandit berkemah di balik mereka. Fenmoor terletak di luar ladang, di tenggara.",
    "npc.ranger.taken": "Bawa taring mereka dan aku akan membayar.",
    "npc.ranger.paid": "Serigala lebih sedikit, jalan lebih aman. Ambil ini.",
    "npc.ranger.option.patrol": "Kapten yang mengirimku.",
    "npc.ranger.option.forest": "Apa yang ada di hutan ini?",
    "npc.ranger.option.take_fangs": "Aku akan memburu serigala mengerikan.",
    "npc.ranger.option.fangs": "Aku sudah membawa taring mengerikan.",
    "npc.ranger.option.back": "Yang lain.",
    "npc.ranger.option.bye": "Sampai jumpa.",
    "npc.foreman.name": "Mandor",
    "npc.foreman.greeting": "Stonebrook menggali, Stonebrook membayar. Mencari pekerjaan?",
    "npc.foreman.work": "Tambang di utara kota penuh kelelawar dan kobold, dan sesuatu yang besar terbangun di ujung dalamnya.",
    "npc.foreman.taken": "Mulut tambang ada di jalan utara. Hati-hati dengan kepalamu.",
    "npc.foreman.paid": "Kerja adil, bayaran adil.",
    "npc.foreman.option.sent": "Serikat yang mengirimku.",
    "npc.foreman.option.work": "Ada pekerjaan di tambang?",
    "npc.foreman.option.wings": "Aku sudah membawa sayap kelelawar.",
    "npc.foreman.option.candles": "Aku sudah membawa lilin kobold.",
    "npc.foreman.option.core": "Aku sudah membawa inti golem.",
    "npc.foreman.option.take_wings": "Aku akan membersihkan kelelawar.",
    "npc.foreman.option.take_candles": "Aku akan mengusir kobold.",
    "npc.foreman.option.take_core": "Aku akan menghadapi golem.",
    "npc.foreman.option.back": "Yang lain.",
    "npc.foreman.option.bye": "Sampai jumpa.",
    "npc.quartermaster.name": "Quartermaster",
    "npc.fen_elder.name": "Tetua",
    "npc.fen_elder.greeting": "Hati-hati dengan papan jalannya. Rawa menyimpan apa pun yang jatuh ke dalamnya.",
    "npc.fen_elder.work": "Obat kami butuh kaki katak dan gel lendir, lentera kami butuh cahaya wisp, dan penyihir di pulau barat mengutuk kita semua.",
    "npc.fen_elder.taken": "Semoga papan-papan itu menahanmu.",
    "npc.fen_elder.paid": "Fenwick berterima kasih padamu.",
    "npc.fen_elder.option.letter": "Herbalis Aurelia menyampaikan salam.",
    "npc.fen_elder.option.work": "Bisakah aku membantu desa?",
    "npc.fen_elder.option.remedy": "Aku sudah membawa apa yang dibutuhkan obat.",
    "npc.fen_elder.option.charm": "Aku sudah membawa jimat penyihir.",
    "npc.fen_elder.option.essence": "Aku sudah membawa esensi wisp.",
    "npc.fen_elder.option.take_remedy": "Aku akan mengumpulkan untuk obat.",
    "npc.fen_elder.option.take_hag": "Aku akan menghadapi penyihir.",
    "npc.fen_elder.option.take_wisps": "Aku akan menangkap cahaya wisp.",
    "npc.fen_elder.option.back": "Yang lain.",
    "npc.fen_elder.option.bye": "Sampai jumpa.",
    "npc.fen_trader.name": "Pedagang",
    "npc.guild_clerk.option.take_stonebrook": "Aku akan pergi ke Stonebrook.",
    "npc.herbalist.option.letter": "Adakah yang perlu kubawakan?",
    "npc.herbalist.letter": "Ya! Sampaikan salamku pada tetua Fenwick, di rawa selatan ladang.",
}
