// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "Erste Schritte",
    "quest.first_steps.desc": "Sprich mit der Kräuterkundigen und bring dem Führer drei leuchtende Kräuter.",
    "quest.arrival.name": "Ankunft",
    "quest.arrival.desc": "Lerne vom Ausbilder, finde den Führer auf dem Feld, bring drei Rattenschwänze und melde dich bei der Gilde der Abenteurer.",
    "quest.goblin_trouble.name": "Ärger mit Goblins",
    "quest.goblin_trouble.desc": "Goblins sind in die Dornenhügel hinabgestiegen. Bring fünf Goblinohren zum Gildenschreiber.",
    "quest.spider_silk.name": "Spinnenseide",
    "quest.spider_silk.desc": "Die Weber von Aurelia zahlen für Seide. Bring vier Spinnenseiden aus den Dornenhügeln zum Gildenschreiber.",
    // Alpha world quests.
    "quest.wolf_cull.name": "Wölfe am Tor",
    "quest.wolf_cull.desc": "Wölfe streifen über die Felder südlich von Aurelia. Bring fünf Wolfsfelle zum Hauptmann am Südtor.",
    "quest.forest_patrol.name": "Patrouille nach Whisperwood",
    "quest.forest_patrol.desc": "Folge der Straße westlich aus Aurelia nach Whisperwood und melde dich beim Waldläufer der Hütte.",
    "quest.bandit_badges.name": "Banditenabzeichen",
    "quest.bandit_badges.desc": "Banditen lagern tief in Whisperwood. Bring sechs Banditenabzeichen zum Hauptmann.",
    "quest.dire_fangs.name": "Schreckensfänge",
    "quest.dire_fangs.desc": "Schreckenswölfe hausen südlich der Hütte. Bring vier Schreckensfänge zum Waldläufer.",
    "quest.road_to_stonebrook.name": "Der Weg nach Stonebrook",
    "quest.road_to_stonebrook.desc": "Nimm die Straße nach Osten durch die Dornenhügel bis Stonebrook und sprich mit dem Minenvorarbeiter.",
    "quest.bat_wings.name": "Fledermausflügel",
    "quest.bat_wings.desc": "Fledermäuse verseuchen die erste Höhle der Ironridge-Minen. Bring sechs Fledermausflügel zum Vorarbeiter.",
    "quest.kobold_candles.name": "Kobold-Kerzen",
    "quest.kobold_candles.desc": "Kobolde graben in der Osthöhle der Mine. Bring acht ihrer Kerzen zum Vorarbeiter.",
    "quest.heart_of_stone.name": "Herz aus Stein",
    "quest.heart_of_stone.desc": "Ein Felsgolem bewacht das tiefe Ende der Mine. Bring seinen Kern zum Vorarbeiter.",
    "quest.letter_to_fenwick.name": "Botschaft für Fenwick",
    "quest.letter_to_fenwick.desc": "Bring die Grüße der Kräuterkundigen südwärts über die Felder zur Ältesten von Fenwick im Fenmoor.",
    "quest.marsh_remedy.name": "Sumpfarznei",
    "quest.marsh_remedy.desc": "Die Älteste von Fenwick braucht fünf Froschschenkel und drei Schleimgele für die Dorfarznei.",
    "quest.hags_curse.name": "Der Fluch der Hexe",
    "quest.hags_curse.desc": "Eine Sumpfhexe verflucht Fenwick von ihrer Insel im Westen. Bring ihren Talisman zur Ältesten.",
    "quest.wisp_lights.name": "Irrlichter",
    "quest.wisp_lights.desc": "Die Älteste von Fenwick kauft Irrlichtessenz für die Dorflaternen. Bring drei.",
}
