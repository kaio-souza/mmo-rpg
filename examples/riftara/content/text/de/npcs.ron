// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "Führer",
    "npc.guide.greeting": "Willkommen, Neuankömmling. Der Kreis hat dich hergebracht, wie die anderen.",
    "npc.guide.where": "Dies ist das Südtor von Aurelia. Dahinter liegen die Felder, und weiter die Wälder, die Hügel und das Moor.",
    "npc.guide.system": "Das System spricht zu denen, die beschworen wurden. Hör zu, wenn es dir etwas zeigt.",
    "npc.guide.option.where": "Wo bin ich?",
    "npc.guide.option.system": "Was ist das System?",
    "npc.guide.option.back": "Ich habe eine andere Frage.",
    "npc.guide.option.bye": "Leb wohl.",
    "npc.guide.option.work": "Gibt es etwas, das ich tun kann?",
    "npc.guide.offer": "Besuch die Kräuterkundige im Marktviertel, westlich des Platzes, und bring mir drei leuchtende Kräuter. Ein Beweis, dass du deinen Weg findest.",
    "npc.guide.option.accept": "Ich mache es.",
    "npc.guide.accepted": "Gut. Die Kräuterkundige wird wissen, warum du gekommen bist.",
    "npc.guide.option.done": "Ich habe die Kräuter gebracht.",
    "npc.guide.thanks": "Gut gemacht. Nimm dieses Brot und etwas Geld für die Reise.",
    "npc.herbalist.name": "Kräuterkundige",
    "npc.herbalist.greeting": "Pass auf die Setzlinge auf. Was führt dich in meinen Garten?",
    "npc.herbalist.option.sent": "Der Führer hat mich wegen leuchtender Kräuter geschickt.",
    "npc.herbalist.gift": "Noch ein Neuankömmling. Hier, frisch gepflückt. Sag dem Führer, dass ich ihn grüße.",
    "npc.herbalist.option.bye": "Danke. Auf Wiedersehen.",
    "npc.merchant.name": "Händler",
    "npc.smith.name": "Schmied",
    "npc.smith.greeting": "Metall, Reparaturen oder ein Handwerk zum Lernen. Was davon?",
    "npc.smith.option.smelting": "Bring mir das Schmelzen von Erz bei. (100 Kupfer)",
    "npc.smith.option.sword": "Bring mir das Schmieden eines Schwertes bei. (1100 Kupfer)",
    "npc.smith.option.bye": "Ein andermal.",
    "npc.smith.taught": "Achte auf die Farbe des Metalls, nicht auf die Uhr. Es gehört jetzt dir.",
    "npc.smith.option.metals": "Über Metalle und Barren.",
    "npc.smith.option.learn_copper_ingot": "Bring mir den Kupferbarren bei. (50 Kupfer)",
    "npc.smith.option.learn_silver_ingot": "Bring mir den Silberbarren bei. (1000 Kupfer)",
    "npc.smith.option.melee": "Über Nahkampfwaffen.",
    "npc.smith.option.learn_iron_axe": "Bring mir die Eisenaxt bei. (1400 Kupfer)",
    "npc.smith.option.learn_iron_spear": "Bring mir den Eisenspeer bei. (1300 Kupfer)",
    "npc.smith.option.learn_stone_hammer": "Bring mir den Steinhammer bei. (850 Kupfer)",
    "npc.smith.option.learn_iron_hammer": "Bring mir den Eisenhammer bei. (1550 Kupfer)",
    "npc.smith.option.ranged": "Über Bögen und Stäbe.",
    "npc.smith.option.learn_wooden_bow": "Bring mir den Holzbogen bei. (700 Kupfer)",
    "npc.smith.option.learn_iron_bow": "Bring mir den Eisenbogen bei. (1350 Kupfer)",
    "npc.smith.option.learn_oak_staff": "Bring mir den Eichenstab bei. (800 Kupfer)",
    "npc.smith.option.learn_iron_staff": "Bring mir den Eisenstab bei. (1450 Kupfer)",
    "npc.smith.option.armor": "Über Rüstungen.",
    "npc.smith.option.learn_cloth_tunic": "Bring mir die Stofftunika bei. (550 Kupfer)",
    "npc.smith.option.learn_studded_leather": "Bring mir das Nietenleder bei. (1000 Kupfer)",
    "npc.smith.option.learn_iron_chainmail": "Bring mir das Eisenkettenhemd bei. (1200 Kupfer)",
    "npc.smith.option.learn_iron_plate_armor": "Bring mir die Eisenplattenrüstung bei. (2300 Kupfer)",
    "npc.smith.lessons": "Welches Handwerk möchtest du lernen?",
    "npc.smith.option.back": "Etwas anderes.",
    "npc.herbalist.option.lessons": "Kannst du mir Tränke beibringen?",
    "npc.herbalist.lessons": "Wurzeln und Blüten können einen Körper heilen oder stärken. Welcher Trank?",
    "npc.herbalist.taught": "Achte auf Hitze und Maß. Es gehört jetzt dir.",
    "npc.herbalist.option.back": "Etwas anderes.",
    "npc.herbalist.option.learn_minor_health_potion": "Bring mir den kleinen Heiltrank bei. (200 Kupfer)",
    "npc.herbalist.option.learn_vigor_elixir": "Bring mir das Kraftelixier bei. (300 Kupfer)",
    "npc.herbalist.option.learn_mana_tonic": "Bring mir das Manatonikum bei. (300 Kupfer)",
    "npc.herbalist.option.learn_minor_heal": "Bring mir bei, mit Licht zu heilen. (300 Kupfer)",
    "npc.herbalist.option.learn_revival_draught": "Bring mir den Wiederbelebungstrank bei. (500 Kupfer)",
    "npc.herbalist.option.learn_health_potion": "Bring mir den Heiltrank bei. (500 Kupfer)",
    "npc.herbalist.option.learn_greater_vigor_elixir": "Bring mir das große Kraftelixier bei. (800 Kupfer)",
    "npc.herbalist.option.learn_greater_health_potion": "Bring mir den großen Heiltrank bei. (1000 Kupfer)",
    "npc.summoner.name": "Beschwörer",
    "npc.summoner.greeting": "Du bist wach. Atme. Der Kreis hat dich aus deiner Welt in unsere geholt, wie die anderen.",
    "npc.summoner.what": "Aurelia rief um Hilfe, und der Kreis antwortete mit dir. Niemand kann dich zurückschicken. Hier aber kannst du stark werden.",
    "npc.summoner.system": "Das System ist die Stimme, die die Beschworenen hören. Es zählt deine Taten und vergibt Titel. Einer gehört dir schon.",
    "npc.summoner.offer": "Lerne zuerst, auf den Beinen zu stehen. Geh zum Ausbilder im Hof im Osten, dann zum Führer auf dem Feld südlich des Tors. Wenn du bereit bist, wird dich die Gilde registrieren.",
    "npc.summoner.accepted": "Geh. Die Markierungen über den Leuten, die du sehen musst, werden dich führen.",
    "npc.summoner.next": "Der Ausbilder im Hof im Osten, der Führer auf dem Feld südlich des Tors, drei Rattenschwänze, dann das Gildenhaus im Nordwesten.",
    "npc.summoner.option.what": "Was ist mit mir passiert?",
    "npc.summoner.option.system": "Was ist diese Stimme in meinem Kopf?",
    "npc.summoner.option.begin": "Was soll ich jetzt tun?",
    "npc.summoner.option.next": "Wohin gehe ich als Nächstes?",
    "npc.summoner.option.accept": "Ich bin bereit.",
    "npc.summoner.option.back": "Ich habe eine andere Frage.",
    "npc.summoner.option.bye": "Später.",
    "npc.instructor.name": "Ausbilder",
    "npc.instructor.greeting": "Noch einer aus dem Kreis. Fäuste hoch. Niemand verlässt meinen Hof, ohne treten zu können.",
    "npc.instructor.taught": "Das ist ein Tritt. Zieh ihn aus dem Technikfenster auf die Leiste unten und drück im Kampf seine Nummer.",
    "npc.instructor.fight": "Klick eine Kreatur an, um sie anzugreifen; du schlägst dann von selbst weiter. Wenn dich etwas trifft, schlägst du zurück. Behalte dein Leben im Auge und zieh dich zurück, wenn es sinkt.",
    "npc.instructor.option.teach": "Bring mir das Kämpfen bei.",
    "npc.instructor.option.fight": "Wie läuft ein Kampf ab?",
    "npc.instructor.option.back": "Etwas anderes.",
    "npc.instructor.option.bye": "Danke.",
    "npc.guild_clerk.name": "Gildenschreiber",
    "npc.guild_clerk.greeting": "Gilde der Abenteurer von Aurelia. Registrierung, Arbeit und Bezahlung, in dieser Reihenfolge.",
    "npc.guild_clerk.registered": "Name eingetragen, Karte gestempelt. Willkommen in der Gilde, Abenteurer. Frag mich nach Arbeit, wann immer du Geld brauchst.",
    "npc.guild_clerk.not_yet": "Der Beschwörer ist noch nicht fertig mit dir. Komm zurück, wenn du erledigt hast, was verlangt wurde.",
    "npc.guild_clerk.work": "Goblins sind in die Dornenhügel östlich des Feldes hinabgestiegen, und die Weber zahlen für Spinnenseide aus denselben Hügeln.",
    "npc.guild_clerk.taken": "Notiert. Bring den Beweis, dann wirst du bezahlt.",
    "npc.guild_clerk.paid": "Gezählt und bezahlt. Gute Arbeit.",
    "npc.guild_clerk.option.register": "Ich möchte mich registrieren.",
    "npc.guild_clerk.option.not_yet": "Ich bin gekommen, um mich zu registrieren.",
    "npc.guild_clerk.option.work": "Gibt es Arbeit?",
    "npc.guild_clerk.option.take_goblins": "Ich kümmere mich um die Goblins.",
    "npc.guild_clerk.option.take_silk": "Ich bringe Spinnenseide.",
    "npc.guild_clerk.option.ears": "Ich habe Goblinohren gebracht.",
    "npc.guild_clerk.option.silk": "Ich habe Spinnenseide gebracht.",
    "npc.guild_clerk.option.back": "Etwas anderes.",
    "npc.guild_clerk.option.bye": "Auf Wiedersehen.",
    "npc.guide.option.sent": "Der Beschwörer hat mich geschickt.",
    "npc.guide.rats": "Ratten nagen an den Feldern vor diesem Tor. Bring drei Schwänze, um zu zeigen, dass du kämpfen kannst. Der Händler auf dem Markt, westlich des Platzes, kauft, was du erbeutest.",
    // Alpha world NPCs.
    "npc.captain.name": "Hauptmann",
    "npc.captain.greeting": "Halte deine Klinge bereit hinter diesem Tor. Die Felder sind nicht so ruhig, wie sie aussehen.",
    "npc.captain.work": "Wölfe auf den Feldern und Banditen in Whisperwood, im Westen. Der Waldläufer der Hütte kennt den Wald.",
    "npc.captain.taken": "Gut. Berichte zurück, wenn es erledigt ist.",
    "npc.captain.paid": "Die Stadt steht in deiner Schuld. Hier ist dein Lohn.",
    "npc.captain.option.work": "Hast du Arbeit für mich?",
    "npc.captain.option.pelts": "Ich habe die Wolfsfelle gebracht.",
    "npc.captain.option.badges": "Ich habe die Banditenabzeichen gebracht.",
    "npc.captain.option.take_wolves": "Ich jage die Wölfe.",
    "npc.captain.option.take_patrol": "Ich finde den Waldläufer.",
    "npc.captain.option.take_bandits": "Ich kümmere mich um die Banditen.",
    "npc.captain.option.back": "Etwas anderes.",
    "npc.captain.option.bye": "Leb wohl.",
    "npc.ranger.name": "Waldläufer",
    "npc.ranger.greeting": "Leise Schritte, Fremder. Der Wald lauscht.",
    "npc.ranger.forest": "Schreckenswölfe hausen südlich von hier, und die Banditen lagern dahinter. Fenmoor liegt jenseits der Felder im Südosten.",
    "npc.ranger.taken": "Bring mir ihre Fänge, dann bezahle ich.",
    "npc.ranger.paid": "Weniger Wölfe, sicherere Straßen. Nimm das.",
    "npc.ranger.option.patrol": "Der Hauptmann hat mich geschickt.",
    "npc.ranger.option.forest": "Was lebt in diesen Wäldern?",
    "npc.ranger.option.take_fangs": "Ich jage die Schreckenswölfe.",
    "npc.ranger.option.fangs": "Ich habe Schreckensfänge gebracht.",
    "npc.ranger.option.back": "Etwas anderes.",
    "npc.ranger.option.bye": "Leb wohl.",
    "npc.foreman.name": "Vorarbeiter",
    "npc.foreman.greeting": "Stonebrook gräbt, Stonebrook zahlt. Suchst du Arbeit?",
    "npc.foreman.work": "Die Minen nördlich der Stadt wimmeln von Fledermäusen und Kobolden, und tief unten ist etwas Großes erwacht.",
    "npc.foreman.taken": "Der Minenzugang liegt an der Straße nach Norden. Pass auf deinen Kopf auf.",
    "npc.foreman.paid": "Faire Arbeit, fairer Lohn.",
    "npc.foreman.option.sent": "Die Gilde hat mich geschickt.",
    "npc.foreman.option.work": "Gibt es Arbeit in den Minen?",
    "npc.foreman.option.wings": "Ich habe Fledermausflügel gebracht.",
    "npc.foreman.option.candles": "Ich habe Kobold-Kerzen gebracht.",
    "npc.foreman.option.core": "Ich habe den Golemkern gebracht.",
    "npc.foreman.option.take_wings": "Ich räume die Fledermäuse weg.",
    "npc.foreman.option.take_candles": "Ich vertreibe die Kobolde.",
    "npc.foreman.option.take_core": "Ich stelle mich dem Golem.",
    "npc.foreman.option.back": "Etwas anderes.",
    "npc.foreman.option.bye": "Leb wohl.",
    "npc.quartermaster.name": "Quartiermeister",
    "npc.fen_elder.name": "Älteste",
    "npc.fen_elder.greeting": "Pass auf die Holzstege auf. Das Moor behält, was hineinfällt.",
    "npc.fen_elder.work": "Unsere Arznei braucht Froschschenkel und Schleimgel, unsere Laternen brauchen Irrlichtlicht, und die Hexe auf der Westinsel verflucht uns alle.",
    "npc.fen_elder.taken": "Mögen die Bretter dich tragen.",
    "npc.fen_elder.paid": "Fenwick dankt dir.",
    "npc.fen_elder.option.letter": "Die Kräuterkundige von Aurelia lässt grüßen.",
    "npc.fen_elder.option.work": "Kann ich dem Dorf helfen?",
    "npc.fen_elder.option.remedy": "Ich habe gebracht, was die Arznei braucht.",
    "npc.fen_elder.option.charm": "Ich habe den Talisman der Hexe gebracht.",
    "npc.fen_elder.option.essence": "Ich habe Irrlichtessenz gebracht.",
    "npc.fen_elder.option.take_remedy": "Ich sammle für die Arznei.",
    "npc.fen_elder.option.take_hag": "Ich stelle mich der Hexe.",
    "npc.fen_elder.option.take_wisps": "Ich fange das Licht der Irrlichter.",
    "npc.fen_elder.option.back": "Etwas anderes.",
    "npc.fen_elder.option.bye": "Leb wohl.",
    "npc.fen_trader.name": "Händlerin",
    "npc.guild_clerk.option.take_stonebrook": "Ich gehe nach Stonebrook.",
    "npc.herbalist.option.letter": "Soll ich etwas überbringen?",
    "npc.herbalist.letter": "Ja! Richte der Ältesten von Fenwick meine Grüße aus, im Moor südlich der Felder.",
}
