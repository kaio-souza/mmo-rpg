{
    "item.glow_herb.name": "Leuchtkraut",
    "item.glow_herb.desc": "Ein Kraut, das in der Dämmerung schwach leuchtet. Der Führer hat danach gefragt.",
    "item.travel_bread.name": "Reisebrot",
    "item.travel_bread.desc": "Dichtes Brot, das wochenlang hält.",
