    "item.bandit_badge.name": "Banditenabzeichen",
    "item.bandit_badge.desc": "Ein grobes Kupferabzeichen der Banditen von Whisperwood. Der Hauptmann zahlt als Beweis.",
    "item.dire_fang.name": "Schreckensfang",
    "item.dire_fang.desc": "Ein langer gelber Fang. Der Waldläufer sammelt sie.",
