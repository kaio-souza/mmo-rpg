    "item.rat_tail.name": "Rattenschwanz",
    "item.rat_tail.desc": "Lang, kahl und kaum etwas wert.",
    "item.spider_silk.name": "Spinnenseide",
    "item.spider_silk.desc": "Ein klebriges Bündel starker grauer Fäden.",
    "item.goblin_ear.name": "Goblinohr",
    "item.goblin_ear.desc": "Spitz und grün. Die Gilde zahlt als Beweis.",
    "item.guild_card.name": "Gildenkarte",
    "item.guild_card.desc": "Dein Name, gestempelt von der Gilde der Abenteurer von Aurelia.",
