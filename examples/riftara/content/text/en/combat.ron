// Texts of combat and progression (phase 4): System messages, monsters, proficiencies, techniques, classes, titles.
{
    "system.level_up": (text: "Level up! You are now level {level}.", note: "Level up. {level} is the new level.", max_chars: 60),
    "system.level_lost": (text: "Your soul weakens: you drop to level {level}.", note: "Death cost a level. {level} is the level now.", max_chars: 70),
    "system.points": (text: "Attribute points gained: {count}.", note: "Free attribute points gained; {count} is how many.", max_chars: 60),
    "system.proficiency_up": (text: "{name} rose to {value}.", note: "A proficiency rose. {name}: proficiency name; {value}: new value.", max_chars: 60),
    "system.technique_unlocked": (text: "New technique: {name}.", note: "A new technique learned. {name}: technique name.", max_chars: 60),
    "system.technique_up": (text: "{name} reached level {level}.", note: "A technique rose. {name}: technique; {level}: its level.", max_chars: 60),
    "system.title": (text: "Title earned: {name}.", note: "A title earned. {name}: title name.", max_chars: 60),
    "system.title_replaced": (text: "{old} became {new}.", note: "A title replaced by a higher one, which takes its place. {old}: title lost; {new}: title earned.", max_chars: 60),
    "system.classes_available": (text: "The System offers you a class ({count} available).", note: "The System offers classes; {count}: how many.", max_chars: 70),
    "system.class_chosen": (text: "You are now a {name}.", note: "A class chosen. {name}: class name.", max_chars: 60),
    "system.xp": (text: "+{amount} XP", note: "Experience from a kill; {amount}: points.", max_chars: 40),
    "system.fallen": (text: "You have fallen. Help has {seconds} s to reach you.", note: "HP reached zero; {seconds}: wait for help before death.", max_chars: 90),
    "system.revived_by": (text: "{name} stands you up. You are back on your feet.", note: "A player used a revival item on this fallen player; {name}: who.", max_chars: 90),
    "system.revive_done": (text: "You stand {name} up.", note: "This player revived a fallen one; {name}: who.", max_chars: 60),
    "system.healed_by": (text: "{name} heals you: +{hp} HP.", note: "Another player healed this one; {name}: who; {hp}: life restored.", max_chars: 60),
    "system.died": (text: "You died. Your soul rests for {hours} h.", note: "Death for real; {hours}: hours the character must rest.", max_chars: 100),
    "system.revived": (text: "You wake up at the sanctuary, unharmed.", note: "Newbie protection: back at the sanctuary without loss.", max_chars: 80),
    "system.appraised": (text: "You see through the {item}.", note: "Appraisal worked; {item}: item name.", max_chars: 60),
    "system.appraise_failed": (text: "The {item} keeps its secrets. Try again after leveling.", note: "Appraisal failed; can be tried again after leveling. {item}: item name.", max_chars: 80),
    "loot.item": (text: "Loot: {item} ×{count}", note: "Loot picked up. {item}: item name; {count}: how many.", max_chars: 60),
    "loot.full": (text: "No room for {item} ×{count}: it is left behind.", note: "Loot lost: the backpack is full. {item}: name; {count}: how many.", max_chars: 80),
    "monster.wolf.name": (text: "Wolf", note: "Monster name.", max_chars: 30),
    "monster.boar.name": (text: "Boar", note: "Monster name.", max_chars: 30),
    "monster.old_wolf.name": (text: "Old wolf", note: "Monster name.", max_chars: 30),
    "monster.bandit.name": (text: "Bandit", note: "Monster name.", max_chars: 30),
    "proficiency.unarmed.name": (text: "Unarmed", note: "Proficiency name.", max_chars: 30),
    "proficiency.sword.name": (text: "Sword", note: "Proficiency name.", max_chars: 30),
    "proficiency.dagger.name": (text: "Dagger", note: "Proficiency name.", max_chars: 30),
    "technique.double_cut.name": (text: "Double cut", note: "Technique name.", max_chars: 30),
    "technique.double_cut.desc": (text: "Two quick cuts in one swing.", note: "Technique description.", max_chars: 120),
    "technique.quick_stab.name": (text: "Quick stab", note: "Technique name.", max_chars: 30),
    "technique.quick_stab.desc": (text: "A fast thrust at a weak spot.", note: "Technique description.", max_chars: 120),
    "technique.heavy_punch.name": (text: "Heavy punch", note: "Technique name.", max_chars: 30),
    "technique.heavy_punch.desc": (text: "A punch with the whole body behind it.", note: "Technique description.", max_chars: 120),
    "class.warrior.name": (text: "Warrior", note: "Class name.", max_chars: 30),
    "class.warrior.desc": (text: "Close combat with blades and shields.", note: "Class description.", max_chars: 120),
    "class.scout.name": (text: "Scout", note: "Class name.", max_chars: 30),
    "class.scout.desc": (text: "Agility, daggers and keen eyes.", note: "Class description.", max_chars: 120),
    "class.knight.name": (text: "Knight", note: "Class name.", max_chars: 30),
    "class.knight.desc": (text: "A warrior who stands in front of the others.", note: "Class description.", max_chars: 120),
    "class.berserker.name": (text: "Berserker", note: "Class name.", max_chars: 30),
    "class.berserker.desc": (text: "Raw damage, less caution.", note: "Class description.", max_chars: 120),
    "class.assassin.name": (text: "Assassin", note: "Class name.", max_chars: 30),
    "class.assassin.desc": (text: "Strikes first, from where no one looks.", note: "Class description.", max_chars: 120),
    "title.first_blood.name": (text: "First blood", note: "Title name.", max_chars: 30),
    "title.first_blood.desc": (text: "Defeated a creature for the first time.", note: "Title description.", max_chars: 120),
    "title.wolf_hunter.name": (text: "Wolf hunter", note: "Title name.", max_chars: 30),
    "title.wolf_hunter.desc": (text: "Ten wolves will not howl again.", note: "Title description.", max_chars: 120),
    "title.seasoned.name": (text: "Seasoned", note: "Title name.", max_chars: 30),
    "title.seasoned.desc": (text: "Reached level 10.", note: "Title description.", max_chars: 120),
    "system.item_used": (text: "{item}: +{hp} HP, +{vigor} Vigor.", note: "A consumable was used; {item}: item name; {hp}: HP restored; {vigor}: vigor restored.", max_chars: 80),
    "system.item_used_mp": (text: "{item}: +{mp} MP.", note: "A consumable restoring only MP was used; {item}: item name; {mp}: MP restored.", max_chars: 80),
    "title.godspeed.name": (text: "Godspeed", note: "Title name.", max_chars: 30),
    "title.godspeed.desc": (text: "Reached 100 Agility.", note: "Title description.", max_chars: 120),
    "system.bought": (text: "Bought {item} x{qty} for {coins} copper.", note: "A purchase at an NPC shop; {item}: item name; {qty}: pieces; {coins}: copper paid.", max_chars: 90),
    "system.sold": (text: "Sold {item} x{qty} for {coins} copper.", note: "A sale to an NPC shop; {item}: item name; {qty}: pieces; {coins}: copper received.", max_chars: 90),
    "system.repaired": (text: "{item} repaired for {coins} copper.", note: "A repair at an NPC; {item}: item name; {coins}: copper paid.", max_chars: 90),
    "system.party_joined": (text: "{name} joined the group.", note: "Told to the group; {name}: who joined.", max_chars: 60),
    "system.party_left": (text: "{name} left the group.", note: "Told to the group; {name}: who left or was removed.", max_chars: 60),
    "system.trade_done": (text: "Trade completed.", note: "Both players confirmed and the items changed hands.", max_chars: 40),
    "system.trade_cancelled": (text: "Trade cancelled.", note: "The trade ended: cancelled, too far, in a fight, or someone left.", max_chars: 40),
    "system.trade_expired": (text: "The trade expired.", note: "Nobody touched the trade for 30 seconds.", max_chars: 40),
    "system.escrow_sent": (text: "Sent. It is kept in custody until the recipient enters the game.", note: "A deposit into custody was written; the recipient gets it on entering.", max_chars: 80),
    "system.escrow_returned": (text: "Sending refused: everything is back in your backpack.", note: "Custody refused the deposit (unknown recipient or a database error); nothing was lost.", max_chars: 80),
    "system.escrow_received": (text: "What was kept for you has arrived.", note: "A parcel waiting in custody was put in the backpack on entering.", max_chars: 60),
    "system.escrow_no_room": (text: "Items are kept for you, but your backpack is full.", note: "A parcel in custody did not fit; it stays there for the next entry.", max_chars: 80),
    "system.crafted": (text: "Made {item} x{qty}.", note: "A craft finished; {item}: item name; {qty}: pieces made.", max_chars: 80),
    "system.craft_needs_workshop": (text: "Only a production class crafts anywhere. Go to a workshop: a forge or a workbench.", note: "Crafting refused outside a workshop for a character without a production class.", max_chars: 110),
    "system.appraise_class_only": (text: "Only a production class can appraise. A smith appraises for a fee.", note: "Appraisal refused: the character has no production class; NPC smiths appraise for coins.", max_chars: 100),
    "system.appraised_paid": (text: "{item} appraised for {coins} copper.", note: "An appraisal paid at an NPC shop; {item}: item name; {coins}: copper paid.", max_chars: 90),
    "system.shop_purse_empty": (text: "The merchant can only pay {coins} more copper. Come back in {minutes} min or sell in another town.", note: "A sale refused: the shop's purse for this player is spent; {coins}: copper it still pays; {minutes}: minutes until it refills.", max_chars: 120),
    "system.item_broken": (text: "{item} broke beyond repair.", note: "An equipped piece reached zero durability and was destroyed; {item}: item name.", max_chars: 90),
    "system.durability_low": (text: "{item} is at {percent}% durability.", note: "Warning while equipment wears out; {item}: item name; {percent}: durability left, in percent.", max_chars: 90),
    "class.artisan.name": (text: "Artisan", note: "Class name: the first production class.", max_chars: 30),
    "class.artisan.desc": (text: "Works metal and stone. Crafting gives real experience and may come out Rare.", note: "Class description.", max_chars: 160),
    "proficiency.mining.name": (text: "Mining", note: "Proficiency name: gathering ore from veins.", max_chars: 30),
    "proficiency.smithing.name": (text: "Smithing", note: "Proficiency name: forging metal.", max_chars: 30),
    "recipe.iron_ingot.name": (text: "Iron ingot", note: "Recipe name, shown in the crafting window.", max_chars: 40),
    "recipe.iron_ingot.desc": (text: "Smelts two ores into one ingot.", note: "Recipe description.", max_chars: 160),
    "recipe.iron_sword.name": (text: "Iron sword", note: "Recipe name, shown in the crafting window.", max_chars: 40),
    "recipe.iron_sword.desc": (text: "Forges three ingots into a sword. Needs some smithing.", note: "Recipe description.", max_chars: 160),
    "node.iron_vein.name": (text: "Iron vein", note: "Name of a gathering node, shown over it.", max_chars: 40),
    "monster.field_rat.name": (text: "Field rat", note: "Monster name.", max_chars: 30),
    "monster.briar_spider.name": (text: "Briar spider", note: "Monster name.", max_chars: 30),
    "monster.hill_goblin.name": (text: "Hill goblin", note: "Monster name.", max_chars: 30),
    "monster.goblin_shaman.name": (text: "Goblin shaman", note: "Monster name.", max_chars: 30),
    "title.otherworlder.name": (text: "Otherworlder", note: "Title name: the one who came from another world (every summoned player).", max_chars: 30),
    "title.otherworlder.desc": (text: "Came from another world through the circle. +5% XP up to level 10.", note: "Title description; the bonus is real (+5% experience until level 10).", max_chars: 120),
    // Alpha world monsters, nodes and Herbalism.
    "monster.goblin_brute.name": (text: "Goblin brute", note: "Monster name.", max_chars: 30),
    "monster.dire_wolf.name": (text: "Dire wolf", note: "Monster name.", max_chars: 30),
    "monster.bandit_scout.name": (text: "Bandit scout", note: "Monster name.", max_chars: 30),
    "monster.bog_frog.name": (text: "Bog frog", note: "Monster name.", max_chars: 30),
    "monster.marsh_slime.name": (text: "Marsh slime", note: "Monster name.", max_chars: 30),
    "monster.fen_wisp.name": (text: "Fen wisp", note: "Monster name.", max_chars: 30),
    "monster.swamp_hag.name": (text: "Swamp hag", note: "Monster name.", max_chars: 30),
    "monster.cave_bat.name": (text: "Cave bat", note: "Monster name.", max_chars: 30),
    "monster.kobold_miner.name": (text: "Kobold miner", note: "Monster name.", max_chars: 30),
    "monster.cave_spider.name": (text: "Cave spider", note: "Monster name.", max_chars: 30),
    "monster.kobold_foreman.name": (text: "Kobold foreman", note: "Monster name.", max_chars: 30),
    "monster.rock_golem.name": (text: "Rock golem", note: "Monster name.", max_chars: 30),
    "node.copper_vein.name": (text: "Copper vein", note: "Name of a gathering node, shown over it.", max_chars: 40),
    "node.silver_vein.name": (text: "Silver vein", note: "Name of a gathering node, shown over it.", max_chars: 40),
    "node.herb_patch.name": (text: "Herb patch", note: "Name of a gathering node, shown over it (herbs for alchemy).", max_chars: 40),
    "proficiency.herbalism.name": (text: "Herbalism", note: "Proficiency name: gathering herbs from herb patches.", max_chars: 30),
    "system.not_enough_coins": (text: "Not enough coins: it costs {price} copper and you have {coins}.", note: "Buying, repairing or appraising refused for lack of coins; {price}: cost; {coins}: what the player holds.", max_chars: 100),
    "system.craft_unknown": (text: "You do not know that recipe yet. An NPC teaches it.", note: "Crafting refused: recipe not learned.", max_chars: 90),
    "system.craft_points": (text: "You need {proficiency} {points} to make that.", note: "Crafting refused: proficiency too low; {proficiency}: name; {points}: points needed.", max_chars: 90),
    "system.craft_material": (text: "Missing {item}: it needs {need} and you carry {have}. Worn or equipped pieces do not count.", note: "Crafting refused: a material is short; {item}: material; {need}: needed; {have}: in the backpack.", max_chars: 120),
    "system.craft_busy": (text: "The workbench is getting ready. Try again in a moment.", note: "Crafting refused for a moment: the zone is fetching item ids.", max_chars: 90),
    "system.self_repair_class_only": (text: "Only a production class mends its own pieces. Others pay a smith.", note: "Self repair refused: not a production class.", max_chars: 100),
    "system.self_repair_no_recipe": (text: "{item} has no recipe: only a smith can mend it.", note: "Self repair refused: nothing crafts that item; {item}: item name.", max_chars: 90),
    "system.self_repair_points": (text: "You need {proficiency} {points} to mend that.", note: "Self repair refused: proficiency below the recipe's.", max_chars: 90),
    "system.self_repair_material": (text: "Mending needs {need} {material}; you carry {have}.", note: "Self repair refused for lack of the material; {material}: name; {need}: needed; {have}: held.", max_chars: 90),
    "system.self_repaired": (text: "{item} mended with {qty} {material}.", note: "Self repair done; {item}: item; {qty}: how many; {material}: material name.", max_chars: 90),
    "system.vow_taken": (text: "{technique}: your defense rises for {seconds} s.", note: "A buff technique was used; {technique}: its name; {seconds}: how long.", max_chars: 90),
}
