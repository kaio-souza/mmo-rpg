// Texts of quests (content/quests/).
{
    "quest.first_steps.name": (text: "First steps", note: "Quest name in the quest log.", max_chars: 40),
    "quest.first_steps.desc": (text: "Talk to the herbalist and bring three glowing herbs to the guide.", note: "Quest description in the quest log.", max_chars: 160),
    "quest.arrival.name": (text: "Arrival", note: "Name of the tutorial quest of a summoned player.", max_chars: 40),
    "quest.arrival.desc": (text: "Learn from the instructor, find the guide on the field, bring three rat tails and register at the Adventurers' Guild.", note: "Tutorial quest description.", max_chars: 200),
    "quest.goblin_trouble.name": (text: "Goblin trouble", note: "Quest name in the quest log.", max_chars: 40),
    "quest.goblin_trouble.desc": (text: "Goblins came down to the briar hills. Bring five goblin ears to the guild clerk.", note: "Quest description.", max_chars: 160),
    "quest.spider_silk.name": (text: "Spider silk", note: "Quest name in the quest log (repeatable).", max_chars: 40),
    "quest.spider_silk.desc": (text: "The weavers of Aurelia pay for silk. Bring four spider silks from the briar hills to the guild clerk.", note: "Quest description.", max_chars: 160),
    // Alpha world quests.
    "quest.wolf_cull.name": (text: "Wolves at the gate", note: "Quest name in the quest log.", max_chars: 40),
    "quest.wolf_cull.desc": (text: "Wolves prowl the fields south of Aurelia. Bring five wolf pelts to the captain at the south gate.", note: "Quest description.", max_chars: 160),
    "quest.forest_patrol.name": (text: "Patrol to Whisperwood", note: "Quest name in the quest log.", max_chars: 40),
    "quest.forest_patrol.desc": (text: "Follow the road west out of Aurelia into Whisperwood and report to the ranger at the lodge.", note: "Quest description.", max_chars: 160),
    "quest.bandit_badges.name": (text: "Bandit badges", note: "Quest name in the quest log.", max_chars: 40),
    "quest.bandit_badges.desc": (text: "Bandits camp deep in Whisperwood. Bring six bandit badges to the captain.", note: "Quest description.", max_chars: 160),
    "quest.dire_fangs.name": (text: "Dire fangs", note: "Quest name in the quest log.", max_chars: 40),
    "quest.dire_fangs.desc": (text: "Dire wolves den south of the lodge. Bring four dire fangs to the ranger.", note: "Quest description.", max_chars: 160),
    "quest.road_to_stonebrook.name": (text: "The road to Stonebrook", note: "Quest name in the quest log.", max_chars: 40),
    "quest.road_to_stonebrook.desc": (text: "Take the road east through the briar hills to Stonebrook and speak with the mine foreman.", note: "Quest description.", max_chars: 160),
    "quest.bat_wings.name": (text: "Bat wings", note: "Quest name in the quest log.", max_chars: 40),
    "quest.bat_wings.desc": (text: "Bats foul the first cavern of the Ironridge mines. Bring six bat wings to the foreman.", note: "Quest description.", max_chars: 160),
    "quest.kobold_candles.name": (text: "Kobold candles", note: "Quest name in the quest log.", max_chars: 40),
    "quest.kobold_candles.desc": (text: "Kobolds dig in the east cavern of the mines. Bring eight of their candles to the foreman.", note: "Quest description.", max_chars: 160),
    "quest.heart_of_stone.name": (text: "Heart of stone", note: "Quest name in the quest log.", max_chars: 40),
    "quest.heart_of_stone.desc": (text: "A rock golem guards the deep end of the mines. Bring its core to the foreman.", note: "Quest description.", max_chars: 160),
    "quest.letter_to_fenwick.name": (text: "Word for Fenwick", note: "Quest name in the quest log.", max_chars: 40),
    "quest.letter_to_fenwick.desc": (text: "Carry the herbalist's greetings south through the fields to the elder of Fenwick in Fenmoor.", note: "Quest description.", max_chars: 160),
    "quest.marsh_remedy.name": (text: "Marsh remedy", note: "Quest name in the quest log.", max_chars: 40),
    "quest.marsh_remedy.desc": (text: "The elder of Fenwick needs five frog legs and three slime gels for the village remedy.", note: "Quest description.", max_chars: 160),
    "quest.hags_curse.name": (text: "The hag's curse", note: "Quest name in the quest log.", max_chars: 40),
    "quest.hags_curse.desc": (text: "A swamp hag curses Fenwick from her island in the west. Bring her charm to the elder.", note: "Quest description.", max_chars: 160),
    "quest.wisp_lights.name": (text: "Wisp lights", note: "Quest name in the quest log.", max_chars: 40),
    "quest.wisp_lights.desc": (text: "The elder of Fenwick buys wisp essence for the village lamps. Bring three.", note: "Quest description.", max_chars: 160),
}
