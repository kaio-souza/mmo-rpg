// Texts of items (content/items/).
{
    "item.glow_herb.name": (text: "Glowing herb", note: "Item name (quest item).", max_chars: 40),
    "item.glow_herb.desc": (text: "A herb that glows faintly at dusk. The guide asked for it.", note: "Item description.", max_chars: 160),
    "item.travel_bread.name": (text: "Travel bread", note: "Item name (food).", max_chars: 40),
    "item.travel_bread.desc": (text: "Dense bread that keeps for weeks.", note: "Item description.", max_chars: 160),
    "item.rusty_sword.name": (text: "Rusty sword", note: "Item name.", max_chars: 40),
    "item.rusty_sword.desc": (text: "Old, but still cuts. Something about it is worth a closer look.", note: "Item description.", max_chars: 160),
    "item.hunting_knife.name": (text: "Hunting knife", note: "Item name.", max_chars: 40),
    "item.hunting_knife.desc": (text: "Light and quick in a steady hand.", note: "Item description.", max_chars: 160),
    "item.leather_armor.name": (text: "Leather armor", note: "Item name.", max_chars: 40),
    "item.leather_armor.desc": (text: "Stiff leather that turns a bite or two.", note: "Item description.", max_chars: 160),
    "item.wolf_pelt.name": (text: "Wolf pelt", note: "Item name.", max_chars: 40),
    "item.wolf_pelt.desc": (text: "Thick grey fur. Tanners pay for it.", note: "Item description.", max_chars: 160),
    "item.boar_tusk.name": (text: "Boar tusk", note: "Item name.", max_chars: 40),
    "item.boar_tusk.desc": (text: "Curved and sharp. Useful to craftsmen.", note: "Item description.", max_chars: 160),
    "item.iron_ore.name": (text: "Iron ore", note: "Item name.", max_chars: 40),
    "item.iron_ore.desc": (text: "Raw ore. Two of them smelt into one ingot.", note: "Item description.", max_chars: 160),
    "item.iron_ingot.name": (text: "Iron ingot", note: "Item name.", max_chars: 40),
    "item.iron_ingot.desc": (text: "Clean metal, ready for the anvil.", note: "Item description.", max_chars: 160),
    "item.iron_sword.name": (text: "Iron sword", note: "Item name.", max_chars: 40),
    "item.iron_sword.desc": (text: "Forged, balanced and worth repairing.", note: "Item description.", max_chars: 160),
    "item.rat_tail.name": (text: "Rat tail", note: "Item name (material).", max_chars: 40),
    "item.rat_tail.desc": (text: "Long, bald and worth almost nothing.", note: "Item description.", max_chars: 160),
    "item.spider_silk.name": (text: "Spider silk", note: "Item name (material).", max_chars: 40),
    "item.spider_silk.desc": (text: "A sticky bundle of strong grey thread.", note: "Item description.", max_chars: 160),
    "item.goblin_ear.name": (text: "Goblin ear", note: "Item name (material).", max_chars: 40),
    "item.goblin_ear.desc": (text: "Pointed and green. The Guild pays for proof.", note: "Item description.", max_chars: 160),
    "item.guild_card.name": (text: "Guild card", note: "Item name (quest item): the card of the Adventurers' Guild.", max_chars: 40),
    "item.guild_card.desc": (text: "Your name, stamped by the Adventurers' Guild of Aurelia.", note: "Item description.", max_chars: 160),
    // Alpha world drops.
    "item.bandit_badge.name": (text: "Bandit badge", note: "Item name (material).", max_chars: 40),
    "item.bandit_badge.desc": (text: "A crude copper badge of the Whisperwood bandits. The captain pays for proof.", note: "Item description.", max_chars: 160),
    "item.dire_fang.name": (text: "Dire fang", note: "Item name (material).", max_chars: 40),
    "item.dire_fang.desc": (text: "A long yellow fang. The ranger collects them.", note: "Item description.", max_chars: 160),
    "item.bat_wing.name": (text: "Bat wing", note: "Item name (material).", max_chars: 40),
    "item.bat_wing.desc": (text: "A leathery wing from the mine caves.", note: "Item description.", max_chars: 160),
    "item.kobold_candle.name": (text: "Kobold candle", note: "Item name (material).", max_chars: 40),
    "item.kobold_candle.desc": (text: "A greasy stub of candle the kobolds wear on their helmets.", note: "Item description.", max_chars: 160),
    "item.golem_core.name": (text: "Golem core", note: "Item name (material).", max_chars: 40),
    "item.golem_core.desc": (text: "A warm stone heart that still glows.", note: "Item description.", max_chars: 160),
    "item.frog_leg.name": (text: "Frog leg", note: "Item name (material).", max_chars: 40),
    "item.frog_leg.desc": (text: "A fat leg of a bog frog. Fenwick cooks swear by it.", note: "Item description.", max_chars: 160),
    "item.slime_gel.name": (text: "Slime gel", note: "Item name (material).", max_chars: 40),
    "item.slime_gel.desc": (text: "Green, cold and sticky. Healers of the marsh use it.", note: "Item description.", max_chars: 160),
    "item.hag_charm.name": (text: "Hag charm", note: "Item name (material).", max_chars: 40),
    "item.hag_charm.desc": (text: "A bone charm wrapped in hair. It hums with a bad will.", note: "Item description.", max_chars: 160),
    "item.wisp_essence.name": (text: "Wisp essence", note: "Item name (material).", max_chars: 40),
    "item.wisp_essence.desc": (text: "A flask of pale light taken from a fen wisp.", note: "Item description.", max_chars: 160),
    "item.torch.name": (text: "Torch", note: "Item name (held in the off hand).", max_chars: 40),
    "item.torch.desc": (text: "Pitch-soaked rags on a stick. Lights the dark while held, and burns down while it does.", note: "Item description.", max_chars: 160),
}
