// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": (text: "Guide", note: "Name of the guide NPC at Aurelia's south gate.", max_chars: 48),
    "npc.guide.greeting": (text: "Welcome, newcomer. The circle brought you here, like the others.", note: "First line of the guide; the player was just summoned.", max_chars: 160),
    "npc.guide.where": (text: "This is Aurelia's south gate. The fields lie beyond it, and past them the woods, the hills and the marsh.", note: "Answer: where the player is. Aurelia is the starting city (proper noun).", max_chars: 160),
    "npc.guide.system": (text: "The System speaks to those who were summoned. Listen when it shows you something.", note: "Answer: what the System is (the voice of progression).", max_chars: 160),
    "npc.guide.option.where": (text: "Where am I?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.guide.option.system": (text: "What is the System?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.guide.option.back": (text: "I have another question.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.guide.option.bye": (text: "Farewell.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.guide.option.work": (text: "Is there anything I can do?", note: "Dialogue option: the player offers help (starts the first quest).", max_chars: 48),
    "npc.guide.offer": (text: "Visit the herbalist in the market quarter, west of the plaza, and bring me three glowing herbs. Proof that you can find your way.", note: "The guide offers the first quest: talk to the herbalist and bring three glowing herbs.", max_chars: 200),
    "npc.guide.option.accept": (text: "I will do it.", note: "Dialogue option: accept the quest.", max_chars: 48),
    "npc.guide.accepted": (text: "Good. The herbalist will know why you came.", note: "Reply after the player accepts the quest.", max_chars: 160),
    "npc.guide.option.done": (text: "I brought the herbs.", note: "Dialogue option: deliver the herbs (completes the quest).", max_chars: 48),
    "npc.guide.thanks": (text: "Well done. Take this bread and some coin for the road.", note: "Reply when the quest is completed; the player receives bread and coins.", max_chars: 160),
    "npc.herbalist.name": (text: "Herbalist", note: "Name of the herbalist NPC (a woman tending a garden).", max_chars: 48),
    "npc.herbalist.greeting": (text: "Mind the seedlings. What brings you to my garden?", note: "First line of the herbalist, in her garden.", max_chars: 160),
    "npc.herbalist.option.sent": (text: "The guide sent me for glowing herbs.", note: "Dialogue option: the player asks for the herbs of the first quest.", max_chars: 64),
    "npc.herbalist.gift": (text: "Another newcomer. Here, freshly picked. Tell the guide I said hello.", note: "The herbalist hands over the herbs.", max_chars: 160),
    "npc.herbalist.option.bye": (text: "Thank you. Goodbye.", note: "Dialogue option: thank and leave.", max_chars: 48),
    "npc.merchant.name": (text: "Merchant", note: "Name of the merchant NPC, who keeps the village store.", max_chars: 48),
    "npc.smith.name": (text: "Smith", note: "Name of the smith NPC, who repairs gear and teaches smithing.", max_chars: 48),
    "npc.smith.greeting": (text: "Metal, repairs or a craft to learn. Which is it?", note: "First line of the smith, by the forge.", max_chars: 160),
    "npc.smith.option.smelting": (text: "Teach me to smelt ore. (100 copper)", note: "Dialogue option: pay to learn the smelting recipe.", max_chars: 64),
    "npc.smith.option.sword": (text: "Teach me to forge a sword. (1100 copper)", note: "Dialogue option: pay to learn the iron sword recipe.", max_chars: 64),
    "npc.smith.option.bye": (text: "Another time.", note: "Dialogue option: leave the smith.", max_chars: 48),
    "npc.smith.taught": (text: "Watch the colour of the metal, not the clock. It is yours now.", note: "The smith teaches a recipe.", max_chars: 160),
    "npc.smith.option.metals": (text: "About metals and ingots.", note: "Dialogue option: open the metals lessons of the smith.", max_chars: 64),
    "npc.smith.option.learn_copper_ingot": (text: "Teach me the copper ingot. (50 copper)", note: "Dialogue option: pay to learn the copper ingot recipe.", max_chars: 64),
    "npc.smith.option.learn_silver_ingot": (text: "Teach me the silver ingot. (1000 copper)", note: "Dialogue option: pay to learn the silver ingot recipe.", max_chars: 64),
    "npc.smith.option.melee": (text: "About melee weapons.", note: "Dialogue option: open the melee weapons lessons of the smith.", max_chars: 64),
    "npc.smith.option.learn_iron_axe": (text: "Teach me the iron axe. (1400 copper)", note: "Dialogue option: pay to learn the iron axe recipe.", max_chars: 64),
    "npc.smith.option.learn_iron_spear": (text: "Teach me the iron spear. (1300 copper)", note: "Dialogue option: pay to learn the iron spear recipe.", max_chars: 64),
    "npc.smith.option.learn_stone_hammer": (text: "Teach me the stone hammer. (850 copper)", note: "Dialogue option: pay to learn the stone hammer recipe.", max_chars: 64),
    "npc.smith.option.learn_iron_hammer": (text: "Teach me the iron hammer. (1550 copper)", note: "Dialogue option: pay to learn the iron hammer recipe.", max_chars: 64),
    "npc.smith.option.ranged": (text: "About bows and staves.", note: "Dialogue option: open the bows and staves lessons of the smith.", max_chars: 64),
    "npc.smith.option.learn_wooden_bow": (text: "Teach me the wooden bow. (700 copper)", note: "Dialogue option: pay to learn the wooden bow recipe.", max_chars: 64),
    "npc.smith.option.learn_iron_bow": (text: "Teach me the iron bow. (1350 copper)", note: "Dialogue option: pay to learn the iron bow recipe.", max_chars: 64),
    "npc.smith.option.learn_oak_staff": (text: "Teach me the oak staff. (800 copper)", note: "Dialogue option: pay to learn the oak staff recipe.", max_chars: 64),
    "npc.smith.option.learn_iron_staff": (text: "Teach me the iron staff. (1450 copper)", note: "Dialogue option: pay to learn the iron staff recipe.", max_chars: 64),
    "npc.smith.option.armor": (text: "About armor.", note: "Dialogue option: open the armor lessons of the smith.", max_chars: 64),
    "npc.smith.option.learn_cloth_tunic": (text: "Teach me the cloth tunic. (550 copper)", note: "Dialogue option: pay to learn the cloth tunic recipe.", max_chars: 64),
    "npc.smith.option.learn_studded_leather": (text: "Teach me the studded leather. (1000 copper)", note: "Dialogue option: pay to learn the studded leather recipe.", max_chars: 64),
    "npc.smith.option.learn_iron_chainmail": (text: "Teach me the iron chainmail. (1200 copper)", note: "Dialogue option: pay to learn the iron chainmail recipe.", max_chars: 64),
    "npc.smith.option.learn_iron_plate_armor": (text: "Teach me the iron plate armor. (2300 copper)", note: "Dialogue option: pay to learn the iron plate armor recipe.", max_chars: 64),
    "npc.smith.lessons": (text: "Which craft do you want to learn?", note: "The smith asks what the player wants to learn.", max_chars: 160),
    "npc.smith.option.back": (text: "Something else.", note: "Dialogue option: back to the first question.", max_chars: 48),
    "npc.herbalist.option.lessons": (text: "Could you teach me potions?", note: "Dialogue option: ask the herbalist for alchemy lessons.", max_chars: 64),
    "npc.herbalist.lessons": (text: "Roots and flowers can mend or sharpen a body. Which brew?", note: "The herbalist asks which potion to teach.", max_chars: 160),
    "npc.herbalist.taught": (text: "Mind the heat and the measure. It is yours now.", note: "The herbalist teaches a recipe.", max_chars: 160),
    "npc.herbalist.option.back": (text: "Something else.", note: "Dialogue option: back to the first question.", max_chars: 48),
    "npc.herbalist.option.learn_minor_health_potion": (text: "Teach me the minor health potion. (200 copper)", note: "Dialogue option: pay to learn the minor health potion recipe.", max_chars: 64),
    "npc.herbalist.option.learn_vigor_elixir": (text: "Teach me the vigor elixir. (300 copper)", note: "Dialogue option: pay to learn the vigor elixir recipe.", max_chars: 64),
    "npc.herbalist.option.learn_mana_tonic": (text: "Teach me the mana tonic. (300 copper)", note: "Dialogue option: pay to learn the mana tonic recipe.", max_chars: 64),
    "npc.herbalist.option.learn_minor_heal": (text: "Teach me to heal with light. (300 copper)", note: "Dialogue option: pay to learn the minor heal technique (first Light magic).", max_chars: 64),
    "npc.herbalist.option.learn_revival_draught": (text: "Teach me the revival draught. (500 copper)", note: "Dialogue option: pay to learn the revival draught recipe (stands a fallen ally up).", max_chars: 64),
    "npc.herbalist.option.learn_health_potion": (text: "Teach me the health potion. (500 copper)", note: "Dialogue option: pay to learn the health potion recipe.", max_chars: 64),
    "npc.herbalist.option.learn_greater_vigor_elixir": (text: "Teach me the greater vigor elixir. (800 copper)", note: "Dialogue option: pay to learn the greater vigor elixir recipe.", max_chars: 64),
    "npc.herbalist.option.learn_greater_health_potion": (text: "Teach me the greater health potion. (1000 copper)", note: "Dialogue option: pay to learn the greater health potion recipe.", max_chars: 64),
    "npc.summoner.name": (text: "Summoner", note: "Name of the summoner NPC, an old robed mage beside the summoning circle in Aurelia.", max_chars: 48),
    "npc.summoner.greeting": (text: "You are awake. Breathe. The circle brought you from your world to ours, as it brought the others.", note: "First line of the summoner; the player was just summoned from another world.", max_chars: 200),
    "npc.summoner.what": (text: "Aurelia called for help and the circle answered with you. Nobody can send you back. But here you can grow strong.", note: "Answer: what happened to the player (isekai summoning; no way back).", max_chars: 200),
    "npc.summoner.system": (text: "The System is the voice the summoned hear. It counts your deeds and gives you titles. One is already yours.", note: "Answer: the System; the player already has the arrival title.", max_chars: 200),
    "npc.summoner.offer": (text: "First learn to stand on your feet. See the instructor in the yard to the east, then the guide on the field south of the gate. When you are ready, the Guild will register you.", note: "Offer of the tutorial quest: instructor (east), guide (field, south), then the Adventurers' Guild.", max_chars: 240),
    "npc.summoner.accepted": (text: "Go. The markers above the people you must see will guide you.", note: "Reply after accepting the tutorial; quest markers show who to talk to.", max_chars: 160),
    "npc.summoner.next": (text: "The instructor in the yard to the east, the guide on the field south of the gate, three rat tails, then the Guild hall to the north west.", note: "Reminder of the tutorial steps.", max_chars: 200),
    "npc.summoner.option.what": (text: "What happened to me?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.summoner.option.system": (text: "What is this voice in my head?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.summoner.option.begin": (text: "What should I do now?", note: "Dialogue option the player picks with a number key. Starts the tutorial.", max_chars: 48),
    "npc.summoner.option.next": (text: "Where do I go next?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.summoner.option.accept": (text: "I am ready.", note: "Dialogue option the player picks with a number key. Accepts the tutorial.", max_chars: 48),
    "npc.summoner.option.back": (text: "I have another question.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.summoner.option.bye": (text: "Later.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.instructor.name": (text: "Instructor", note: "Name of the combat instructor NPC in the training yard of Aurelia.", max_chars: 48),
    "npc.instructor.greeting": (text: "Another one from the circle. Fists up. Nobody leaves my yard without knowing how to kick.", note: "First line of the instructor.", max_chars: 160),
    "npc.instructor.taught": (text: "That is a Kick. Drag it from your techniques window to the bar at the bottom and press its number in a fight.", note: "The instructor taught the Kick technique; tip: put it on the hotbar.", max_chars: 200),
    "npc.instructor.fight": (text: "Click a creature to attack it; you keep striking on your own. If something hits you, you hit back. Watch your health and step away when it runs low.", note: "Combat tips: click to attack, automatic retaliation, retreat when low.", max_chars: 240),
    "npc.instructor.option.teach": (text: "Teach me to fight.", note: "Dialogue option the player picks with a number key. Learns the Kick technique for free.", max_chars: 48),
    "npc.instructor.option.fight": (text: "How does a fight work?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.instructor.option.back": (text: "Something else.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.instructor.option.bye": (text: "Thank you.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.guild_clerk.name": (text: "Guild clerk", note: "Name of the clerk of the Adventurers' Guild in Aurelia.", max_chars: 48),
    "npc.guild_clerk.greeting": (text: "Adventurers' Guild of Aurelia. Registration, work and payment, in that order.", note: "First line of the guild clerk.", max_chars: 160),
    "npc.guild_clerk.registered": (text: "Name written, card stamped. Welcome to the Guild, adventurer. Ask me for work whenever you need coin.", note: "The player is registered at the guild (end of the tutorial) and gets a guild card.", max_chars: 200),
    "npc.guild_clerk.not_yet": (text: "The summoner has not finished with you yet. Come back when you have done what was asked.", note: "The tutorial is not finished yet.", max_chars: 160),
    "npc.guild_clerk.work": (text: "Goblins came down to the briar hills east of the field, and the weavers pay for spider silk from the same hills.", note: "Guild work: goblins and spider silk in the briar hills (east of the field).", max_chars: 200),
    "npc.guild_clerk.taken": (text: "Written down. Bring me the proof and you get paid.", note: "Reply after taking guild work.", max_chars: 120),
    "npc.guild_clerk.paid": (text: "Counted and paid. Good work.", note: "Reply after delivering guild work.", max_chars: 120),
    "npc.guild_clerk.option.register": (text: "I want to register.", note: "Dialogue option the player picks with a number key. Completes the tutorial.", max_chars: 48),
    "npc.guild_clerk.option.not_yet": (text: "I came to register.", note: "Dialogue option the player picks with a number key. The tutorial is not ready yet.", max_chars: 48),
    "npc.guild_clerk.option.work": (text: "Is there work?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.guild_clerk.option.take_goblins": (text: "I will deal with the goblins.", note: "Dialogue option the player picks with a number key. Starts the goblin quest.", max_chars: 48),
    "npc.guild_clerk.option.take_silk": (text: "I will bring spider silk.", note: "Dialogue option the player picks with a number key. Starts the repeatable spider silk quest.", max_chars: 48),
    "npc.guild_clerk.option.ears": (text: "I brought goblin ears.", note: "Dialogue option the player picks with a number key. Delivers five goblin ears.", max_chars: 48),
    "npc.guild_clerk.option.silk": (text: "I brought spider silk.", note: "Dialogue option the player picks with a number key. Delivers four spider silks.", max_chars: 48),
    "npc.guild_clerk.option.back": (text: "Something else.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.guild_clerk.option.bye": (text: "Goodbye.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.guide.option.sent": (text: "The summoner sent me.", note: "Dialogue option the player picks with a number key. Step of the tutorial.", max_chars: 48),
    "npc.guide.rats": (text: "Rats chew the farms outside this gate. Bring three tails to prove you can fight. The merchant in the market, west of the plaza, buys what you loot.", note: "The guide sends the player after field rats and points at the merchant for selling.", max_chars: 200),
    // Alpha world NPCs.
    "npc.captain.name": (text: "Captain", note: "Name of the captain of the guard at Aurelia's south gate.", max_chars: 48),
    "npc.captain.greeting": (text: "Keep your blade ready past this gate. The fields are not as quiet as they look.", note: "First line of the captain of the guard.", max_chars: 160),
    "npc.captain.work": (text: "Wolves in the fields, and bandits in Whisperwood to the west. The ranger at the lodge knows the woods.", note: "The captain lists the work: wolves, a patrol to the ranger, then the bandits.", max_chars: 200),
    "npc.captain.taken": (text: "Good. Report back when it is done.", note: "Reply after the player takes a task.", max_chars: 160),
    "npc.captain.paid": (text: "The city owes you. Here is your pay.", note: "Reply when the player delivers and is paid.", max_chars: 160),
    "npc.captain.option.work": (text: "Any work for me?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.captain.option.pelts": (text: "I brought the wolf pelts.", note: "Dialogue option the player picks with a number key. Delivers five wolf pelts.", max_chars: 48),
    "npc.captain.option.badges": (text: "I brought bandit badges.", note: "Dialogue option the player picks with a number key. Delivers six bandit badges.", max_chars: 48),
    "npc.captain.option.take_wolves": (text: "I will hunt the wolves.", note: "Dialogue option the player picks with a number key. Starts the wolf quest.", max_chars: 48),
    "npc.captain.option.take_patrol": (text: "I will find the ranger.", note: "Dialogue option the player picks with a number key. Starts the patrol to Whisperwood.", max_chars: 48),
    "npc.captain.option.take_bandits": (text: "I will deal with the bandits.", note: "Dialogue option the player picks with a number key. Starts the bandit quest.", max_chars: 48),
    "npc.captain.option.back": (text: "Something else.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.captain.option.bye": (text: "Farewell.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.ranger.name": (text: "Ranger", note: "Name of the ranger at the Whisperwood lodge.", max_chars: 48),
    "npc.ranger.greeting": (text: "Quiet steps, stranger. The woods listen.", note: "First line of the ranger.", max_chars: 160),
    "npc.ranger.forest": (text: "Dire wolves den south of here, and the bandits camp beyond them. Fenmoor lies past the fields to the south east.", note: "The ranger describes Whisperwood and points at Fenmoor.", max_chars: 200),
    "npc.ranger.taken": (text: "Bring me their fangs and I will pay.", note: "Reply after the player takes the dire wolf task.", max_chars: 160),
    "npc.ranger.paid": (text: "Fewer wolves, safer roads. Take this.", note: "Reply when the player delivers and is paid.", max_chars: 160),
    "npc.ranger.option.patrol": (text: "The captain sent me.", note: "Dialogue option the player picks with a number key. Ends the patrol from Aurelia.", max_chars: 48),
    "npc.ranger.option.forest": (text: "What is in these woods?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.ranger.option.take_fangs": (text: "I will hunt the dire wolves.", note: "Dialogue option the player picks with a number key. Starts the dire wolf quest.", max_chars: 48),
    "npc.ranger.option.fangs": (text: "I brought dire fangs.", note: "Dialogue option the player picks with a number key. Delivers four dire fangs.", max_chars: 48),
    "npc.ranger.option.back": (text: "Something else.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.ranger.option.bye": (text: "Farewell.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.foreman.name": (text: "Foreman", note: "Name of the mine foreman of Stonebrook.", max_chars: 48),
    "npc.foreman.greeting": (text: "Stonebrook digs, Stonebrook pays. You looking for work?", note: "First line of the mine foreman.", max_chars: 160),
    "npc.foreman.work": (text: "The mines north of town crawl with bats and kobolds, and something big woke at the deep end.", note: "The foreman lists the mine work: bats, kobolds, the golem.", max_chars: 200),
    "npc.foreman.taken": (text: "The mine mouth is up the north road. Mind your head.", note: "Reply after the player takes a task.", max_chars: 160),
    "npc.foreman.paid": (text: "Fair work, fair coin.", note: "Reply when the player delivers and is paid.", max_chars: 160),
    "npc.foreman.option.sent": (text: "The guild sent me.", note: "Dialogue option the player picks with a number key. Ends the road from Aurelia.", max_chars: 48),
    "npc.foreman.option.work": (text: "Any work in the mines?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.foreman.option.wings": (text: "I brought bat wings.", note: "Dialogue option the player picks with a number key. Delivers six bat wings (repeatable).", max_chars: 48),
    "npc.foreman.option.candles": (text: "I brought kobold candles.", note: "Dialogue option the player picks with a number key. Delivers eight kobold candles.", max_chars: 48),
    "npc.foreman.option.core": (text: "I brought the golem's core.", note: "Dialogue option the player picks with a number key. Delivers the golem core.", max_chars: 48),
    "npc.foreman.option.take_wings": (text: "I will clear the bats.", note: "Dialogue option the player picks with a number key. Starts the repeatable bat wing quest.", max_chars: 48),
    "npc.foreman.option.take_candles": (text: "I will drive off the kobolds.", note: "Dialogue option the player picks with a number key. Starts the kobold quest.", max_chars: 48),
    "npc.foreman.option.take_core": (text: "I will face the golem.", note: "Dialogue option the player picks with a number key. Starts the golem quest.", max_chars: 48),
    "npc.foreman.option.back": (text: "Something else.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.foreman.option.bye": (text: "Farewell.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.quartermaster.name": (text: "Quartermaster", note: "Name of the quartermaster of Stonebrook, who keeps the mine store and repairs gear.", max_chars: 48),
    "npc.fen_elder.name": (text: "Elder", note: "Name of the elder of Fenwick, the village in Fenmoor.", max_chars: 48),
    "npc.fen_elder.greeting": (text: "Mind the boardwalks. The marsh keeps what falls in.", note: "First line of the elder of Fenwick.", max_chars: 160),
    "npc.fen_elder.work": (text: "Our remedy needs frog legs and slime gel, our lamps need wisp light, and the hag on the west island curses us all.", note: "The elder lists the marsh work.", max_chars: 200),
    "npc.fen_elder.taken": (text: "May the boards hold under you.", note: "Reply after the player takes a task.", max_chars: 160),
    "npc.fen_elder.paid": (text: "Fenwick thanks you.", note: "Reply when the player delivers and is paid.", max_chars: 160),
    "npc.fen_elder.option.letter": (text: "The herbalist of Aurelia sends greetings.", note: "Dialogue option the player picks with a number key. Ends the letter quest.", max_chars: 48),
    "npc.fen_elder.option.work": (text: "Can I help the village?", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.fen_elder.option.remedy": (text: "I brought what the remedy needs.", note: "Dialogue option the player picks with a number key. Delivers frog legs and slime gel.", max_chars: 48),
    "npc.fen_elder.option.charm": (text: "I brought the hag's charm.", note: "Dialogue option the player picks with a number key. Delivers the hag charm.", max_chars: 48),
    "npc.fen_elder.option.essence": (text: "I brought wisp essence.", note: "Dialogue option the player picks with a number key. Delivers three wisp essences (repeatable).", max_chars: 48),
    "npc.fen_elder.option.take_remedy": (text: "I will gather for the remedy.", note: "Dialogue option the player picks with a number key. Starts the remedy quest.", max_chars: 48),
    "npc.fen_elder.option.take_hag": (text: "I will face the hag.", note: "Dialogue option the player picks with a number key. Starts the hag quest.", max_chars: 48),
    "npc.fen_elder.option.take_wisps": (text: "I will catch wisp light.", note: "Dialogue option the player picks with a number key. Starts the repeatable wisp quest.", max_chars: 48),
    "npc.fen_elder.option.back": (text: "Something else.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.fen_elder.option.bye": (text: "Farewell.", note: "Dialogue option the player picks with a number key.", max_chars: 48),
    "npc.fen_trader.name": (text: "Trader", note: "Name of the trader of Fenwick, who sells herbs and remedies.", max_chars: 48),
    "npc.guild_clerk.option.take_stonebrook": (text: "I will go to Stonebrook.", note: "Dialogue option the player picks with a number key. Starts the road to Stonebrook.", max_chars: 48),
    "npc.herbalist.option.letter": (text: "Do you need anything carried?", note: "Dialogue option the player picks with a number key. Starts the letter to Fenwick.", max_chars: 64),
    "npc.herbalist.letter": (text: "Yes! Take my greetings to the elder of Fenwick, in the marsh south of the fields.", note: "The herbalist gives the letter quest.", max_chars: 200),
}
