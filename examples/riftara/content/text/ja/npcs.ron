// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "案内人",
    "npc.guide.greeting": "ようこそ、新参者。あなたも他の人々と同じく、円環によってここへ導かれたのです。",
    "npc.guide.where": "ここはアウレリアの南門です。その向こうに野原が広がり、さらに森、丘、沼地が続きます。",
    "npc.guide.system": "システムは召喚された者に語りかけます。何かを示されたら耳を傾けてください。",
    "npc.guide.option.where": "ここはどこですか？",
    "npc.guide.option.system": "システムとは何ですか？",
    "npc.guide.option.back": "ほかに質問があります。",
    "npc.guide.option.bye": "さようなら。",
    "npc.guide.option.work": "私にできることはありますか？",
    "npc.guide.offer": "市場街の薬草師を訪ね、広場の西から、光る薬草を三つ持ってきてください。道を見つけられる証明になります。",
    "npc.guide.option.accept": "やります。",
    "npc.guide.accepted": "よし。薬草師があなたの来た理由を知っているでしょう。",
    "npc.guide.option.done": "薬草を持ってきました。",
    "npc.guide.thanks": "よくやった。この乾パンと旅費を持っていきなさい。",
    "npc.herbalist.name": "薬草師",
    "npc.herbalist.greeting": "苗に気をつけて。私の庭に何の用ですか？",
    "npc.herbalist.option.sent": "案内人に光る薬草を頼まれました。",
    "npc.herbalist.gift": "また新参者ですね。どうぞ、摘みたてです。案内人によろしく伝えてください。",
    "npc.herbalist.option.bye": "ありがとう。さようなら。",
    "npc.merchant.name": "商人",
    "npc.smith.name": "鍛冶屋",
    "npc.smith.greeting": "金属、修理、それとも覚えたい技か。どれですか？",
    "npc.smith.option.smelting": "鉱石の溶かし方を教えてください。（銅貨100）",
    "npc.smith.option.sword": "剣の打ち方を教えてください。（銅貨1100）",
    "npc.smith.option.bye": "また今度。",
    "npc.smith.taught": "時計ではなく、金属の色を見るんだ。これでお前のものだ。",
    "npc.smith.option.metals": "金属とインゴットについて。",
    "npc.smith.option.learn_copper_ingot": "銅のインゴットを教えてください。（銅貨50）",
    "npc.smith.option.learn_silver_ingot": "銀のインゴットを教えてください。（銅貨1000）",
    "npc.smith.option.melee": "近接武器について。",
    "npc.smith.option.learn_iron_axe": "鉄の斧を教えてください。（銅貨1400）",
    "npc.smith.option.learn_iron_spear": "鉄の槍を教えてください。（銅貨1300）",
    "npc.smith.option.learn_stone_hammer": "石のハンマーを教えてください。（銅貨850）",
    "npc.smith.option.learn_iron_hammer": "鉄のハンマーを教えてください。（銅貨1550）",
    "npc.smith.option.ranged": "弓と杖について。",
    "npc.smith.option.learn_wooden_bow": "木の弓を教えてください。（銅貨700）",
    "npc.smith.option.learn_iron_bow": "鉄の弓を教えてください。（銅貨1350）",
    "npc.smith.option.learn_oak_staff": "オークの杖を教えてください。（銅貨800）",
    "npc.smith.option.learn_iron_staff": "鉄の杖を教えてください。（銅貨1450）",
    "npc.smith.option.armor": "防具について。",
    "npc.smith.option.learn_cloth_tunic": "布のチュニックを教えてください。（銅貨550）",
    "npc.smith.option.learn_studded_leather": "鋲打ちの革を教えてください。（銅貨1000）",
    "npc.smith.option.learn_iron_chainmail": "鉄の鎖帷子を教えてください。（銅貨1200）",
    "npc.smith.option.learn_iron_plate_armor": "鉄の板金鎧を教えてください。（銅貨2300）",
    "npc.smith.lessons": "どの技を覚えたいですか？",
    "npc.smith.option.back": "別のことです。",
    "npc.herbalist.option.lessons": "薬の作り方を教えてもらえますか？",
    "npc.herbalist.lessons": "根や花は体を癒し、力を高めることができます。どの薬ですか？",
    "npc.herbalist.taught": "火加減と分量に気をつけて。これでお前のものだ。",
    "npc.herbalist.option.back": "別のことです。",
    "npc.herbalist.option.learn_minor_health_potion": "小さな回復薬を教えてください。（銅貨200）",
    "npc.herbalist.option.learn_vigor_elixir": "活力の霊薬を教えてください。（銅貨300）",
    "npc.herbalist.option.learn_mana_tonic": "マナの強壮薬を教えてください。（銅貨300）",
    "npc.herbalist.option.learn_minor_heal": "光で癒す術を教えてください。（銅貨300）",
    "npc.herbalist.option.learn_revival_draught": "蘇生の水薬を教えてください。（銅貨500）",
    "npc.herbalist.option.learn_health_potion": "回復薬を教えてください。（銅貨500）",
    "npc.herbalist.option.learn_greater_vigor_elixir": "大きな活力の霊薬を教えてください。（銅貨800）",
    "npc.herbalist.option.learn_greater_health_potion": "大きな回復薬を教えてください。（銅貨1000）",
    "npc.summoner.name": "召喚士",
    "npc.summoner.greeting": "目覚めましたね。息を整えなさい。円環が、他の人々と同じくあなたを世界から連れてきたのです。",
    "npc.summoner.what": "アウレリアが助けを求め、円環があなたという答えを返しました。あなたを帰す方法は誰にもありません。ですがここで強くなることはできます。",
    "npc.summoner.system": "システムは召喚された者に聞こえる声です。あなたの行いを数え、称号を授けます。もう一つ、あなたのものになっています。",
    "npc.summoner.offer": "まずは自分の足で立つことを学びなさい。東の中庭の教官に会い、それから門の南の野原にいる案内人に会いなさい。準備ができたら、ギルドがあなたを登録します。",
    "npc.summoner.accepted": "行きなさい。会うべき人の頭上の印が道を示してくれます。",
    "npc.summoner.next": "東の中庭の教官、門の南の野原の案内人、ネズミの尻尾を三つ、それから北西のギルドの広間です。",
    "npc.summoner.option.what": "私に何が起きたのですか？",
    "npc.summoner.option.system": "頭の中のこの声は何ですか？",
    "npc.summoner.option.begin": "今は何をすればいいですか？",
    "npc.summoner.option.next": "次はどこへ行けばいいですか？",
    "npc.summoner.option.accept": "準備はできています。",
    "npc.summoner.option.back": "ほかに質問があります。",
    "npc.summoner.option.bye": "あとで。",
    "npc.instructor.name": "教官",
    "npc.instructor.greeting": "また円環の一人か。拳を構えろ。蹴り方を知らないやつは、この中庭から出さんぞ。",
    "npc.instructor.taught": "それは蹴りだ。技の窓から下のバーへドラッグして、戦闘中に番号を押せ。",
    "npc.instructor.fight": "生き物をクリックすると攻撃できる。その後もお前は自動で打ち続ける。何かに殴られたら反撃する。体力を見て、減ってきたら下がれ。",
    "npc.instructor.option.teach": "戦い方を教えてください。",
    "npc.instructor.option.fight": "戦闘はどうなるのですか？",
    "npc.instructor.option.back": "別のことです。",
    "npc.instructor.option.bye": "ありがとう。",
    "npc.guild_clerk.name": "ギルドの書記",
    "npc.guild_clerk.greeting": "アウレリア冒険者ギルドです。登録、仕事、支払いの順にどうぞ。",
    "npc.guild_clerk.registered": "名前を記入し、カードに押印しました。ようこそ、冒険者。お金が必要になったら、いつでも仕事を頼みなさい。",
    "npc.guild_clerk.not_yet": "召喚士がまだあなたの件を終えていません。頼まれたことを済ませてから戻ってきなさい。",
    "npc.guild_clerk.work": "ゴブリンが野原の東の茨の丘に下りてきており、織工は同じ丘の蜘蛛の糸に金を払っています。",
    "npc.guild_clerk.taken": "記録しました。証拠を持ってくれば支払います。",
    "npc.guild_clerk.paid": "数えて支払いました。よくやりました。",
    "npc.guild_clerk.option.register": "登録したいです。",
    "npc.guild_clerk.option.not_yet": "登録しに来ました。",
    "npc.guild_clerk.option.work": "仕事はありますか？",
    "npc.guild_clerk.option.take_goblins": "ゴブリンは私が片付けます。",
    "npc.guild_clerk.option.take_silk": "蜘蛛の糸を持ってきます。",
    "npc.guild_clerk.option.ears": "ゴブリンの耳を持ってきました。",
    "npc.guild_clerk.option.silk": "蜘蛛の糸を持ってきました。",
    "npc.guild_clerk.option.back": "別のことです。",
    "npc.guild_clerk.option.bye": "さようなら。",
    "npc.guide.option.sent": "召喚士に送られてきました。",
    "npc.guide.rats": "この門の外の野原ではネズミが作物をかじっています。戦えることを示すため、尻尾を三つ持ってきなさい。広場の西の市場にいる商人が、あなたの戦利品を買い取ります。",
    // Alpha world NPCs.
    "npc.captain.name": "隊長",
    "npc.captain.greeting": "この門の先では刃を構えておけ。野原は見た目ほど静かではないぞ。",
    "npc.captain.work": "野原には狼が、西のウィスパーウッドには盗賊がいる。山小屋の猟師が森のことをよく知っている。",
    "npc.captain.taken": "よし。終わったら報告しに戻ってこい。",
    "npc.captain.paid": "街はお前に借りがある。これが報酬だ。",
    "npc.captain.option.work": "何か仕事はありますか？",
    "npc.captain.option.pelts": "狼の毛皮を持ってきました。",
    "npc.captain.option.badges": "盗賊の徽章を持ってきました。",
    "npc.captain.option.take_wolves": "狼を狩ります。",
    "npc.captain.option.take_patrol": "猟師を探します。",
    "npc.captain.option.take_bandits": "盗賊は私が片付けます。",
    "npc.captain.option.back": "別のことです。",
    "npc.captain.option.bye": "さようなら。",
    "npc.ranger.name": "猟師",
    "npc.ranger.greeting": "静かに歩くな、よそ者。森が聞いているぞ。",
    "npc.ranger.forest": "恐狼はここから南に巣を作っており、盗賊はその先で野営している。フェンモアは野原の向こうの南東にある。",
    "npc.ranger.taken": "牙を持ってきたら報酬を払おう。",
    "npc.ranger.paid": "狼が減れば道も安全になる。受け取れ。",
    "npc.ranger.option.patrol": "隊長に送られてきました。",
    "npc.ranger.option.forest": "この森には何がいるのですか？",
    "npc.ranger.option.take_fangs": "恐狼を狩ります。",
    "npc.ranger.option.fangs": "恐狼の牙を持ってきました。",
    "npc.ranger.option.back": "別のことです。",
    "npc.ranger.option.bye": "さようなら。",
    "npc.foreman.name": "現場監督",
    "npc.foreman.greeting": "ストーンブルックは掘り、ストーンブルックは払う。仕事を探しているのか？",
    "npc.foreman.work": "街の北の鉱山は蝙蝠とコボルドだらけだ。それに奥のほうで何か大きなものが目を覚ました。",
    "npc.foreman.taken": "坑口は北の道の先にある。頭に気をつけろ。",
    "npc.foreman.paid": "公正な仕事には公正な報酬だ。",
    "npc.foreman.option.sent": "ギルドに送られてきました。",
    "npc.foreman.option.work": "鉱山に仕事はありますか？",
    "npc.foreman.option.wings": "蝙蝠の翼を持ってきました。",
    "npc.foreman.option.candles": "コボルドの蝋燭を持ってきました。",
    "npc.foreman.option.core": "ゴーレムの核を持ってきました。",
    "npc.foreman.option.take_wings": "蝙蝠は私が一掃します。",
    "npc.foreman.option.take_candles": "コボルドは私が追い払います。",
    "npc.foreman.option.take_core": "ゴーレムに立ち向かいます。",
    "npc.foreman.option.back": "別のことです。",
    "npc.foreman.option.bye": "さようなら。",
    "npc.quartermaster.name": "補給係",
    "npc.fen_elder.name": "長老",
    "npc.fen_elder.greeting": "板道に気をつけなさい。沼は落ちたものを何でも呑み込むのです。",
    "npc.fen_elder.work": "私たちの薬にはカエルの足と粘液のゼリーが、ランプには鬼火の光が必要で、西の島の魔女が私たち皆に呪いをかけている。",
    "npc.fen_elder.taken": "板があなたを支えてくれますように。",
    "npc.fen_elder.paid": "フェンウィックはあなたに感謝します。",
    "npc.fen_elder.option.letter": "アウレリアの薬草師からの挨拶です。",
    "npc.fen_elder.option.work": "村のために何かできますか？",
    "npc.fen_elder.option.remedy": "薬に必要なものを持ってきました。",
    "npc.fen_elder.option.charm": "魔女の護符を持ってきました。",
    "npc.fen_elder.option.essence": "鬼火のエッセンスを持ってきました。",
    "npc.fen_elder.option.take_remedy": "薬の材料を集めてきます。",
    "npc.fen_elder.option.take_hag": "魔女に立ち向かいます。",
    "npc.fen_elder.option.take_wisps": "鬼火の光を捕まえます。",
    "npc.fen_elder.option.back": "別のことです。",
    "npc.fen_elder.option.bye": "さようなら。",
    "npc.fen_trader.name": "行商人",
    "npc.guild_clerk.option.take_stonebrook": "ストーンブルックへ行きます。",
    "npc.herbalist.option.letter": "何か届けるものはありますか？",
    "npc.herbalist.letter": "はい！畑の南の沼地にいるフェンウィックの長老に、私の挨拶を伝えてください。",
}
