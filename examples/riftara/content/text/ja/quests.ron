// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "最初の一歩",
    "quest.first_steps.desc": "薬草師と話し、光る薬草を三つ案内人に届ける。",
    "quest.arrival.name": "到着",
    "quest.arrival.desc": "教官に学び、野原で案内人を探し、ネズミの尻尾を三つ持って冒険者ギルドに登録する。",
    "quest.goblin_trouble.name": "ゴブリン騒動",
    "quest.goblin_trouble.desc": "ゴブリンが茨の丘に下りてきた。ゴブリンの耳を五つ、ギルドの書記に届ける。",
    "quest.spider_silk.name": "蜘蛛の糸",
    "quest.spider_silk.desc": "アウレリアの織工は糸に金を払う。茨の丘の蜘蛛の糸を四本、ギルドの書記に届ける。",
    // Alpha world quests.
    "quest.wolf_cull.name": "門前の狼",
    "quest.wolf_cull.desc": "アウレリアの南の野原に狼がうろついている。狼の毛皮を五枚、南門の隊長に届ける。",
    "quest.forest_patrol.name": "ウィスパーウッドの巡回",
    "quest.forest_patrol.desc": "アウレリアから西の道をたどってウィスパーウッドへ行き、山小屋の猟師に報告する。",
    "quest.bandit_badges.name": "盗賊の徽章",
    "quest.bandit_badges.desc": "盗賊がウィスパーウッドの奥に陣取っている。盗賊の徽章を六つ、隊長に届ける。",
    "quest.dire_fangs.name": "恐狼の牙",
    "quest.dire_fangs.desc": "恐狼が山小屋の南に巣を作っている。恐狼の牙を四本、猟師に届ける。",
    "quest.road_to_stonebrook.name": "ストーンブルックへの道",
    "quest.road_to_stonebrook.desc": "東へ茨の丘を越えてストーンブルックへ行き、鉱山の現場監督と話す。",
    "quest.bat_wings.name": "蝙蝠の翼",
    "quest.bat_wings.desc": "アイアンリッジ鉱山の最初の洞窟で蝙蝠が増えている。蝙蝠の翼を六枚、現場監督に届ける。",
    "quest.kobold_candles.name": "コボルドの蝋燭",
    "quest.kobold_candles.desc": "鉱山の東の洞窟でコボルドが掘っている。彼らの蝋燭を八本、現場監督に届ける。",
    "quest.heart_of_stone.name": "石の心臓",
    "quest.heart_of_stone.desc": "岩のゴーレムが鉱山の奥を守っている。その核を現場監督に届ける。",
    "quest.letter_to_fenwick.name": "フェンウィックへの伝言",
    "quest.letter_to_fenwick.desc": "薬草師の挨拶を、野原を越えて南の沼地フェンモアにいるフェンウィックの長老に届ける。",
    "quest.marsh_remedy.name": "沼地の薬",
    "quest.marsh_remedy.desc": "フェンウィックの長老は村の薬のために、カエルの足を五本と粘液のゼリーを三つ必要としている。",
    "quest.hags_curse.name": "魔女の呪い",
    "quest.hags_curse.desc": "沼の魔女が西の島からフェンウィックに呪いをかけている。その護符を長老に届ける。",
    "quest.wisp_lights.name": "鬼火の灯り",
    "quest.wisp_lights.desc": "フェンウィックの長老は村のランプ用に鬼火のエッセンスを買い取っている。三つ届ける。",
}
