// Texts of items (content/items/).
{
    "item.glow_herb.name": "光る薬草",
    "item.glow_herb.desc": "夕暮れにかすかに光る薬草。案内人がこれを求めている。",
    "item.travel_bread.name": "旅のパン",
    "item.travel_bread.desc": "何週間も保存できる、ずっしりしたパン。",
    "item.rusty_sword.name": "錆びた剣",
    "item.rusty_sword.desc": "古いが、まだ切れる。何か気になるところがある。",
    "item.hunting_knife.name": "狩りナイフ",
    "item.hunting_knife.desc": "手が確かなら、軽くて素早い。",
    "item.leather_armor.name": "革の鎧",
    "item.leather_armor.desc": "硬い革で、噛みつきを一、二度は防げる。",
    "item.wolf_pelt.name": "狼の毛皮",
    "item.wolf_pelt.desc": "分厚い灰色の毛皮。革職人が買い取る。",
    "item.boar_tusk.name": "猪の牙",
    "item.boar_tusk.desc": "湾曲して鋭い。職人の役に立つ。",
    "item.iron_ore.name": "鉄鉱石",
    "item.iron_ore.desc": "原石。二つ溶かすと一つのインゴットになる。",
    "item.iron_ingot.name": "鉄のインゴット",
    "item.iron_ingot.desc": "きれいな金属で、金床に乗せる準備ができている。",
    "item.iron_sword.name": "鉄の剣",
    "item.iron_sword.desc": "鍛えられ、バランスがよく、修理する価値がある。",
    "item.rat_tail.name": "ネズミの尻尾",
    "item.rat_tail.desc": "長くて毛がなく、ほとんど価値がない。",
    "item.spider_silk.name": "蜘蛛の糸",
    "item.spider_silk.desc": "強い灰色の糸のねばつく束。",
    "item.goblin_ear.name": "ゴブリンの耳",
    "item.goblin_ear.desc": "尖っていて緑色。ギルドは証拠として買い取る。",
    "item.guild_card.name": "ギルドカード",
    "item.guild_card.desc": "アウレリア冒険者ギルドが押印した、あなたの名前。",
    // Alpha world drops.
    "item.bandit_badge.name": "盗賊の徽章",
    "item.bandit_badge.desc": "ウィスパーウッドの盗賊の粗末な銅の徽章。隊長が証拠として買い取る。",
    "item.dire_fang.name": "恐狼の牙",
    "item.dire_fang.desc": "長く黄色い牙。猟師が集めている。",
    "item.bat_wing.name": "蝙蝠の翼",
    "item.bat_wing.desc": "鉱山の洞窟から来た革のような翼。",
    "item.kobold_candle.name": "コボルドの蝋燭",
    "item.kobold_candle.desc": "コボルドが兜につけている、脂っぽい蝋燭の切れ端。",
    "item.golem_core.name": "ゴーレムの核",
    "item.golem_core.desc": "まだ光っている、温かい石の心臓。",
    "item.frog_leg.name": "カエルの足",
    "item.frog_leg.desc": "沼ガエルの太い足。フェンウィックの料理人が愛用している。",
    "item.slime_gel.name": "粘液のゼリー",
    "item.slime_gel.desc": "緑色で冷たく、ねばつく。沼地の治療師が使う。",
    "item.hag_charm.name": "魔女の護符",
    "item.hag_charm.desc": "髪の毛で巻かれた骨の護符。悪意を帯びて震えている。",
    "item.wisp_essence.name": "鬼火のエッセンス",
    "item.wisp_essence.desc": "沼の鬼火から採られた、淡い光の小瓶。",
    "item.torch.name": "松明",
    "item.torch.desc": "松脂に浸した布を棒に巻いたもの。手に持つ間は闇を照らし、その間に燃え尽きていく。",
