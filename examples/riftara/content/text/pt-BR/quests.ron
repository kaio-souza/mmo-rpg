// Texts of quests (content/quests/).
{
    "quest.first_steps.name": "Primeiros passos",
    "quest.first_steps.desc": "Fale com a herborista e leve três ervas brilhantes ao guia.",
    "quest.arrival.name": "Chegada",
    "quest.arrival.desc": "Aprenda com o instrutor, encontre o guia no campo, traga três caudas de rato e registre-se na Guilda dos Aventureiros.",
    "quest.goblin_trouble.name": "Problema com goblins",
    "quest.goblin_trouble.desc": "Goblins desceram para as colinas de sarça. Traga cinco orelhas de goblin ao escriturário da guilda.",
    "quest.spider_silk.name": "Seda de aranha",
    "quest.spider_silk.desc": "Os tecelões de Aurelia pagam por seda. Traga quatro sedas de aranha das colinas de sarça ao escriturário da guilda.",
    // Alpha world quests.
    "quest.wolf_cull.name": "Lobos no portão",
    "quest.wolf_cull.desc": "Lobos rondam os campos ao sul de Aurelia. Traga cinco peles de lobo ao capitão do portão sul.",
    "quest.forest_patrol.name": "Patrulha até Whisperwood",
    "quest.forest_patrol.desc": "Siga a estrada a oeste de Aurelia até Whisperwood e apresente-se ao patrulheiro da cabana.",
    "quest.bandit_badges.name": "Insígnias de bandido",
    "quest.bandit_badges.desc": "Bandidos acampam fundo em Whisperwood. Traga seis insígnias de bandido ao capitão.",
    "quest.dire_fangs.name": "Presas atrozes",
    "quest.dire_fangs.desc": "Lobos atrozes têm covil ao sul da cabana. Traga quatro presas atrozes ao patrulheiro.",
    "quest.road_to_stonebrook.name": "A estrada para Stonebrook",
    "quest.road_to_stonebrook.desc": "Siga a estrada a leste pelas colinas de sarça até Stonebrook e fale com o capataz da mina.",
    "quest.bat_wings.name": "Asas de morcego",
    "quest.bat_wings.desc": "Morcegos infestam a primeira caverna das minas de Ironridge. Traga seis asas de morcego ao capataz.",
    "quest.kobold_candles.name": "Velas de kobold",
    "quest.kobold_candles.desc": "Kobolds cavam na caverna leste das minas. Traga oito das velas deles ao capataz.",
    "quest.heart_of_stone.name": "Coração de pedra",
    "quest.heart_of_stone.desc": "Um golem de rocha guarda o fundo das minas. Leve o núcleo dele ao capataz.",
    "quest.letter_to_fenwick.name": "Recado para Fenwick",
    "quest.letter_to_fenwick.desc": "Leve as saudações da herborista para o sul, pelos campos, até o ancião de Fenwick, em Fenmoor.",
    "quest.marsh_remedy.name": "Remédio do pântano",
    "quest.marsh_remedy.desc": "O ancião de Fenwick precisa de cinco pernas de rã e três geleias de lodo para o remédio da vila.",
    "quest.hags_curse.name": "A maldição da bruxa",
    "quest.hags_curse.desc": "Uma bruxa do pântano amaldiçoa Fenwick da sua ilha a oeste. Leve o amuleto dela ao ancião.",
    "quest.wisp_lights.name": "Luzes-fátuas",
    "quest.wisp_lights.desc": "O ancião de Fenwick compra essência de fátua para as lamparinas da vila. Traga três.",
}
