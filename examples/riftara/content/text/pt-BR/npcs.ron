// Texts of NPCs and dialogues (content/npcs/).
{
    "npc.guide.name": "Guia",
    "npc.guide.greeting": "Bem-vindo, recém-chegado. O círculo trouxe você aqui, como aos outros.",
    "npc.guide.where": "Este é o portão sul de Aurelia. Os campos ficam além dele, e depois deles, o bosque, as colinas e o pântano.",
    "npc.guide.system": "O Sistema fala com quem foi invocado. Escute quando ele mostrar algo.",
    "npc.guide.option.where": "Onde estou?",
    "npc.guide.option.system": "O que é o Sistema?",
    "npc.guide.option.back": "Tenho outra pergunta.",
    "npc.guide.option.bye": "Adeus.",
    "npc.guide.option.work": "Há algo que eu possa fazer?",
    "npc.guide.offer": "Visite a herborista no bairro do mercado, a oeste da praça, e traga três ervas brilhantes. Prova de que você sabe encontrar o caminho.",
    "npc.guide.option.accept": "Eu faço.",
    "npc.guide.accepted": "Bom. A herborista vai saber por que você veio.",
    "npc.guide.option.done": "Trouxe as ervas.",
    "npc.guide.thanks": "Muito bem. Leve este pão e umas moedas para a estrada.",
    "npc.herbalist.name": "Herborista",
    "npc.herbalist.greeting": "Cuidado com as mudas. O que o traz ao meu jardim?",
    "npc.herbalist.option.sent": "O guia me mandou atrás de ervas brilhantes.",
    "npc.herbalist.gift": "Mais um recém-chegado. Aqui, colhidas agora. Diga ao guia que mandei lembranças.",
    "npc.herbalist.option.bye": "Obrigado. Adeus.",
    "npc.merchant.name": "Mercador",
    "npc.smith.name": "Ferreiro",
    "npc.smith.greeting": "Metal, conserto ou um ofício para aprender. Qual é?",
    "npc.smith.option.smelting": "Ensine-me a fundir minério. (100 de cobre)",
    "npc.smith.option.sword": "Ensine-me a forjar uma espada. (1100 de cobre)",
    "npc.smith.option.bye": "Outra hora.",
    "npc.smith.taught": "Observe a cor do metal, não o relógio. Agora é seu.",
    "npc.smith.option.metals": "Sobre metais e lingotes.",
    "npc.smith.option.learn_copper_ingot": "Ensine-me o lingote de cobre. (50 de cobre)",
    "npc.smith.option.learn_silver_ingot": "Ensine-me o lingote de prata. (1000 de cobre)",
    "npc.smith.option.melee": "Sobre armas corpo a corpo.",
    "npc.smith.option.learn_iron_axe": "Ensine-me o machado de ferro. (1400 de cobre)",
    "npc.smith.option.learn_iron_spear": "Ensine-me a lança de ferro. (1300 de cobre)",
    "npc.smith.option.learn_stone_hammer": "Ensine-me o martelo de pedra. (850 de cobre)",
    "npc.smith.option.learn_iron_hammer": "Ensine-me o martelo de ferro. (1550 de cobre)",
    "npc.smith.option.ranged": "Sobre arcos e cajados.",
    "npc.smith.option.learn_wooden_bow": "Ensine-me o arco de madeira. (700 de cobre)",
    "npc.smith.option.learn_iron_bow": "Ensine-me o arco de ferro. (1350 de cobre)",
    "npc.smith.option.learn_oak_staff": "Ensine-me o cajado de carvalho. (800 de cobre)",
    "npc.smith.option.learn_iron_staff": "Ensine-me o cajado de ferro. (1450 de cobre)",
    "npc.smith.option.armor": "Sobre armaduras.",
    "npc.smith.option.learn_cloth_tunic": "Ensine-me a túnica de tecido. (550 de cobre)",
    "npc.smith.option.learn_studded_leather": "Ensine-me o couro com tachas. (1000 de cobre)",
    "npc.smith.option.learn_iron_chainmail": "Ensine-me a cota de malha de ferro. (1200 de cobre)",
    "npc.smith.option.learn_iron_plate_armor": "Ensine-me a armadura de placas de ferro. (2300 de cobre)",
    "npc.smith.lessons": "Qual ofício você quer aprender?",
    "npc.smith.option.back": "Outra coisa.",
    "npc.herbalist.option.lessons": "Pode me ensinar poções?",
    "npc.herbalist.lessons": "Raízes e flores podem curar ou afiar um corpo. Qual preparo?",
    "npc.herbalist.taught": "Cuide do fogo e da medida. Agora é seu.",
    "npc.herbalist.option.back": "Outra coisa.",
    "npc.herbalist.option.learn_minor_health_potion": "Ensine-me a poção de vida menor. (200 de cobre)",
    "npc.herbalist.option.learn_vigor_elixir": "Ensine-me o elixir de vigor. (300 de cobre)",
    "npc.herbalist.option.learn_mana_tonic": "Ensine-me o tônico de mana. (300 de cobre)",
    "npc.herbalist.option.learn_minor_heal": "Ensine-me a curar com luz. (300 de cobre)",
    "npc.herbalist.option.learn_revival_draught": "Ensine-me a poção de reanimação. (500 de cobre)",
    "npc.herbalist.option.learn_health_potion": "Ensine-me a poção de vida. (500 de cobre)",
    "npc.herbalist.option.learn_greater_vigor_elixir": "Ensine-me o elixir de vigor maior. (800 de cobre)",
    "npc.herbalist.option.learn_greater_health_potion": "Ensine-me a poção de vida maior. (1000 de cobre)",
    "npc.summoner.name": "Invocador",
    "npc.summoner.greeting": "Você acordou. Respire. O círculo trouxe você do seu mundo para o nosso, como trouxe os outros.",
    "npc.summoner.what": "Aurelia pediu ajuda e o círculo respondeu com você. Ninguém pode mandá-lo de volta. Mas aqui você pode ficar forte.",
    "npc.summoner.system": "O Sistema é a voz que os invocados ouvem. Ele conta seus feitos e dá títulos. Um já é seu.",
    "npc.summoner.offer": "Primeiro aprenda a ficar de pé. Veja o instrutor no pátio, a leste, depois o guia no campo ao sul do portão. Quando estiver pronto, a Guilda vai registrá-lo.",
    "npc.summoner.accepted": "Vá. As marcas acima das pessoas que você precisa ver vão guiá-lo.",
    "npc.summoner.next": "O instrutor no pátio, a leste; o guia no campo ao sul do portão; três caudas de rato; depois a sede da Guilda, a noroeste.",
    "npc.summoner.option.what": "O que aconteceu comigo?",
    "npc.summoner.option.system": "Que voz é essa na minha cabeça?",
    "npc.summoner.option.begin": "O que devo fazer agora?",
    "npc.summoner.option.next": "Para onde vou depois?",
    "npc.summoner.option.accept": "Estou pronto.",
    "npc.summoner.option.back": "Tenho outra pergunta.",
    "npc.summoner.option.bye": "Depois.",
    "npc.instructor.name": "Instrutor",
    "npc.instructor.greeting": "Mais um do círculo. Punhos erguidos. Ninguém sai do meu pátio sem saber chutar.",
    "npc.instructor.taught": "Isso é um Chute. Arraste-o da janela de técnicas para a barra de baixo e aperte o número dele numa luta.",
    "npc.instructor.fight": "Clique numa criatura para atacá-la; você continua golpeando sozinho. Se algo o atingir, você revida. Olhe sua vida e recue quando estiver baixa.",
    "npc.instructor.option.teach": "Ensine-me a lutar.",
    "npc.instructor.option.fight": "Como funciona uma luta?",
    "npc.instructor.option.back": "Outra coisa.",
    "npc.instructor.option.bye": "Obrigado.",
    "npc.guild_clerk.name": "Escriturário da Guilda",
    "npc.guild_clerk.greeting": "Guilda dos Aventureiros de Aurelia. Registro, trabalho e pagamento, nessa ordem.",
    "npc.guild_clerk.registered": "Nome anotado, carteirinha carimbada. Bem-vindo à Guilda, aventureiro. Peça trabalho sempre que precisar de moedas.",
    "npc.guild_clerk.not_yet": "O invocador ainda não terminou com você. Volte quando tiver feito o que foi pedido.",
    "npc.guild_clerk.work": "Goblins desceram para as colinas de sarça a leste do campo, e os tecelões pagam por seda de aranha das mesmas colinas.",
    "npc.guild_clerk.taken": "Anotado. Traga a prova e você recebe.",
    "npc.guild_clerk.paid": "Contado e pago. Bom trabalho.",
    "npc.guild_clerk.option.register": "Quero me registrar.",
    "npc.guild_clerk.option.not_yet": "Vim me registrar.",
    "npc.guild_clerk.option.work": "Há trabalho?",
    "npc.guild_clerk.option.take_goblins": "Eu cuido dos goblins.",
    "npc.guild_clerk.option.take_silk": "Eu trago seda de aranha.",
    "npc.guild_clerk.option.ears": "Trouxe orelhas de goblin.",
    "npc.guild_clerk.option.silk": "Trouxe seda de aranha.",
    "npc.guild_clerk.option.back": "Outra coisa.",
    "npc.guild_clerk.option.bye": "Adeus.",
    "npc.guide.option.sent": "O invocador me mandou.",
    "npc.guide.rats": "Ratos roem as plantações fora deste portão. Traga três caudas para provar que sabe lutar. O mercador do mercado, a oeste da praça, compra o que você saquear.",
    // Alpha world NPCs.
    "npc.captain.name": "Capitão",
    "npc.captain.greeting": "Mantenha a lâmina pronta além deste portão. Os campos não são tão calmos quanto parecem.",
    "npc.captain.work": "Lobos nos campos, e bandidos em Whisperwood, a oeste. O patrulheiro da cabana conhece o bosque.",
    "npc.captain.taken": "Bom. Volte para contar quando terminar.",
    "npc.captain.paid": "A cidade lhe deve. Aqui está o seu pagamento.",
    "npc.captain.option.work": "Algum trabalho para mim?",
    "npc.captain.option.pelts": "Trouxe as peles de lobo.",
    "npc.captain.option.badges": "Trouxe as insígnias de bandido.",
    "npc.captain.option.take_wolves": "Eu caço os lobos.",
    "npc.captain.option.take_patrol": "Eu encontro o patrulheiro.",
    "npc.captain.option.take_bandits": "Eu cuido dos bandidos.",
    "npc.captain.option.back": "Outra coisa.",
    "npc.captain.option.bye": "Adeus.",
    "npc.ranger.name": "Patrulheiro",
    "npc.ranger.greeting": "Passos silenciosos, estranho. A floresta escuta.",
    "npc.ranger.forest": "Lobos atrozes têm covil ao sul daqui, e os bandidos acampam além deles. Fenmoor fica para além dos campos, ao sudeste.",
    "npc.ranger.taken": "Traga as presas deles e eu pago.",
    "npc.ranger.paid": "Menos lobos, estradas mais seguras. Pegue isto.",
    "npc.ranger.option.patrol": "O capitão me mandou.",
    "npc.ranger.option.forest": "O que há nestes bosques?",
    "npc.ranger.option.take_fangs": "Eu caço os lobos atrozes.",
    "npc.ranger.option.fangs": "Trouxe presas atrozes.",
    "npc.ranger.option.back": "Outra coisa.",
    "npc.ranger.option.bye": "Adeus.",
    "npc.foreman.name": "Capataz",
    "npc.foreman.greeting": "Stonebrook escava, Stonebrook paga. Procura trabalho?",
    "npc.foreman.work": "As minas ao norte da cidade estão cheias de morcegos e kobolds, e algo grande acordou no fundo.",
    "npc.foreman.taken": "A entrada da mina fica na estrada do norte. Cuidado com a cabeça.",
    "npc.foreman.paid": "Trabalho justo, pagamento justo.",
    "npc.foreman.option.sent": "A guilda me mandou.",
    "npc.foreman.option.work": "Algum trabalho nas minas?",
    "npc.foreman.option.wings": "Trouxe asas de morcego.",
    "npc.foreman.option.candles": "Trouxe velas de kobold.",
    "npc.foreman.option.core": "Trouxe o núcleo do golem.",
    "npc.foreman.option.take_wings": "Eu limpo os morcegos.",
    "npc.foreman.option.take_candles": "Eu expulso os kobolds.",
    "npc.foreman.option.take_core": "Eu enfrento o golem.",
    "npc.foreman.option.back": "Outra coisa.",
    "npc.foreman.option.bye": "Adeus.",
    "npc.quartermaster.name": "Intendente",
    "npc.fen_elder.name": "Ancião",
    "npc.fen_elder.greeting": "Cuidado com as passarelas. O pântano guarda o que cai nele.",
    "npc.fen_elder.work": "Nosso remédio precisa de pernas de rã e geleia de lodo, nossas lamparinas precisam de luz de fátua, e a bruxa da ilha oeste amaldiçoa todos nós.",
    "npc.fen_elder.taken": "Que as tábuas aguentem você.",
    "npc.fen_elder.paid": "Fenwick agradece.",
    "npc.fen_elder.option.letter": "A herborista de Aurelia manda lembranças.",
    "npc.fen_elder.option.work": "Posso ajudar a vila?",
    "npc.fen_elder.option.remedy": "Trouxe o que o remédio precisa.",
    "npc.fen_elder.option.charm": "Trouxe o amuleto da bruxa.",
    "npc.fen_elder.option.essence": "Trouxe essência de fátua.",
    "npc.fen_elder.option.take_remedy": "Eu colho para o remédio.",
    "npc.fen_elder.option.take_hag": "Eu enfrento a bruxa.",
    "npc.fen_elder.option.take_wisps": "Eu capturo a luz das fátuas.",
    "npc.fen_elder.option.back": "Outra coisa.",
    "npc.fen_elder.option.bye": "Adeus.",
    "npc.fen_trader.name": "Comerciante",
    "npc.guild_clerk.option.take_stonebrook": "Eu vou para Stonebrook.",
    "npc.herbalist.option.letter": "Precisa de algo levado?",
    "npc.herbalist.letter": "Sim! Leve minhas saudações ao ancião de Fenwick, no pântano ao sul dos campos.",
}
