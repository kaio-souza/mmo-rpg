// Kit texts (System messages, moderation, appearance names): every game needs them. Errors are in error.ron.
{
    "admin.bad_reason": (text: "Unknown reason: {reason}.", note: "Admin command with a reason not in the list; {reason}: what was typed.", max_chars: 100),
    "admin.banned": (text: "{name} is banned.", note: "Admin command result: account banned; {name}: character.", max_chars: 100),
    "admin.kicked": (text: "{name} was disconnected.", note: "Admin command result: the character was dropped; {name}: character.", max_chars: 100),
    "admin.maintenance": (text: "Restart announced in {seconds} s.", note: "Admin command result: restart scheduled; {seconds}: delay.", max_chars: 100),
    "admin.maintenance_cancelled": (text: "Restart called off.", note: "Admin command result: the announced restart was cancelled.", max_chars: 100),
    "admin.muted": (text: "{name} is muted.", note: "Admin command result: chat muted; {name}: character.", max_chars: 100),
    "admin.replay": (text: "The zone saved its replay.", note: "Admin command result: replay written to disk.", max_chars: 100),
    "admin.suspended": (text: "{name} is suspended.", note: "Admin command result: account suspended; {name}: character.", max_chars: 100),
    "admin.who": (text: "{name}: account {account}, zone {zone}, tile {x}, {y}.", note: "Admin /who answer; {name}: character; {account}: account name; {zone}: zone id; {x} {y}: tile.", max_chars: 100),
    "appearance.body.body_a": (text: "Build A", note: "Body type option (neutral: no gender, no attribute).", max_chars: 20),
    "appearance.body.body_b": (text: "Build B", note: "Body type option (neutral: no gender, no attribute).", max_chars: 20),
    "appearance.hair_color.auburn": (text: "Auburn", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.black": (text: "Black", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.blonde": (text: "Blonde", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.blue": (text: "Blue", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.chestnut": (text: "Chestnut", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.dark_brown": (text: "Dark brown", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.gray": (text: "Gray", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.green": (text: "Green", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.red": (text: "Red", note: "Hair color option.", max_chars: 20),
    "appearance.hair_color.white": (text: "White", note: "Hair color option.", max_chars: 20),
    "appearance.hair_style.bald": (text: "Bald", note: "Hairstyle option.", max_chars: 20),
    "appearance.hair_style.braid": (text: "Braid", note: "Hairstyle option.", max_chars: 20),
    "appearance.hair_style.curly": (text: "Curly", note: "Hairstyle option.", max_chars: 20),
    "appearance.hair_style.long": (text: "Long", note: "Hairstyle option.", max_chars: 20),
    "appearance.hair_style.ponytail": (text: "Ponytail", note: "Hairstyle option.", max_chars: 20),
    "appearance.hair_style.short": (text: "Short", note: "Hairstyle option.", max_chars: 20),
    "appearance.hair_style.spiky": (text: "Spiky", note: "Hairstyle option.", max_chars: 20),
    "appearance.hair_style.topknot": (text: "Topknot", note: "Hairstyle option.", max_chars: 20),
    "appearance.skin.skin_1": (text: "Tone 1", note: "Skin tone option.", max_chars: 20),
    "appearance.skin.skin_2": (text: "Tone 2", note: "Skin tone option.", max_chars: 20),
    "appearance.skin.skin_3": (text: "Tone 3", note: "Skin tone option.", max_chars: 20),
    "appearance.skin.skin_4": (text: "Tone 4", note: "Skin tone option.", max_chars: 20),
    "appearance.skin.skin_5": (text: "Tone 5", note: "Skin tone option.", max_chars: 20),
    "appearance.skin.skin_6": (text: "Tone 6", note: "Skin tone option.", max_chars: 20),
    "chat.reported": (text: "Report about {name} sent. A moderator will read it.", note: "Confirmation of /report; {name}: reported character.", max_chars: 100),
    "moderation.reason.botting": "Botting",
    "moderation.reason.cheating": "Cheating",
    "moderation.reason.exploit": "Exploiting a bug",
    "moderation.reason.harassment": "Harassment",
    "moderation.reason.offensive_name": "Offensive name",
    "moderation.reason.other": "Other",
    "moderation.reason.spam": "Spam",
    "system.appraise_class_only": (text: "Only a production class can appraise. A smith appraises for a fee.", note: "Appraisal refused: the character has no production class; NPC smiths appraise for coins.", max_chars: 100),
    "system.appraise_failed": (text: "The {item} keeps its secrets. Try again after leveling.", note: "Appraisal failed; can be tried again after leveling. {item}: item name.", max_chars: 80),
    "system.appraised": (text: "You see through the {item}.", note: "Appraisal worked; {item}: item name.", max_chars: 60),
    "system.appraised_paid": (text: "{item} appraised for {coins} copper.", note: "An appraisal paid at an NPC shop; {item}: item name; {coins}: copper paid.", max_chars: 90),
    "system.bought": (text: "Bought {item} x{qty} for {coins} copper.", note: "A purchase at an NPC shop; {item}: item name; {qty}: pieces; {coins}: copper paid.", max_chars: 90),
    "system.class_chosen": (text: "You are now a {name}.", note: "A class chosen. {name}: class name.", max_chars: 60),
    "system.classes_available": (text: "The System offers you a class ({count} available).", note: "The System offers classes; {count}: how many.", max_chars: 70),
    "system.craft_busy": (text: "The workbench is getting ready. Try again in a moment.", note: "Crafting refused for a moment: the zone is fetching item ids.", max_chars: 90),
    "system.craft_material": (text: "Missing {item}: it needs {need} and you carry {have}. Worn or equipped pieces do not count.", note: "Crafting refused: a material is short; {item}: material; {need}: needed; {have}: in the backpack.", max_chars: 120),
    "system.craft_needs_workshop": (text: "Only a production class crafts anywhere. Go to a workshop: a forge or a workbench.", note: "Crafting refused outside a workshop for a character without a production class.", max_chars: 110),
    "system.craft_points": (text: "You need {proficiency} {points} to make that.", note: "Crafting refused: proficiency too low; {proficiency}: name; {points}: points needed.", max_chars: 90),
    "system.craft_unknown": (text: "You do not know that recipe yet. An NPC teaches it.", note: "Crafting refused: recipe not learned.", max_chars: 90),
    "system.crafted": (text: "Made {item} x{qty}.", note: "A craft finished; {item}: item name; {qty}: pieces made.", max_chars: 80),
    "system.died": (text: "You died. Your soul rests for {hours} h.", note: "Death for real; {hours}: hours the character must rest.", max_chars: 100),
    "system.durability_low": (text: "{item} is at {percent}% durability.", note: "Warning while equipment wears out; {item}: item name; {percent}: durability left, in percent.", max_chars: 90),
    "system.escrow_no_room": (text: "Items are kept for you, but your backpack is full.", note: "A parcel in custody did not fit; it stays there for the next entry.", max_chars: 80),
    "system.escrow_received": (text: "What was kept for you has arrived.", note: "A parcel waiting in custody was put in the backpack on entering.", max_chars: 60),
    "system.escrow_returned": (text: "Sending refused: everything is back in your backpack.", note: "Custody refused the deposit (unknown recipient or a database error); nothing was lost.", max_chars: 80),
    "system.escrow_sent": (text: "Sent. It is kept in custody until the recipient enters the game.", note: "A deposit into custody was written; the recipient gets it on entering.", max_chars: 80),
    "system.fallen": (text: "You have fallen. Help has {seconds} s to reach you.", note: "HP reached zero; {seconds}: wait for help before death.", max_chars: 90),
    "system.healed_by": (text: "{name} heals you: +{hp} HP.", note: "Another player healed this one; {name}: who; {hp}: life restored.", max_chars: 60),
    "system.item_broken": (text: "{item} broke beyond repair.", note: "An equipped piece reached zero durability and was destroyed; {item}: item name.", max_chars: 90),
    "system.item_used": (text: "{item}: +{hp} HP, +{vigor} Vigor.", note: "A consumable was used; {item}: item name; {hp}: HP restored; {vigor}: vigor restored.", max_chars: 80),
    "system.item_used_mp": (text: "{item}: +{mp} MP.", note: "A consumable restoring only MP was used; {item}: item name; {mp}: MP restored.", max_chars: 80),
    "system.level_lost": (text: "Your soul weakens: you drop to level {level}.", note: "Death cost a level. {level} is the level now.", max_chars: 70),
    "system.level_up": (text: "Level up! You are now level {level}.", note: "Level up. {level} is the new level.", max_chars: 60),
    "system.not_enough_coins": (text: "Not enough coins: it costs {price} copper and you have {coins}.", note: "Buying, repairing or appraising refused for lack of coins; {price}: cost; {coins}: what the player holds.", max_chars: 100),
    "system.party_joined": (text: "{name} joined the group.", note: "Told to the group; {name}: who joined.", max_chars: 60),
    "system.party_left": (text: "{name} left the group.", note: "Told to the group; {name}: who left or was removed.", max_chars: 60),
    "system.points": (text: "Attribute points gained: {count}.", note: "Free attribute points gained; {count} is how many.", max_chars: 60),
    "system.proficiency_up": (text: "{name} rose to {value}.", note: "A proficiency rose. {name}: proficiency name; {value}: new value.", max_chars: 60),
    "system.repaired": (text: "{item} repaired for {coins} copper.", note: "A repair at an NPC; {item}: item name; {coins}: copper paid.", max_chars: 90),
    "system.revive_done": (text: "You stand {name} up.", note: "This player revived a fallen one; {name}: who.", max_chars: 60),
    "system.revived": (text: "You wake up at the sanctuary, unharmed.", note: "Newbie protection: back at the sanctuary without loss.", max_chars: 80),
    "system.revived_by": (text: "{name} stands you up. You are back on your feet.", note: "A player used a revival item on this fallen player; {name}: who.", max_chars: 90),
    "system.self_repair_class_only": (text: "Only a production class mends its own pieces. Others pay a smith.", note: "Self repair refused: not a production class.", max_chars: 100),
    "system.self_repair_material": (text: "Mending needs {need} {material}; you carry {have}.", note: "Self repair refused for lack of the material; {material}: name; {need}: needed; {have}: held.", max_chars: 90),
    "system.self_repair_no_recipe": (text: "{item} has no recipe: only a smith can mend it.", note: "Self repair refused: nothing crafts that item; {item}: item name.", max_chars: 90),
    "system.self_repair_points": (text: "You need {proficiency} {points} to mend that.", note: "Self repair refused: proficiency below the recipe's.", max_chars: 90),
    "system.self_repaired": (text: "{item} mended with {qty} {material}.", note: "Self repair done; {item}: item; {qty}: how many; {material}: material name.", max_chars: 90),
    "system.shop_purse_empty": (text: "The merchant can only pay {coins} more copper. Come back in {minutes} min or sell in another town.", note: "A sale refused: the shop's purse for this player is spent; {coins}: copper it still pays; {minutes}: minutes until it refills.", max_chars: 120),
    "system.sold": (text: "Sold {item} x{qty} for {coins} copper.", note: "A sale to an NPC shop; {item}: item name; {qty}: pieces; {coins}: copper received.", max_chars: 90),
    "system.technique_unlocked": (text: "New technique: {name}.", note: "A new technique learned. {name}: technique name.", max_chars: 60),
    "system.technique_up": (text: "{name} reached level {level}.", note: "A technique rose. {name}: technique; {level}: its level.", max_chars: 60),
    "system.title": (text: "Title earned: {name}.", note: "A title earned. {name}: title name.", max_chars: 60),
    "system.title_replaced": (text: "{old} became {new}.", note: "A title replaced by a higher one, which takes its place. {old}: title lost; {new}: title earned.", max_chars: 60),
    "system.trade_cancelled": (text: "Trade cancelled.", note: "The trade ended: cancelled, too far, in a fight, or someone left.", max_chars: 40),
    "system.trade_done": (text: "Trade completed.", note: "Both players confirmed and the items changed hands.", max_chars: 40),
    "system.trade_expired": (text: "The trade expired.", note: "Nobody touched the trade for 30 seconds.", max_chars: 40),
    "system.vow_taken": (text: "{technique}: your defense rises for {seconds} s.", note: "A buff technique was used; {technique}: its name; {seconds}: how long.", max_chars: 90),
    "system.xp": (text: "+{amount} XP", note: "Experience from a kill; {amount}: points.", max_chars: 40),
    "system.world_title": (text: "{player} earned the title {title}!", note: "Told to the whole server: a character earned a title announced to everyone. {player}: character; {title}: title name.", max_chars: 90),
    "system.server_first": (text: "Server first! {player} is the first to earn {title}.", note: "Told to the whole server once: the first character of the server to earn a title. {player}: character; {title}: title name.", max_chars: 100),
    "system.ranking_none": (text: "This world has no rankings.", note: "Answer to /ranking when the game has no rankings.", max_chars: 60),
    "system.ranking_entry": (text: "/ranking {id}: {name}", note: "One line of the list of rankings (/ranking). {id}: what to type, kept as is; {name}: ranking name.", max_chars: 70),
    "system.ranking_unknown": (text: "No ranking called {id}. Type /ranking for the list.", note: "/ranking with an id that does not exist. {id}: what was typed.", max_chars: 80),
    "system.ranking_empty": (text: "{name}: nobody yet.", note: "A ranking nobody is on yet. {name}: ranking name.", max_chars: 60),
    "system.ranking_head": (text: "Ranking: {name}", note: "First line of a ranking shown in the chat. {name}: ranking name.", max_chars: 60),
    "system.ranking_line": (text: "{place}. {player}: {value}", note: "One line of a ranking. {place}: position; {player}: character; {value}: its score.", max_chars: 60),
    "system.first_line": (text: "{title}: first earned by {player}.", note: "One line of /firsts. {title}: title name; {player}: the character who earned it first.", max_chars: 80),
    "system.first_none": (text: "No server firsts yet.", note: "Answer to /firsts when no server first exists yet.", max_chars: 60),
    "system.goal_progress": (text: "Server goal {goal}: {percent}% done. Keep going!", note: "Told to the whole server when a shared server goal passes a quarter. {goal}: goal name; {percent}: 25, 50 or 75.", max_chars: 100),
    "system.goal_done": (text: "The whole server reached the goal {goal}!", note: "Told to the whole server once, when a shared server goal is reached. {goal}: goal name.", max_chars: 100),
    "system.goal_none": (text: "This world has no server goals.", note: "Answer to /goals when the game has no server goals.", max_chars: 60),
    "system.goal_line": (text: "{goal}: {progress} of {target}.", note: "One line of /goals: a server goal not reached yet. {goal}: goal name; {progress}: what the whole server did so far; {target}: what it must reach.", max_chars: 80),
    "system.goal_line_done": (text: "{goal}: reached!", note: "One line of /goals: a server goal already reached. {goal}: goal name.", max_chars: 80),
    "system.goal_desc": (text: "  {desc}", note: "One line of /goals under a goal: its description, indented. {desc}: goal description.", max_chars: 200),
    "system.unique_lost": (text: "{name} belongs to someone else now.", note: "The character lost a unique title or class: another character of the server holds it now. {name}: title or class name.", max_chars: 90),
    "system.status_poison": (text: "Poisoned for {seconds} s.", note: "The character was poisoned and loses HP every second. {seconds}: how long.", max_chars: 60),
    "system.status_stun": (text: "Stunned for {seconds} s.", note: "The character is stunned: cannot act or move. {seconds}: how long.", max_chars: 60),
    "system.status_slow": (text: "Slowed for {seconds} s.", note: "The character is slowed: attacks come slower. {seconds}: how long.", max_chars: 60),
    "system.boss_phase": (text: "{name} grows fiercer!", note: "A monster the character fights changed phase and fights harder. {name}: monster name.", max_chars: 70),
    "system.dungeon_requirements": (text: "{name} needs level {min} to {max} and a group of {party_min} to {party_max}.", note: "A dungeon door refused the character. {name}: dungeon; {min}-{max}: level range; {party_min}-{party_max}: group size (1 is alone).", max_chars: 120),
    "system.dungeon_locked": (text: "You cleared {name} recently. Come back in {hours} h.", note: "The character cleared this dungeon recently and must wait. {name}: dungeon; {hours}: hours left.", max_chars: 90),
    "system.dungeon_cleared": (text: "{name} cleared in {seconds} s!", note: "The group killed the dungeon's boss. {name}: dungeon; {seconds}: how long the run took.", max_chars: 80),
    "system.dungeon_first": (text: "Server first! {party} cleared {name}.", note: "Told to the whole server once: the first group to clear a dungeon. {party}: character names; {name}: dungeon.", max_chars: 110),
    "system.unique_item_exists": (text: "{name} already exists in this world.", note: "A unique item cannot be crafted: one piece already exists on the server. {name}: item name.", max_chars: 80),
}
