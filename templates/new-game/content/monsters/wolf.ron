// The only enemy of the starting area. Drops its pelt and, sometimes, a potion.
(
    level: 2, hp: 28, attributes: (str: 6, vit: 5, agi: 6, dex: 5),
    damage: (2, 4), defense: 1, attack_ticks: 30,
    aggro_radius: 4, leash: 14, respawn_ticks: 400, xp: 40, sprite: "wolf", icon: "wolf",
    coins: (2, 8),
    loot: [
        (item: "wolf_pelt", chance: 600),
        (item: "health_potion", chance: 150),
        (item: "mana_tonic", chance: 100),
        (item: "vigor_elixir", chance: 100),
    ],
    // Right click a wolf below a third of its HP and choose Tame. A game
    // may ask for more: a taming skill, a class, a title, a bait item.
    tame: Some((requires: [Level(3)], below_hp_permille: 330, chance_permille: 400)),
)
