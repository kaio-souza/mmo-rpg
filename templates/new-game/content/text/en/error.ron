{
    "error.incompatible_version": (text: "Your game version does not match the server. Please update.", note: "Client and server versions differ; the player must update.", max_chars: 80),
    "error.not_allowed": (text: "That is not allowed here.", note: "The action is not allowed here (for example a developer login on a public server).", max_chars: 80),
    "error.invalid_name": (text: "That name is not allowed.", note: "The name breaks the naming rules.", max_chars: 80),
    "error.name_taken": (text: "That name is already taken.", note: "Another character already has this name.", max_chars: 80),
    "error.too_fast": (text: "Slow down: too many actions at once.", note: "The client sent messages too quickly.", max_chars: 80),
    "error.invalid_message": (text: "The server could not understand the client.", note: "The client sent something the server could not read.", max_chars: 80),
    "error.server_full": (text: "The server is full.", note: "The server has no room for more players.", max_chars: 80),
    "error.zone_busy": (text: "This area is too busy right now.", note: "The area is overloaded right now.", max_chars: 80),
    "error.zone_failure": (text: "This area crashed. You return from the last save.", note: "The area crashed; the character returns from the last save.", max_chars: 80),
    "error.account_taken": (text: "That account name is already taken.", note: "Another account already has this name.", max_chars: 80),
    "error.wrong_credentials": (text: "Wrong account or password.", note: "Account or password is wrong (the same message for both on purpose).", max_chars: 80),
    "error.too_many_attempts": (text: "Too many attempts. Try again in {seconds} s.", note: "Too many tries; {seconds} is the wait in seconds.", max_chars: 80),
    "error.session_expired": (text: "Your login expired. Please log in again.", note: "The saved login is no longer valid; log in again.", max_chars: 80),
    "error.too_many_characters": (text: "This account already has the maximum number of characters.", note: "The account has the maximum number of characters.", max_chars: 80),
    "error.already_online": (text: "A character of this account is already in the game.", note: "A character of this account is already in the game.", max_chars: 80),
    "error.no_such_character": (text: "That character does not exist on this account.", note: "The chosen character does not exist or is not of this account.", max_chars: 80),
    "error.internal": (text: "Server error. Please try again later.", note: "The server failed; try again later.", max_chars: 80),
    "error.account_suspended": "This account is suspended. Try again in {seconds} s. Reason: {reason}",
    "error.account_banned": "This account is banned. Reason: {reason}",
    "error.ip_blocked": "Your connection is blocked. Try again in {seconds} s.",
    "error.password_change_required": "Change your password before playing.",
    "error.too_far": (text: "You are too far away.", note: "Talking to an NPC that is not close enough.", max_chars: 80),
    "error.no_dialogue": (text: "There is nothing to talk about.", note: "The target has no dialogue, or the dialogue is closed.", max_chars: 80),
    "error.inventory_full": (text: "Your backpack is full.", note: "A dialogue option or quest reward does not fit in the backpack; nothing happened.", max_chars: 80),
    "error.requirements_not_met": (text: "You cannot do that now.", note: "A dialogue option cannot be done (missing item, coins, or quest state); nothing happened.", max_chars: 80),
    "error.invalid_slot": (text: "There is nothing to move there.", note: "Moving an item from an empty or invalid backpack slot.", max_chars: 80),
    "error.invalid_target": (text: "You cannot attack that.", note: "Attack or technique on a target that cannot be fought here.", max_chars: 80),
    "error.not_ready": (text: "Not ready yet.", note: "Technique on cooldown, not learned, or not enough vigor.", max_chars: 80),
    "error.fallen": (text: "You have fallen and cannot act.", note: "Fallen characters cannot act.", max_chars: 80),
    "error.character_resting": (text: "This character's soul rests for {hours} more h.", note: "The character died and rests; {hours}: hours left. Other characters may play.", max_chars: 100),
    "error.muted": (text: "You are muted for {seconds} more s.", note: "Chat refused: the account is muted; {seconds}: seconds left.", max_chars: 80),
    "error.player_offline": (text: "That player is not online.", note: "Whisper, report or admin command naming a character that is not online.", max_chars: 80),
    "error.no_shop": (text: "There is no shop here.", note: "Opening a shop on someone who keeps none, or trading with no shop open.", max_chars: 80),
    "error.not_enough_coins": (text: "Not enough coins.", note: "The purchase or the repair costs more coins than the player has.", max_chars: 80),
    "error.out_of_stock": (text: "The shop has none left.", note: "The shop ran out of that line.", max_chars: 80),
    "error.not_traded": (text: "That cannot be traded here.", note: "The shop does not deal in that item, or the piece needs no repair.", max_chars: 80),
    "error.cannot_craft": (text: "You cannot make that now: the System message says why.", note: "Recipe not known, or the materials are missing.", max_chars: 80),
    "error.nothing_to_gather": (text: "There is nothing to gather here.", note: "The node is out of reach or still empty for this character.", max_chars: 80),
    "error.nothing_to_use": (text: "There is nothing to use there.", note: "Clicked a tile that cannot be switched (a brazier is lit or put out by clicking it).", max_chars: 80),
    "error.password_has_name": (text: "The password cannot contain the account name.", note: "Registering or changing the password: the new password contains the account name.", max_chars: 80),
    "error.no_party": (text: "You have no group invite to answer, or you are not the leader.", note: "A group command with no group, no invite, or without being the leader.", max_chars: 80),
    "error.party_full": (text: "The group is full.", note: "The group already has six members.", max_chars: 40),
    "error.no_trade": (text: "There is no open trade.", note: "An offer or confirmation with no trade open.", max_chars: 40),
    "error.trade_changed": (text: "The trade could not be completed; nothing changed.", note: "The offers no longer hold or do not fit in the backpack.", max_chars: 80),
}
