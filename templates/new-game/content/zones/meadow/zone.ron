// The only area of a new game. Players appear on the plaza, which is safe.
(
    origin: (x: 0, y: 0),
    view_radius: 20,
    spawn: (x: 20, y: 15),
    spawn_radius: 2,
    regions: [
        (kind: Safe, min: (x: 16, y: 12), max: (x: 24, y: 18)),
        // The plaza is also a workshop: anyone may craft there.
        (kind: Workshop, min: (x: 16, y: 12), max: (x: 24, y: 18)),
    ],
    // Picture only: some hours rain, a few are foggy.
    weather: [(kind: Rain, permille: 150), (kind: Fog, permille: 80)],
)
