    "editor.map.world": (text: "Place in the world", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.map.world_hint": (text: "Drag the blue zone to move it. Zones may touch but never overlap; a passage is a gap in both walls.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.world_overlap": (text: "Overlaps {zones}: move it before saving.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
