    "editor.languages": (text: "Languages", note: "Rail button and title of the screen that manages the game's languages.", max_chars: 30),
    "editor.langs.add": (text: "Add language", note: "Button: add a language to the game.", max_chars: 40),
    "editor.langs.bad_code": (text: "Use a language code like fr, pl or pt-PT: letters, digits and dashes, starting with a letter.", note: "Error under the language code field.", max_chars: 120),
    "editor.langs.code": (text: "Language code", note: "Label of the language code field.", max_chars: 40),
    "editor.langs.code_hint": (text: "Type or pick a code. The name of the language shows here.", note: "Hint under the empty language code field.", max_chars: 120),
    "editor.langs.content": (text: "Game texts", note: "Label of a progress bar: share of game content texts translated.", max_chars: 40),
    "editor.langs.down": (text: "Move down", note: "Tooltip: move the language down in the list.", max_chars: 40),
    "editor.langs.up": (text: "Move up", note: "Tooltip: move the language up in the list.", max_chars: 40),
    "editor.langs.intro": (text: "The languages the game offers, in the order of the language list. A required language must be fully translated before content passes the check; an optional one may miss texts, which then show in English.", note: "Explanation at the top of the languages screen.", max_chars: 300),
    "editor.langs.optional": (text: "Optional", note: "Chip: the language is optional (missing texts show in English).", max_chars: 20),
    "editor.langs.required": (text: "Required", note: "Checkbox and chip: the language must be fully translated.", max_chars: 20),
    "editor.langs.required_hint": (text: "a missing text stops the content check", note: "Hint next to the 'Required' checkbox.", max_chars: 120),
    "editor.langs.source": (text: "the source language, always required", note: "Hint next to English: it is the source language, always required.", max_chars: 120),
    "editor.langs.remove": (text: "Remove", note: "Button: remove a language from the list.", max_chars: 30),
    "editor.langs.remove_folder": (text: "It already has texts in text/{code}/: delete that folder first.", note: "Tooltip of the disabled remove button. {code} is a language code.", max_chars: 160),
    "editor.langs.rules": (text: "Plural: {plural} · decimal {decimal} · thousands {group}", note: "Number rules of a language. {plural} is a rule name, {decimal} and {group} are characters; keep them.", max_chars: 120),
    "editor.langs.rules_missing": (text: "No plural and number rules yet: English ones are used", note: "Warning: the game has no plural/number rules for this language yet.", max_chars: 120),
    "editor.langs.rules_ok": (text: "plural and number rules known", note: "The game knows the plural/number rules of this language.", max_chars: 80),
    "editor.langs.saved": (text: "Language list saved", note: "Toast after saving the language list.", max_chars: 60),
    "editor.langs.taken": (text: "This language is already in the list.", note: "Error: the language code is already in the list.", max_chars: 80),
    "editor.langs.translate": (text: "Translate", note: "Button: open the translation screen for this language.", max_chars: 30),
    "editor.langs.ui": (text: "Interface texts", note: "Label of a progress bar: share of the game client's interface texts translated.", max_chars: 40),
    "editor.langs.ui_hint": (text: "Interface texts live in assets/text/<code>/ui.ron and are built into the game client: after adding a language, add that file and rebuild the client. Until then the interface shows in English.", note: "Hint at the bottom of the languages screen.", max_chars: 300),
    "editor.langs.unsaved": (text: "Not saved yet", note: "Shown for a language added but not saved yet.", max_chars: 60),
    "editor.sounds": (text: "Sounds", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.sounds.intro": (text: "Which sound plays for each event of the game. The game picks one of the variations each time. Files are OGG Vorbis, mono or stereo, 44 100 Hz.", note: "Label of the content editor (a tool for game designers).", max_chars: 200),
    "editor.sounds.events": (text: "Events", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
