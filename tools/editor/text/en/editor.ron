    "editor.looks.day_sprite": (text: "Sprite by day", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.day_sprite_hint": (text: "Optional: drawn by day instead, without light. For a brazier a player lights or puts out, use a second floor and the map's switch instead.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.preview": (text: "In the game", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.night": (text: "at night", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.day": (text: "by day", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
