    "editor.looks.switch_to": (text: "a click switches it to floor {n}", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.switch_from": (text: "what floor {n} turns into on a click", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.switch_hint": (text: "A brazier lit or put out by players is two floors: set the switch in the map's tile (Map, tile, \"Click switches to\").", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.switches": (text: "switches", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
