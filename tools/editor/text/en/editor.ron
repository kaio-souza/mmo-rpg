    "editor.looks.auto_anchor": (text: "Place the anchor at the feet on its own", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.auto_anchor_btn": (text: "Find the feet", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.make_still": (text: "It's a still image", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.use_guess": (text: "Use {f} × {d}", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.copy_from": (text: "Copy from another sprite…", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.map_dirty": (text: "The map of {zone} is open with unsaved changes: save or discard it first.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.no_map": (text: "— not now", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.new_floor_hint": (text: "Pick or upload its image; the floor number comes next in line.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.add_to_map": (text: "Add to the legend of the map", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.add_to_map_hint": (text: "So it can be painted right away; a standing floor blocks walking and sight.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.need_sprite": (text: "Pick an image first.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
