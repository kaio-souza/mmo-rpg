    "editor.dlg.remove_used": (text: "Remove a step in use?", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.dlg.remove_used_text": (text: "Answers of {steps} go here; they will close the talk instead.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.dlg.npc_says": (text: "The NPC says", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.dlg.answers": (text: "Answers of the player", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
