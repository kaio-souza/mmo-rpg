    "editor.dlg.title": (text: "Steps of the conversation", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.dlg.intro": (text: "Each step is what the NPC says and the answers the player can pick. An answer may need a condition, do things and lead to another step or close the talk.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.dlg.add_step": (text: "New step", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.dlg.new_step": (text: "new step…", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
