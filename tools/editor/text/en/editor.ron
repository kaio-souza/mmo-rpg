    "editor.looks.anchor": (text: "Anchor", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.anchor_hint": (text: "Click the picture on the pixel that should stand on the middle of the tile (the feet).", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.frames": (text: "Frames side by side", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
