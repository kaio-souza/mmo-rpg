    "editor.looks.strip_hint": (text: "An animated image is one PNG strip: the frames side by side; with 4 directions, one row each (facing S, W, N, E).", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.bad_strip": (text: "The {w}×{h} image does not split into these frames and rows: the game draws it whole.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.walking": (text: "Walking", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.inherit_hint": (text: "An empty field takes the folder's value (shown in grey).", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.folder_hint": (text: "Every image of this folder starts from these values; a sprite may set its own.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.no_sample": (text: "No image in this folder to show.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.saved_manifest": (text: "Anchor and animation saved.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.strip_n": (text: "{f} frames × {d} directions", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.map.switch": (text: "Click switches to", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.map.switch_none": (text: "— nothing (does not switch)", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.map.switch_hint": (text: "A player within reach clicks the tile and it becomes this floor for everyone; another click brings it back (a brazier lit or put out). What it blocks stays the same.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.only_broken": (text: "Strips that don't split", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.broken_alert": (text: "{n} images do not fit the frames and rows set for them (they don't split, or the frames come out a size unlike the rest of the folder): the game draws them wrong.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.show_broken": (text: "Show them", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.broken": (text: "Strip doesn't split", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.broken_hint": (text: "Click to say whether it is a still image or how many frames it has.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.upload_adjust": (text: "Upload and adjust", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.frame_is": (text: "Each frame: {w}×{h}.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
