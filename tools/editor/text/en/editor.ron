    "editor.map.seam_clash": (text: "{zone}: {items} would be less than {n} tiles from {other} (seam band). Cannot be saved.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.seam_fix": (text: "Cities, regions, NPCs and the spawn stay away from borders: put the zone against another side, or move those things in the other zone first.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.seam_spawn": (text: "entry point", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
