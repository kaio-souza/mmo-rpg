    "editor.looks.dirs4": (text: "4 rows: S, W, N, E", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.play": (text: "Plays", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.play_always": (text: "all the time", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
