    "editor.looks.pair_hint": (text: "A player clicks one and it becomes the other (a brazier lit and put out). Applies to every map that paints either of the two.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.looks.pair_apply": (text: "Apply to the maps", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.looks.pair_changes": (text: "Changes {n} legend tiles in: {maps}.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
