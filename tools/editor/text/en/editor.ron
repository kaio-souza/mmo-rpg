    "editor.sounds.techniques_hint": (text: "Each technique may have its own sound; one without a line plays the \"Technique used\" event. Everyone who sees the blow hears it; a support technique (heal, buff) only for whoever uses it.", note: "Label of the content editor (a tool for game designers).", max_chars: 300),
    "editor.sounds.unknown_technique": (text: "No technique with this id in content/: saving still works, validate refuses it.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.sounds.add_technique": (text: "Give a technique its sound", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
