    "editor.map.node": (text: "Place resource node", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.map.help.paint": (text: "Drag to paint the chosen tile. [ and ] change the brush size.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.fill": (text: "Click: every joined tile of the same kind becomes the chosen tile.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.rect": (text: "Drag a rectangle: it is filled with the chosen tile when you let go.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.line": (text: "Drag a straight line (walls, roads) with the brush size.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.pick": (text: "Click a tile on the map to choose it for painting.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.select": (text: "Click an NPC, monster, node, region or the spawn; drag to move it. Delete removes it.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.npc": (text: "Click where the NPC stands. Each click places one.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.monster": (text: "Click the center of a group: how many and how far from the center they appear.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.node": (text: "Click where players gather (ore, herbs). The node kind says what it gives.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.region": (text: "Drag a rectangle: safe area, PvP area or workshop.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.help.spawn": (text: "Click where players appear when they enter or come back after falling.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.region_safe": (text: "Safe: no combat. The spawn of a zone with monsters must be inside one.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.region_pvp": (text: "PvP: players may attack players here.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.region_workshop": (text: "Workshop: anyone may craft here (forge, bench). May lie inside another region.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.monster_hint": (text: "Count: how many live at once. Radius: how far from the center they appear.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.none_yet": (text: "Nothing of this kind exists yet.", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.map.select_hint": (text: "Click something on the map, or in the lists below, to select it.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.spawn_radius": (text: "Spread around the spawn", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
    "editor.map.legend_hint": (text: "Each tile is a floor picture and what it blocks. Blocking is a game rule and lives in the map; the picture comes from tiles.ron.", note: "Label of the content editor (a tool for game designers).", max_chars: 240),
    "editor.map.tile_new": (text: "New tile", note: "Label of the content editor (a tool for game designers).", max_chars: 80),
